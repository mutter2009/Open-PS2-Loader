+ */
+typedef void (*ps2ip_raw_hook_t)(const void *frame, int len);
+static ps2ip_raw_hook_t g_ps2ip_raw_hook = NULL;
+
+void ps2ip_set_raw_hook(ps2ip_raw_hook_t cb)
+{
+    g_ps2ip_raw_hook = cb;
+}
