diff --git a/.github/workflows/opl-netbox.yml b/.github/workflows/opl-netbox.yml
new file mode 100644
index 0000000..9d01900
--- /dev/null
+++ b/.github/workflows/opl-netbox.yml
@@ -0,0 +1,153 @@
+# [NETBOX] 云端编译 OPL + netbox 驱动
+#
+# 为什么要有这个 workflow：
+#   netbox.patch 只是一个"补丁文件"，光把它上传到仓库不会改动任何代码。
+#   直接跑 CI-compile 编出来的是原版 OPL（没有 netbox 驱动）。
+#   本 workflow 在云端先 git apply 补丁，再编译，产出带 netbox 的 ELF。
+#
+# 触发方式：只允许手动触发（Actions 页 -> 左侧选 "OPL-netbox" -> 右上角 Run workflow）
+#          刻意不配置 push 触发，这样每次改动/上传文件都不会自动编译。
+name: OPL-netbox
+
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    container: ghcr.io/ps2homebrew/ps2homebrew:main
+    steps:
+      - name: git checkout
+        uses: actions/checkout@v4
+
+      - name: Full history
+        run: |
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          git fetch --prune --unshallow || true
+
+      - name: 补丁指纹（确认编的是哪一版补丁）
+        run: |
+          sha256sum netbox.patch
+          grep -c '^diff --git' netbox.patch
+
+      - name: Apply netbox patch
+        run: |
+          git apply --verbose --exclude='.github/workflows/*' netbox.patch
+
+      - name: Compile -> make clean release
+        run: make --trace clean release
+
+      # 关键：发布版 ELF 是 ps2-packer 压缩过的，字符串全没了，
+      # 没法用它判断"驱动到底有没有编进去"。所以这里另外收集证据：
+      # 未压缩的 opl.elf、链接 map、以及 bin2c 产物。
+      - name: Collect verification info
+        if: ${{ always() }}
+        run: |
+          {
+            echo "=== netbox.patch sha256（对着我给的哈希核对版本）==="
+            sha256sum netbox.patch
+            echo
+            echo "=== modules/netbox IRX 产物 ==="
+            ls -la modules/netbox/*.irx 2>&1
+            echo
+            echo "=== bin2c 产物 asm/netbox.c ==="
+            ls -la asm/netbox.c 2>&1
+            echo
+            echo "=== 目标文件 obj/netbox.o ==="
+            ls -la obj/netbox.o 2>&1
+            echo
+            echo "=== opl.map 里的 netbox 符号（证明链进了 ELF）==="
+            grep -i netbox opl.map 2>&1 | head -30
+            echo
+            echo "=== 未压缩 opl.elf 里的 netbox 字符串 ==="
+            strings -a opl.elf 2>/dev/null | grep -i netbox | head -20
+            echo
+            echo "=== [v12 关键证据] SMAP 原始帧钩子的接线是否真的编进了二进制 ==="
+            echo "--- smap-ingame 的导出表必须含库名 netboxh ---"
+            ls -la modules/network/smap-ingame/smap.irx 2>&1
+            echo "netboxh 出现次数: $(grep -a -c 'netboxh' modules/network/smap-ingame/smap.irx 2>&1)"
+            echo "--- netbox.irx 必须【导入】 netboxh（否则 IOP 装载器会拒绝加载它）---"
+            ls -la modules/netbox/netbox.irx 2>&1
+            echo "netboxh 出现次数: $(grep -a -c 'netboxh' modules/netbox/netbox.irx 2>&1)"
+            echo "--- netbox.irx 里【不应该】再出现 ps2ip/lwip 的导入（v12 已全部移除）---"
+            echo "lwip_ 出现次数: $(grep -a -c 'lwip_' modules/netbox/netbox.irx 2>&1)"
+            echo
+            echo "=== ⚠ 重要：查【函数名】必须查 .notiopmod.elf，不能查 .irx ==="
+            echo "理由（ps2sdk samples/Makefile.iopglobal 第 143-150 行）："
+            echo "    xxx.notiopmod.elf            <- 链接产物，含 .symtab（函数名在这里）"
+            echo "    xxx.notiopmod.stripped.elf   <- \$(IOP_STRIP) --strip-unneeded（符号表被删）"
+            echo "    xxx.irx                      <- iopfixup --rb --irx1（最终产物，已 strip）"
+            echo "所以 grep .irx 找函数名【永远返回 0】，不代表符号没编进去。"
+            echo "能在 .irx 里查到的只有【数据段字符串】：库名 netboxh、IRX_ID、printf 格式串。"
+            echo "（v14 的 verify 就踩过这个坑。）"
+            ls -la modules/network/smap-ingame/*.notiopmod.elf modules/netbox/*.notiopmod.elf 2>&1
+            echo
+            echo "=== [v14 关键证据] 两个真判据（链路 / 钩子自检）==="
+            echo "--- 版本串（在 .irx 里，是数据段的格式串，可查）---"
+            strings -a modules/netbox/netbox.irx 2>/dev/null | grep -i 'netbox_bd: PS2 NetBox' | head -3
+            echo "--- v14 新增符号 4=smap_get_link_status / 5=smap_get_rx_hook（查未 strip 的 ELF）---"
+            echo "smap ELF   smap_get_link_status : $(grep -a -c 'smap_get_link_status' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_get_rx_hook     : $(grep -a -c 'smap_get_rx_hook' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_link_status : $(grep -a -c 'smap_get_link_status' modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_rx_hook     : $(grep -a -c 'smap_get_rx_hook' modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "--- v14 自检相关串（在 .irx 里，可查）---"
+            echo "link DOWN 串        : $(grep -a -c 'PHY link DOWN' modules/netbox/netbox.irx 2>&1)"
+            echo "hook selftest 串    : $(grep -a -c 'rx hook self-check FAILED' modules/netbox/netbox.irx 2>&1)"
+            echo
+            echo "=== [v15 关键证据] 寄存器级收发现场诊断是否真的编进了二进制 ==="
+            echo "--- 版本串必须是 v1.6 ... PHY gate diag（看到 v1.6 才是本轮；v1.5=上一轮）---"
+            strings -a modules/netbox/netbox.irx 2>/dev/null | grep -i 'netbox_bd: PS2 NetBox' | head -3
+            echo "--- v15 新增符号 6=smap_get_rx_diag / 7=smap_get_phy_dump（查未 strip 的 ELF）---"
+            echo "smap ELF   smap_get_rx_diag  : $(grep -a -c 'smap_get_rx_diag'  modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_get_phy_dump : $(grep -a -c 'smap_get_phy_dump' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_rx_diag  : $(grep -a -c 'smap_get_rx_diag'  modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_phy_dump : $(grep -a -c 'smap_get_phy_dump' modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "--- xfer.c 里的收帧记账符号（证明改的是 HandleRxIntr 那条静默丢帧分支）---"
+            echo "smap ELF nb_dbg_rx_bad     : $(grep -a -c 'nb_dbg_rx_bad'     modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF nb_dbg_rx_ok      : $(grep -a -c 'nb_dbg_rx_ok'      modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF nb_dbg_intr_rxend : $(grep -a -c 'nb_dbg_intr_rxend' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF nb_dbg_rx_waiting : $(grep -a -c 'nb_dbg_rx_waiting' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "--- v15 自检/诊断串（在 .irx 里，可查）---"
+            echo "reg-level rx diag 串 : $(grep -a -c 'reg-level rx diag' modules/netbox/netbox.irx 2>&1)"
+            echo "rxq= 诊断串          : $(grep -a -c 'rxq=' modules/netbox/netbox.irx 2>&1)"
+            echo "phy bmsr= 诊断串     : $(grep -a -c 'phy bmsr=' modules/netbox/netbox.irx 2>&1)"
+            echo "FAIL stage= 出现次数 : $(grep -a -c 'FAIL stage=' modules/netbox/netbox.irx 2>&1)"
+            echo
+            echo "=== [v16 关键证据] PHY 身份诊断闸是否真的编进去了 ==="
+            echo "--- 这三条格式串就是 v16 新增的 PHY 闸：---"
+            echo "PHY gate FAILED 串  : $(grep -a -c 'PHY gate FAILED' modules/netbox/netbox.irx 2>&1)"
+            echo "PHY identity 诊断串 : $(grep -a -c 'PHY identity unusable' modules/netbox/netbox.irx 2>&1)"
+            echo "--- 版本串里的 v1.6 / PHY gate diag 标记（两条都应 >=1）---"
+            echo "v1.6 标记           : $(grep -a -c 'v1.6' modules/netbox/netbox.irx 2>&1)"
+            echo "PHY gate diag 标记  : $(grep -a -c 'PHY gate diag' modules/netbox/netbox.irx 2>&1)"
+            echo "--- gui.c 侧的 v16 打包解码（EE 侧，编进 OPL.ELF 而不是 irx）---"
+            echo "OPL.elf: 'NO PHY (mdio floats FFFF)' : $(grep -a -c 'NO PHY (mdio floats FFFF)' opl.elf 2>&1)"
+            echo "OPL.elf: 'PHY not DP83846'           : $(grep -a -c 'PHY not DP83846' opl.elf 2>&1)"
+            echo "OPL.elf: 'PHY mdio ALL ZERO'         : $(grep -a -c 'PHY mdio ALL ZERO' opl.elf 2>&1)"
+            echo "（三条都应 >=1；若为 0 说明 gui.c 的解码分支没编进去）"
+            echo
+            echo "--- smap-ingame 的构建顺序（必须先于 netbox）---"
+            grep -n "smap-ingame\|netbox" opl.map 2>/dev/null | head -10
+            echo
+            echo "=== 产物清单 ==="
+            ls -la OPNPS2LD*.ELF opl.elf opl_stripped.elf 2>&1
+          } > verify.txt 2>&1
+          cat verify.txt
+
+      - name: Upload ELF（PS2 用这个）
+        if: ${{ success() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: OPNPS2LD-netbox
+          path: OPNPS2LD-*.ELF
+
+      - name: Upload build evidence（排查用，别拷进 PS2）
+        if: ${{ always() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: netbox-build-verify
+          if-no-files-found: warn
+          path: |
+            verify.txt
+            opl.elf
+            opl.map
