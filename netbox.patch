+                 * 后者是盒子的应答根本没上线。记账后就能分开。 */
+                nb_dbg_rx_bad++;
+                if (nb_dbg_rx_badctrl == 0)
+                    nb_dbg_rx_badctrl = ctrl_stat;
             } else {
                 if ((pbuf = pbuf_alloc(PBUF_RAW, LengthRounded, PBUF_POOL)) != NULL) {
                     CopyFromFIFO(SmapDrivPrivData->smap_regbase, pbuf->payload, length, pointer);
 
+                    nb_dbg_rx_ok++;
+
