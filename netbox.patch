+int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode)
+{
+    volatile u8 *emac3_regbase = SmapDriverData.emac3_regbase;
+    u16 bmsr;
+
+    bmsr = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_BMSR);
+
+    if (pBMSR != NULL)
+        *pBMSR = bmsr;
+    if (pANLPAR != NULL)
+        *pANLPAR = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_ANLPAR);
+    if (pLinkMode != NULL)
+        *pLinkMode = SmapDriverData.LinkMode;
+
+    return (bmsr & SMAP_PHY_BMSR_LINK) ? 1 : 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * [NETBOX] v15：把"帧到底走到哪一步"打包交出去（netboxh 导出编号 6）
+ *
+ * out[] 布局（全部 u32，调用方传至少 16 个元素的数组）：
+ *   0  SMAP_R_RXFIFO_FRAME_CNT   MAL 里还没被取走的帧数（硬件计数，不依赖中断）
+ *   1  SMAP_R_TXFIFO_FRAME_CNT   发送队列里还没发完的帧数
+ *   2  SMAP_R_EMAC3_INTR_STAT    现场读的 EMAC3 中断/错误标志
+ *   3  nb_dbg_emac3_seen         中断里清标志前累计 OR 到的 EMAC3 标志
+ *   4  nb_dbg_intr_cb            DEV9 中断回调次数
+ *   5  nb_dbg_intr_rxend         RXEND（收到帧）事件次数
+ *   6  nb_dbg_intr_emac3         EMAC3 事件次数
+ *   7  nb_dbg_rxintr             HandleRxIntr 调用次数
+ *   8  nb_dbg_rx_waiting         其中看到 FRAME_CNT>0 的次数
+ *   9  nb_dbg_rx_ok              真正交给 SMapLowLevelInput() 的帧数
+ *   10 nb_dbg_rx_bad             因 BD 错误标志被丢掉的帧数
+ *   11 nb_dbg_rx_badctrl         第一条被丢帧的 ctrl_stat
+ *   12 SMAP_R_EMAC3_MODE1        实际写进 MAC 的 MODE1（bit31=FDX, bit22=100M）
+ *   13 SMAP_R_EMAC3_TxMODE0      发送引擎状态（bit31 = GNP 挂着没发完 = 发不出去）
+ *   14 SMAP_R_RXFIFO_CTRL        RX FIFO 控制（DMAEN 位）
+ *   15 SMAP_R_TXFIFO_CTRL        TX FIFO 控制
+ *   16 本站 MAC 高位寄存器       —— 用来确认 smap_init() 真的写过地址
+ *   17 本站 MAC 低位寄存器
+ *   18 错误码（0..5，见下）—— 驱动直接拿这个数字上屏，免得在 netbox 侧
+ *      重复写一遍 EMAC3 的位定义。优先级：发帧错误 > 收帧错误 > BD 丢帧
+ *        0 = 没有任何错误标志
+ *        1 = 有帧被 BD 错误标志丢掉（还没到 EMAC3 计数）
+ *        2 = BAD_FCS（收到帧但 CRC 错 -> 双工/速率不符、PHY 没真 link、线材）
+ *        3 = RUNT_FRAME / SHORT_EVENT（收到的帧太短）
+ *        4 = BAD_FRAME / ALIGN_ERR / TOO_LONG / OVERRUN / 范围错误
+ *        5 = 发帧错误 DEAD_0 / DEAD_1 / DEAD_DEPEND / TX_ERR / SQE_ERR
+ *            （发送引擎报"死"= 帧根本没上线路）
+ *   19 保留（0）
+ *
+ * 读法（诊断时的用法）：
+ *   out[0]>0 而 out[9]==0  => 帧到了 MAL 但没被取走（中断没跑 / 被错误标志丢了）
+ *   out[10]>0              => 收到过帧、但带错误标志，看 out[18] 是哪一类
+ *   out[0]==0 且计数全零   => 一个帧都没到 PS2 的 MAC（盒子没回 / 发不出去）
+ *   out[13] 的 bit31 一直是 1 => 发送引擎卡住（帧根本没上线路）
+ * --------------------------------------------------------------------------- */
+int smap_get_rx_diag(unsigned int *out, int n)
+{
+    USE_SMAP_REGS;
+    USE_SMAP_EMAC3_REGS;
+    unsigned int IntrNow, ErrCode;
+
+    if (out == NULL || n < 1)
+        return -1;
+
+    /* 只读一次：INTR_STAT 在部分实现里是"读即清"，两次读会拿到不同的值。 */
+    IntrNow = SMAP_EMAC3_GET32(SMAP_R_EMAC3_INTR_STAT);
+
+    /* 把"这次现场"和"中断里清标志前累计到的"合起来判断错误类别 */
+    {
+        unsigned int e = IntrNow | nb_dbg_emac3_seen;
+
+        if (e & (SMAP_E3_INTR_DEAD_0 | SMAP_E3_INTR_DEAD_1 | SMAP_E3_INTR_DEAD_DEPEND |
+                 SMAP_E3_INTR_TX_ERR_0 | SMAP_E3_INTR_TX_ERR_1 | SMAP_E3_INTR_SQE_ERR_0))
+            ErrCode = 5;
+        else if (e & SMAP_E3_INTR_BAD_FCS)
+            ErrCode = 2;
+        else if (e & (SMAP_E3_INTR_RUNT_FRAME | SMAP_E3_INTR_SHORT_EVENT))
+            ErrCode = 3;
+        else if (e & (SMAP_E3_INTR_BAD_FRAME | SMAP_E3_INTR_ALIGN_ERR | SMAP_E3_INTR_TOO_LONG |
+                      SMAP_E3_INTR_OVERRUN | SMAP_E3_INTR_OUT_RANGE_ERR | SMAP_E3_INTR_IN_RANGE_ERR))
+            ErrCode = 4;
+        else if (nb_dbg_rx_bad != 0)
+            ErrCode = 1;
+        else
+            ErrCode = 0;
+    }
+
+#define PUT(i, v)                     \
+    do {                              \
+        if ((i) < (n))                \
+            out[(i)] = (unsigned int)(v); \
+    } while (0)
+
+    PUT(0, SMAP_REG8(SMAP_R_RXFIFO_FRAME_CNT));
+    PUT(1, SMAP_REG8(SMAP_R_TXFIFO_FRAME_CNT));
+    PUT(2, IntrNow);
+    PUT(3, nb_dbg_emac3_seen);
+    PUT(4, nb_dbg_intr_cb);
+    PUT(5, nb_dbg_intr_rxend);
+    PUT(6, nb_dbg_intr_emac3);
+    PUT(7, nb_dbg_rxintr);
+    PUT(8, nb_dbg_rx_waiting);
+    PUT(9, nb_dbg_rx_ok);
+    PUT(10, nb_dbg_rx_bad);
+    PUT(11, nb_dbg_rx_badctrl);
+    PUT(12, SMAP_EMAC3_GET32(SMAP_R_EMAC3_MODE1));
+    PUT(13, SMAP_EMAC3_GET32(SMAP_R_EMAC3_TxMODE0));
+    PUT(14, SMAP_REG8(SMAP_R_RXFIFO_CTRL));
+    PUT(15, SMAP_REG8(SMAP_R_TXFIFO_CTRL));
+    PUT(16, SMAP_EMAC3_GET32(SMAP_R_EMAC3_ADDR_HI));
+    PUT(17, SMAP_EMAC3_GET32(SMAP_R_EMAC3_ADDR_LO));
+    PUT(18, ErrCode);
+    PUT(19, 0);
+
+#undef PUT
+
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * [NETBOX] v15：PHY 寄存器现场快照 + 链路模式码（netboxh 导出编号 7）
+ *
+ * 为什么要读 PHYSTS(0x10) 而不是只看 BMSR：
+ *   BMSR bit2 只是"链路状态"，分不出 10M/100M、半双工/全双工 —— 而
+ *   smap_init() 写进 EMAC3 MODE1 的是【硬编码的 100M 全双工】，InitPHY()
+ *   又只在"BMSR 显示没有链路"时才会被调用（SMAPStart 里的那行三元表达式）。
+ *   也就是说：链路如果一开始就是 up 的，速度和双工【从来没被协商/校正过】。
+ *   盒子的链路口如果是 10M 或半双工，这里就会露出一致性问题的证据。
+ *   PHYSTS 直接给出答案（bit0=link, bit1=1 表示 10M, bit2=1 表示全双工），
+ *   还顺带用 PHY ID 判断 PHY 到底有没有在应答（不响应时 MDIO 常读到 0xFFFF，
+ *   BMSR 的 link 位会是 1 —— 那正好是"链路 OK"的假阳性来源）。
+ *
+ * out[] 布局（u16，调用方传至少 10 个元素）：
+ *   0 BMCR  1 BMSR  2 PHYIDR1  3 PHYIDR2  4 ANAR  5 ANLPAR  6 ANER
+ *   7 PHYSTS(0x10)  8 10BTSCR(0x1A)  9 链路模式码
+ * 模式码：[9] = 0 unknown/none, 1 = 10M半, 2 = 10M全, 3 = 100M半, 4 = 100M全,
+ *           5 = PHY 不响应（ID 不匹配 -> 前面所有"链路 OK"都不可信）
+ * --------------------------------------------------------------------------- */
+int smap_get_phy_dump(unsigned int *out, int n)
+{
+    volatile u8 *emac3_regbase = SmapDriverData.emac3_regbase;
+    u16 sts, idr1, idr2;
+    int code;
+
+    if (out == NULL || n < 1)
+        return -1;
+
+    sts = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_PHYSTS);
+    idr1 = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_PHYIDR1);
+    idr2 = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_PHYIDR2);
+
+    if (idr1 != SMAP_PHY_IDR1_VAL || (idr2 & SMAP_PHY_IDR2_MSK) != SMAP_PHY_IDR2_VAL)
+        code = 5; /* PHY 不响应 */
+    else if (!(sts & SMAP_PHY_STS_LINK))
+        code = 0; /* 真的有链路才算 */
+    else
+        code = (sts & SMAP_PHY_STS_10M) ? ((sts & SMAP_PHY_STS_FDX) ? 2 : 1)
+                                        : ((sts & SMAP_PHY_STS_FDX) ? 4 : 3);
+
+#define PUT16(i, v)                   \
+    do {                              \
+        if ((i) < (n))                \
+            out[(i)] = (unsigned int)(v); \
+    } while (0)
+
+    PUT16(0, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_BMCR));
+    PUT16(1, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_BMSR));
+    PUT16(2, idr1);
+    PUT16(3, idr2);
+    PUT16(4, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_ANAR));
+    PUT16(5, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_ANLPAR));
+    PUT16(6, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_ANER));
+    PUT16(7, sts);
+    PUT16(8, _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_10BTSCR));
+    PUT16(9, code);
+
+#undef PUT16
+
+    return code;
+}
+
+/* ---------------------------------------------------------------------------
+ * [v17] 链路重初始化 —— 这一版的核心，说明为什么要它。
+ *
+ * SMAPStart() 里决定"要不要初始化 PHY"的只有一行：
+ *     result = (!(_smap_read_phy(emac3_regbase, SMAP_DsPHYTER_BMSR)
+ *                 & SMAP_PHY_BMSR_LINK)) ? InitPHY(&SmapDriverData) : 0;
+ * 也就是 —— 【BMSR 报"有链路"时，InitPHY() 根本不会被调用】。
+ * 上游敢这么写，是因为它假设 SMAP 已经被"上一个 SMAP 实例"初始化好了
+ * （注释原文：It should have already been previously initialized
+ *  successfully by the previous instance of SMAP）。
+ *
+ * 但 InitPHY() 其实同时承担三件必须做的事，全都在那一个三元表达式后面：
+ *   ① 真正确立链路：软复位 PHY -> 自协商(BMCR.RSAN) -> 最多 3 轮重试 ->
+ *      手动 100M 半双工 -> 手动 10M 半双工
+ *   ② 由 BMCR/ANAR/ANLPAR 算出 LinkMode
+ *      （bit0..3：1=10M半 2=10M全 4=100M半 8=100M全）
+ *   ③ ★把 FDX 与流控写进 EMAC3 MODE1★  <- 让 MAC 和 PHY 对齐的那一刀
+ *
+ * 只要 BMSR 的 link 位恰好读成 1，①②③ 全部被跳过：
+ *   - PHY 不响应时 MDIO 数据线悬空、读回 0xFFFF，而 bit2 恰好是 1；
+ *   - 链路刚插上、PHY 还没协商完，link 位也会瞬间为 1。
+ * 于是 MAC 停在 smap_init() 写进去的【硬编码 100M 全双工】，而 PHY 实际
+ * 可能是 10M 半双工 / 100M 半双工 => 双工不匹配 => 本侧发出去的帧对端
+ * 收得到，对端回过来的帧本侧 MAC 全部采样错 => "发得出去、一个回包都没有"。
+ * 这和 xfer.c 里那条"收帧带错误标志 -> 空 if 静默丢弃"互为表里：
+ * 一个在 MAC 里丢，一个在驱动里丢，屏幕上看不出区别。
+ *
+ * 注意第 265-304 行那段 DP83846 专有 workaround 在 ID 不匹配时会被跳过 ——
+ * 那是【正确】的（那些是 DP83846 自己的 errata 与 10BTSCR 设置）；
+ * 而第 306-338 行的 LinkMode 计算与 EMAC3 同步在这段 if 之外，任何 PHY 都执行。
+ * 所以这一版要做的就是把这后一部分补回来。
+ *
+ * 但【不能直接调 InitPHY()】—— 它里面有一个会无限循环的 goto
+ * （第 257 行 `goto RepeatAutoNegoProcess` 会清零重试计数），
+ * 网线没插 / 对端没上电时它永远不返回；而本函数是在 netbox.irx 的
+ * _start() 里被调的，_start() 又由 EE 侧的 SifExecModuleBuffer() 同步等待，
+ * 直接后果就是 OPL 启动画面永久卡死。
+ * 详细拆解与替代实现见下面 smap_phy_reinit() 的注释。
+ * --------------------------------------------------------------------------- */
+
+/* 按当前 PHY 现场重算 LinkMode，并把 FDX / 流控写进 EMAC3 MODE1。
+ * 这是 InitPHY() 第 306-338 行的等价物，单独摘出来，
+ * 好在"链路已经 up、不该打断它"时也能做 MAC 侧对齐。 */
+static void SmapSyncLinkMode(void)
+{
+    volatile u8 *base = SmapDriverData.emac3_regbase;
+    u16 bmcr, anar, anlpar, value;
+    unsigned int LinkSpeed100M, LinkFDX, FlowControlEnabled;
+    u32 emac3_value;
+
+    bmcr = _smap_read_phy(base, SMAP_DsPHYTER_BMCR);
+    anar = _smap_read_phy(base, SMAP_DsPHYTER_ANAR);
+    anlpar = _smap_read_phy(base, SMAP_DsPHYTER_ANLPAR);
+
+    FlowControlEnabled = 0;
+    if (bmcr & SMAP_PHY_BMCR_ANEN) {
+        value = anar & anlpar;
+        LinkSpeed100M = (value & 0x180) != 0;
+        LinkFDX = (value & 0x140) != 0;
+        if (LinkFDX)
+            FlowControlEnabled = (value & 0x400) != 0;
+    } else {
+        LinkSpeed100M = (bmcr >> 13) & 1;
+        LinkFDX = (bmcr >> 8) & 1;
+        FlowControlEnabled = (SmapConfiguration >> 10) & 1;
+    }
+
+    SmapDriverData.LinkMode = LinkSpeed100M ? (LinkFDX ? 8 : 4) : (LinkFDX ? 2 : 1);
+    if (FlowControlEnabled)
+        SmapDriverData.LinkMode |= 0x40;
+
+    emac3_value = SMAP_EMAC3_GET32(SMAP_R_EMAC3_MODE1) & 0x67FFFFFF;
+    if (LinkFDX)
+        emac3_value |= SMAP_E3_FDX_ENABLE;
+    if (FlowControlEnabled)
+        emac3_value |= SMAP_E3_FLOWCTRL_ENABLE | SMAP_E3_ALLOW_PF;
+    SMAP_EMAC3_SET32(SMAP_R_EMAC3_MODE1, emac3_value);
+}
+
+/*
+ * 主动跑一遍 PHY 初始化（时间有上限）+ MAC 侧速率/双工同步，交出相机快照。
+ *
+ * 【为什么不用上游的 InitPHY()】两个硬问题：
+ *
+ *   1) ★它会无限循环★ —— InitPHY() 第 257 行是 `goto RepeatAutoNegoProcess`，
+ *      而这个标签在 `for (AutoNegoRetries = 0; ...)` 之前：跳回去会把重试
+ *      计数清零。于是"自协商 3 轮 + 手动 100M + 手动 10M 全失败"这组动作
+ *      每轮约 29 秒，网线没插 / 对端没上电时【永远不会退出】。
+ *      而本函数是在 netbox.irx 的 _start() 里被调的，_start() 又由
+ *      SifExecModuleBuffer() 在 EE 侧同步等待 —— 直接后果就是 OPL 启动画面
+ *      永久卡死。这正是"链路不通"时最可能踩到的坑。
+ *   2) 它的软复位等待太严苛：第 130-134 行写完 BMCR.RST 后第一次读，只要
+ *      RST 位还在（PHY 复位慢一点点）就 `return -1` 提前退出，后面的自协商
+ *      与 EMAC3 同步就全不做了。
+ *
+ * 所以这里写一个有界版本：只做 InitPHY() 里【与 PHY 型号无关】的那部分
+ * （不碰 DP83846 专有寄存器 —— 本机实测那颗 PHY 的 ID 是 0x0143BCxx，
+ * 不是 DP83846，那些 workaround 本来也该跳过）。
+ * 时间上限：复位 0.2s + 自协商 2×3s + 手动 2×2.2s ≈ 10.6 秒。
+ *
+ * 另外，动手前先撤掉 SMAP 的链路检查闹钟：它的回调 CheckLinkStatus() 在
+ * BMSR 报无链路时会调 InitPHY()，也就是上面那个无限循环。做完之后只在
+ * "链路真的起来了"时才把闹钟装回去（链路不通时装回去没有意义，只会挂死）。
+ *
+ * out[] 布局（调用方传 >= 12 个元素）：
+ *   0 BMCR  1 BMSR  2 PHYIDR1  3 PHYIDR2  4 ANAR  5 ANLPAR
+ *   6 PHYSTS  7 EMAC3 MODE1 的 FDX 位（0/1）  8 LinkMode  9 LinkStatus
+ *   10 ANER   11 结果码：0 = 链路已就绪 / 1 = PHY 复位没完成 / 2 = 链路没起来
+ *               （bit4 恒为 1，表示这是"主动做完一遍"的结果而不是快照）
+ *
+ * 返回：0 = 链路就绪；1 = 没就绪（细节看 out[11]）；2 = 参数错误
+ */
+int smap_phy_reinit(unsigned int *out, int n)
+{
+    volatile u8 *base = SmapDriverData.emac3_regbase;
+    u16 v;
+    int i, rc = 2, restarted = 0;
+
+    if (out == NULL || n < 12)
+        return 2;
+
+    /* --- 0) 撤掉链路检查闹钟，避开 InitPHY() 的无限循环（见上方说明）---
+     *
+     * ★ 注意 ps2sdk thbase.h 的签名，它要的是【回调 + 参数】而不是时钟：
+     *     int      SetAlarm   (iop_sys_clock_t *clock, cb, void *arg);
+     *     int      CancelAlarm(                       cb, void *arg);
+     *   所以撤销时必须把上面 SetAlarm 那一对原样传回去（本文件第 485 行
+     *   就是 SetAlarm(&LinkCheckTimer, (void*)&LinkCheckTimerCB, &SmapDriverData)）。
+     *   写成 CancelAlarm(&SmapDriverData.LinkCheckTimer) 是错的 —— 参数个数
+     *   和类型都不对，编译期就过不去。
+     *   另外 CancelAlarm 属于 thbase（ordinal 37），
+     *   必须同时出现在 imports.lst 的 thbase_IMPORTS_start 块里，
+     *   否则 netbox/smap 模块装载时会因找不到导入而失败。 */
+    if (SmapDriverData.EnableLinkCheckTimer) {
+        CancelAlarm((void *)&LinkCheckTimerCB, &SmapDriverData);
+        restarted = 1;
+    }
+
+    /* --- 1) 软复位 PHY，最多等 200ms --- */
+    _smap_write_phy(base, SMAP_DsPHYTER_BMCR, SMAP_PHY_BMCR_RST);
+    for (i = 0; i < 200; i++) {
+        if (!(_smap_read_phy(base, SMAP_DsPHYTER_BMCR) & SMAP_PHY_BMCR_RST))
+            break;
+        DelayThread(1000); /* 1ms */
+    }
+    if (i >= 200) {
+        rc = 1; /* RST 位一直不清 —— PHY 连写操作都没在响应 */
+        goto done;
+    }
+
+    /* --- 2) 链路本来就好在的话就别打断它 --- */
+    v = _smap_read_phy(base, SMAP_DsPHYTER_BMSR);
+    if (v != 0xFFFFu && v != 0x0000u && (v & SMAP_PHY_BMSR_LINK)) {
+        rc = 0;
+        goto sync;
+    }
+
+    /* --- 3) 触发自协商（BMCR.ANEN|RSAN），最多两轮、每轮最多 3 秒 --- */
+    for (i = 0; i < 2 && rc != 0; i++) {
+        int k;
+
+        _smap_write_phy(base, SMAP_DsPHYTER_BMCR, SMAP_PHY_BMCR_ANEN | SMAP_PHY_BMCR_RSAN);
+        for (k = 0; k < 30; k++) { /* 30 x 100ms = 3s */
+            DelayThread(100 * 1000);
+            v = _smap_read_phy(base, SMAP_DsPHYTER_BMSR);
+            if (v != 0xFFFFu && v != 0x0000u && (v & SMAP_PHY_BMSR_LINK)) {
+                rc = 0;
+                break;
+            }
+        }
+    }
+
+    /* --- 4) 自协商不成，手动试 100M 半双工、再 10M 半双工 --- */
+    for (i = 0; i < 2 && rc != 0; i++) {
+        int k;
+
+        _smap_write_phy(base, SMAP_DsPHYTER_BMCR,
+                        (i == 0) ? SMAP_PHY_BMCR_100M : SMAP_PHY_BMCR_10M);
+        DelayThread(200 * 1000);          /* 给 PHY 稳定时间 */
+        for (k = 0; k < 20; k++) {        /* 20 x 100ms = 2s */
+            DelayThread(100 * 1000);
+            v = _smap_read_phy(base, SMAP_DsPHYTER_BMSR);
+            if (v != 0xFFFFu && v != 0x0000u && (v & SMAP_PHY_BMSR_LINK)) {
+                rc = 0;
+                break;
+            }
+        }
+    }
+
+sync:
+    /* --- 5) 结算 LinkMode 并写进 EMAC3 MODE1（与 PHY 型号无关，
+     *        这正是 SMAPStart() 会因为 BMSR 报有链路而跳过的那一刀）--- */
+    SmapSyncLinkMode();
+
+done:
+    SmapDriverData.LinkStatus = (rc == 0) ? 1 : 0;
+
+    /* --- 6) 只有链路真的起来了才把链路检查闹钟装回去 --- */
+    if (restarted && rc == 0) {
+        USec2SysClock(5000000, &SmapDriverData.LinkCheckTimer);
+        SetAlarm(&SmapDriverData.LinkCheckTimer, (void *)&LinkCheckTimerCB, &SmapDriverData);
+    }
+
+    out[0] = _smap_read_phy(base, SMAP_DsPHYTER_BMCR);
+    out[1] = _smap_read_phy(base, SMAP_DsPHYTER_BMSR);
+    out[2] = _smap_read_phy(base, SMAP_DsPHYTER_PHYIDR1);
+    out[3] = _smap_read_phy(base, SMAP_DsPHYTER_PHYIDR2);
+    out[4] = _smap_read_phy(base, SMAP_DsPHYTER_ANAR);
+    out[5] = _smap_read_phy(base, SMAP_DsPHYTER_ANLPAR);
+    out[6] = _smap_read_phy(base, SMAP_DsPHYTER_PHYSTS);
+    out[7] = (SMAP_EMAC3_GET32(SMAP_R_EMAC3_MODE1) & SMAP_E3_FDX_ENABLE) ? 1u : 0u;
+    out[8] = (unsigned int)SmapDriverData.LinkMode;
+    out[9] = (unsigned int)SmapDriverData.LinkStatus;
+    out[10] = _smap_read_phy(base, SMAP_DsPHYTER_ANER);
+    out[11] = (unsigned int)rc | (1u << 4);
+
+    return (rc == 0) ? 0 : 1;
+}
