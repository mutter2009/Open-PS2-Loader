index b3b1796..9f0680f 100644
--- a/modules/network/smap-ingame/main.h
+++ b/modules/network/smap-ingame/main.h
@@ -30,6 +30,10 @@ int SMAPStart(void);
 void SMAPStop(void);
 int SMAPGetMACAddress(unsigned char *buffer);
 
+/* [NETBOX] netboxh 额外导出的三个（见 exports.tab） */
+int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode);
