diff --git a/modules/network/smap-ingame/main.c b/modules/network/smap-ingame/main.c
index 76da054..0743d6b 100644
--- a/modules/network/smap-ingame/main.c
+++ b/modules/network/smap-ingame/main.c
@@ -148,8 +148,85 @@ static err_t SMapIFInit(NetIF *pNetIF)
     return ERR_OK;
 }
 
+/* ---------------------------------------------------------------------------
+ * [NETBOX] 原始帧钩子
+ *
+ * 这是整棵网络栈里**唯一**能在 lwIP 裁包之前拿到完整以太网帧的地方：
+ * 本函数被 SMAP 的收包中断直接调用，pBuf 就是刚 DMA 出来的整帧
+ * （xfer.c: HandleRxIntr -> CopyFromFIFO(...) -> SMapLowLevelInput(pbuf)）。
+ * 一旦交给 ps2ip_input()，ip_input() 就会按 IP 头里的 total_length 裁 pbuf。
+ *
+ * 为什么必须在这里拦：PS2 NetBox 盒子的回包是畸形 IP 包 —— IP total_length
+ * 恒为 124、UDP length 恒为 104，而以太网帧实际是 640 字节（BD 长度也是 640）。
+ * ip_input() 会把 pbuf 裁到 124 字节 => socket 只能拿到 96 字节载荷，
+ * 而一个读扇区应答的载荷是 536 字节（18 前导记录 + 512 扇区数据 + 6 收尾记录）。
+ * 所以裁完之后 512 字节扇区数据就丢了，fatfs 挂不上 mass0:，OPL 连设备图标都不显示。
+ *
+ * 钩子由 netbox.irx 通过导入 netboxh 库的 smap_set_rx_hook() 注册；
+ * 没注册时（也就是普通 SMB/游戏启动场景）这里只是一个 NULL 判断，行为完全不变。
+ * --------------------------------------------------------------------------- */
+static void (*SmapRxHook)(const unsigned char *frame, int len);
+
+/* [NETBOX] exports.tab 里那张 netboxh 导出表（编在 exports.o 里）。
+ * 必须在 _start() 里注册它，否则 "netboxh" 这个库在运行时不存在，
+ * netbox.irx 的导入解析失败 => IOP 装载器直接拒绝加载 netbox.irx。 */
+extern struct irx_export_table _exp_netboxh;
+
+void smap_set_rx_hook(void *fn)
+{
+    SmapRxHook = (void (*)(const unsigned char *, int))fn;
+}
+
+/* [NETBOX] 回读钩子指针（netboxh 导出编号 5）。
+ * 用途只有一个：自检。如果 netboxh 这个库在运行时不存在，IOP 装载器会把
+ * netbox.irx 里对应的导入桩改写成空桩（cleanStub 把它变成 jr $ra），
+ * 于是 smap_set_rx_hook() 静默什么都不做、钩子计数永远 0 —— 和 "盒子没回包"
+ * 的症状一模一样。回读一次并和 netbox 传入的地址比对，就能把两者分开。 */
+void *smap_get_rx_hook(void)
+{
+    return (void *)SmapRxHook;
+}
+
+static void SmapPassRawFrame(PBuf *pBuf)
+{
+    static unsigned char FrameBuffer[MAX_FRAME_SIZE];
+    struct pbuf *q;
+    int len, off;
+
+    if (SmapRxHook == NULL || pBuf == NULL)
+        return;
+
+    len = pBuf->tot_len;
+    if (len <= 0)
+        return;
+    if (len > (int)sizeof(FrameBuffer))
+        len = (int)sizeof(FrameBuffer);
+
+    if (pBuf->next == NULL) {
+        /* 常见情形：lwipopts.h 里 PBUF_POOL_BUFSIZE=1540（且是无条件的，
+           注释写明"should be atleast 1518 to be compatible with ps2smap"），
+           所以一个以太网帧一定落在同一个 pbuf 里，整帧连续。 */
+        SmapRxHook((const unsigned char *)pBuf->payload, len);
+        return;
+    }
+
+    /* 兜底：池块比帧小时才走链式拷贝（复制到 static 缓冲，避免在中断
+       上下文里让调用方去遍历 pbuf 链 —— pbuf 结构体各版本字段布局有差异）。 */
+    for (q = pBuf, off = 0; q != NULL && off < len; q = q->next) {
+        int n = q->len;
+        if (n > len - off)
+            n = len - off;
+        mips_memcpy(&FrameBuffer[off], q->payload, n);
+        off += n;
+    }
+    SmapRxHook(FrameBuffer, off);
+}
+
 void SMapLowLevelInput(PBuf *pBuf)
 {
+    // [NETBOX] 先把完整原始帧交出去（必须在 ps2ip_input() 之前，见上方说明）。
+    SmapPassRawFrame(pBuf);
+
     // When we receive data, the interrupt-handler will invoke this function, which means we are in an interrupt-context. Pass on
     // the received data to ps2ip.
 
@@ -179,10 +256,32 @@ static inline int SMapInit(IPAddr IP, IPAddr NM, IPAddr GW, int argc, char *argv
 int _start(int argc, char *argv[])
 {
     IPAddr IP, NM, GW;
-    int result;
+    int result, regrc, NetboxLibRegistered;
 
     dbgprintf("SMAP: argc %d\n", iArgC);
 
+    /* -----------------------------------------------------------------------
+     * [NETBOX] 注册 netboxh 库（导出 smap_set_rx_hook / SMAPSendPacket /
+     * SMAPGetMACAddress，见 exports.tab）。
+     *
+     * 为什么必须在 _start 里做：IOP 装载器解析导入时是按 (库名, 版本) 去已注册
+     * 库链表里找，找不到就让模块装载失败。netbox.irx 导入的就是 netboxh 1.0，
+     * 所以只要这张表没注册，netbox.irx 一定装不上 —— 表现就是设置页里
+     * "resident" 永远不出现、主菜单也没有 netbox 图标。
+     *
+     * 刻意【不】因为注册失败就返回失败：普通 in-game SMB/以太网游戏根本用不到
+     * netboxh，不能因为这条 netbox 专用的路把既有功能搞挂。失败只打日志
+     * （用 netbox 诊断通道 UDP 40001 能看到）。
+     * ----------------------------------------------------------------------- */
+    NetboxLibRegistered = 0;
+    regrc = RegisterLibraryEntries(&_exp_netboxh);
+    if (regrc != 0) {
+        dbgprintf("SMAP: [NETBOX] RegisterLibraryEntries(netboxh) rc=%d\n", regrc);
+    } else {
+        NetboxLibRegistered = 1;
+        dbgprintf("SMAP: [NETBOX] netboxh 1.0 registered\n");
+    }
+
     // Parse IP args.
     if (argc >= 4) {
         dbgprintf("SMAP: %s %s %s\n", argv[1], argv[2], argv[3]);
@@ -199,6 +298,8 @@ int _start(int argc, char *argv[])
     if (!SMapInit(IP, NM, GW, argc - 4, &argv[4])) {
 
         // Something went wrong.
+        if (NetboxLibRegistered)
+            ReleaseLibraryEntries(&_exp_netboxh);
         result = MODULE_NO_RESIDENT_END;
     } else
         result = MODULE_RESIDENT_END; // Initialized ok.
