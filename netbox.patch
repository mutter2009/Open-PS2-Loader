--- a/modules/network/smap-ingame/Makefile
+++ b/modules/network/smap-ingame/Makefile
@@ -1,5 +1,5 @@
 IOP_BIN = smap.irx
-IOP_OBJS = main.o smap.o xfer.o imports.o
