index 0000000..5110e14
--- /dev/null
+++ b/modules/netbox/netbox_imports.h
@@ -0,0 +1,74 @@
+/*
+ * netbox_imports.h - ps2ip 的导入声明
+ *
+ * ★★★ 2026-09-24 重大修正：库版本必须写 2.6，不是 1.3 ★★★
+ *
+ * 之前这里写的是 DECLARE_IMPORT_TABLE(ps2ip, 1, 3)，依据是 OPL 自带的
+ * modules/network/SMSTCPIP/exports.tab 声明的是 DECLARE_EXPORT_TABLE(ps2ip,1,3)。
+ * 但那是【in-game】用的网络栈。菜单里（含 BDM 设备扫
+ * 描、也就是 netbox 驱动真正加载的时刻）OPL 加载的是
+ *   Makefile: $(EE_ASM_DIR)ps2ip.c: $(PS2SDK)/iop/irx/ps2ip-nm.irx
+ * 即 ps2sdk 预编译的 ps2ip-nm.irx，它导出的是 ps2ip 版本 2.6。
+ * IOP 装载器按【库名 + 版本】精确匹配来解析导入表，版本对不上就直接拒绝加载模块：
+ *   SifExecModuleBuffer() -> id < 0
+ *   OPL 的 sysLoadModuleBuffer() 把 (id<0 || ret!=0) 一律压成 -2
+ *   => 设置页显示 "module load FAILED (rc=-2)"，且 _start() 从未执行，
+ *      所以线上抓包永远是 0 帧、设备也不会出现。
+ *
+ * 证据（都是对真实 IRX 二进制逐字节读出来的，见 NETBOX_LOAD_FAILURE_ROOTCAUSE.md）：
+ *   ps2ip-nm.irx  .text 开头导出表: magic | next=0 | ver=0x0206 | "ps2ip"
+ *   smbman.irx    导入 ps2ip: ver=0x0206, 函数号 [9,11,6,46,13,7,14,24,19]
+ *   ps2ips.irx    导入 ps2ip: ver=0x0206, 函数号 [4,5,6,7,16,17,18,19,8,9,10,11]
+ *   httpclient.irx 导入 ps2ip: ver=0x0206, 函数号 [9,11,6,14,13,46,7,48]
+ *   nbns.irx      导入 ps2ip: ver=0x0206, 函数号 [9,12,6,13,5,46]
+ * 用 OPL 自己的 imports.lst 顺序做对照（httpclient 的 ps2ip 导入顺序是
+ * lwip_recv, lwip_send, lwip_close, lwip_select, lwip_socket, lwip_shutdown,
+ * lwip_connect, lwip_gethostbyname），可以一一对上：
+ *   9=lwip_recv 11=lwip_send 6=lwip_close 14=lwip_select 13=lwip_socket
+ *   46=lwip_shutdown 7=lwip_connect 48=lwip_gethostbyname
+ * nbns 侧同样对上 12=lwip_sendto、5=lwip_bind。
+ * 这些函数号与 OPL SMSTCPIP 的 exports.tab 完全一致（那张表就是 ps2ip 的表），
+ * 所以下面 5/6/9/12/13/19/24 的编号不用改，只有【版本】和钩子要处理。
+ *
+ * 库版本号编码：u16 = (major << 8) | minor，所以 2.6 = 0x0206。
+ *
+ * 另外：ps2ip_set_raw_hook 只存在于我们补过的 SMSTCPIP（1.3）里，
+ * ps2ip-nm.irx(2.6) 的第 42 项是别的函数（ps2sdk 的导出表比 SMSTCPIP 长，
+ * 46/48 都被 smbman/httpclient 用到了）。因此默认【不导入】它，
+ * 只在显式打开 NETBOX_USE_RAWHOOK（并把 ps2ip 换成自编译版本）时才导入。
+ */
+
+#ifndef __NETBOX_IMPORTS_H__
+#define __NETBOX_IMPORTS_H__
+
+#include <irx.h>
+
+#ifndef ps2ip_IMPORTS_start
+/* ★ 必须是 2.6：运行时被加载的是 ps2sdk 的 ps2ip-nm.irx */
+#define ps2ip_IMPORTS_start DECLARE_IMPORT_TABLE(ps2ip, 2, 6)
+#define ps2ip_IMPORTS_end   END_IMPORT_TABLE
+#endif
+
+/* 函数号与 OPL SMSTCPIP 的 exports.tab / ps2sdk ps2ip 完全一致（已交叉验证） */
+#define I_lwip_bind       DECLARE_IMPORT(5, lwip_bind)
+#define I_lwip_close      DECLARE_IMPORT(6, lwip_close)
+#define I_lwip_recv       DECLARE_IMPORT(9, lwip_recv)   /* 收包路径 A 用（标准 4 参签名） */
+#define I_lwip_sendto     DECLARE_IMPORT(12, lwip_sendto)
+#define I_lwip_socket     DECLARE_IMPORT(13, lwip_socket)
+#define I_lwip_setsockopt DECLARE_IMPORT(19, lwip_setsockopt)
+#define I_inet_addr       DECLARE_IMPORT(24, inet_addr)
+
+/* 注意：不要导入 lwip_recvfrom(10)。
+ * OPL SMSTCPIP 的 recvfrom 是 SMS 改造过的 8 参签名
+ *   lwip_recvfrom(s, mem, hlen, payload, plen, flags, from, fromlen)
+ * 而 ps2sdk 的 ps2ip-nm.irx 是标准 6 参签名，两者 ABI 不兼容；
+ * 收包一律走 lwip_recv（两边签名一致）。 */
+
+#ifdef NETBOX_USE_RAWHOOK
+/* 原始帧钩子：只有自编译的 ps2ip（在 ps2ip_input 里回调）才有这个导出。
+ * ps2sdk 预编译的 ps2ip-nm.irx 没有，导入它的第 42 项会指向别的函数。 */
+#define NB_RAW_HOOK_EXPORT_NUM 42
+#define I_ps2ip_set_raw_hook DECLARE_IMPORT(NB_RAW_HOOK_EXPORT_NUM, ps2ip_set_raw_hook)
+#endif
+
+#endif
