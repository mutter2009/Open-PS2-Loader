+# [NETBOX] 云端编译 OPL + netbox 驱动
+#
+# 为什么要有这个 workflow：
+#   netbox.patch 只是一个"补丁文件"，光把它上传到仓库不会改动任何代码。
+#   直接跑 CI-compile 编出来的是原版 OPL（没有 netbox 驱动）。
+#   本 workflow 在云端先 git apply 补丁，再编译，产出带 netbox 的 ELF。
+#
+# 触发方式：只允许手动触发（Actions 页 -> 左侧选 "OPL-netbox" -> 右上角 Run workflow）
+#          刻意不配置 push 触发，这样每次改动/上传文件都不会自动编译。
+name: OPL-netbox
+
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    container: ghcr.io/ps2homebrew/ps2homebrew:main
+    steps:
+      - name: git checkout
+        uses: actions/checkout@v4
+
+      - name: Full history
+        run: |
+          git config --global --add safe.directory "$GITHUB_WORKSPACE"
+          git fetch --prune --unshallow || true
+
+      - name: 补丁指纹（确认编的是哪一版补丁）
+        run: |
+          sha256sum netbox.patch
+          grep -c '^diff --git' netbox.patch
+
+      - name: Apply netbox patch
+        run: |
+          git apply --verbose --exclude='.github/workflows/*' netbox.patch
+
+      - name: Compile -> make clean release
+        run: make --trace clean release
+
+      # 关键：发布版 ELF 是 ps2-packer 压缩过的，字符串全没了，
+      # 没法用它判断"驱动到底有没有编进去"。所以这里另外收集证据：
+      # 未压缩的 opl.elf、链接 map、以及 bin2c 产物。
+      - name: Collect verification info
+        if: ${{ always() }}
+        run: |
+          {
+            echo "=== netbox.patch sha256（对着我给的哈希核对版本）==="
+            sha256sum netbox.patch
+            echo
+            echo "=== modules/netbox IRX 产物 ==="
+            ls -la modules/netbox/*.irx 2>&1
+            echo
+            echo "=== bin2c 产物 asm/netbox.c ==="
+            ls -la asm/netbox.c 2>&1
+            echo
+            echo "=== 目标文件 obj/netbox.o ==="
+            ls -la obj/netbox.o 2>&1
+            echo
+            echo "=== opl.map 里的 netbox 符号（证明链进了 ELF）==="
+            grep -i netbox opl.map 2>&1 | head -30
+            echo
+            echo "=== 未压缩 opl.elf 里的 netbox 字符串 ==="
+            strings -a opl.elf 2>/dev/null | grep -i netbox | head -20
+            echo
+            echo "=== [v12 关键证据] SMAP 原始帧钩子的接线是否真的编进了二进制 ==="
+            echo "--- smap-ingame 的导出表必须含库名 netboxh ---"
+            ls -la modules/network/smap-ingame/smap.irx 2>&1
+            echo "netboxh 出现次数: $(grep -a -c 'netboxh' modules/network/smap-ingame/smap.irx 2>&1)"
+            echo "--- netbox.irx 必须【导入】 netboxh（否则 IOP 装载器会拒绝加载它）---"
+            ls -la modules/netbox/netbox.irx 2>&1
+            echo "netboxh 出现次数: $(grep -a -c 'netboxh' modules/netbox/netbox.irx 2>&1)"
+            echo "--- netbox.irx 里【不应该】再出现 ps2ip/lwip 的导入（v12 已全部移除）---"
+            echo "lwip_ 出现次数: $(grep -a -c 'lwip_' modules/netbox/netbox.irx 2>&1)"
+            echo
+            echo "=== ⚠ 重要：查【函数名】必须查 .notiopmod.elf，不能查 .irx ==="
+            echo "理由（ps2sdk samples/Makefile.iopglobal 第 143-150 行）："
+            echo "    xxx.notiopmod.elf            <- 链接产物，含 .symtab（函数名在这里）"
+            echo "    xxx.notiopmod.stripped.elf   <- \$(IOP_STRIP) --strip-unneeded（符号表被删）"
+            echo "    xxx.irx                      <- iopfixup --rb --irx1（最终产物，已 strip）"
+            echo "所以 grep .irx 找函数名【永远返回 0】，不代表符号没编进去。"
+            echo "能在 .irx 里查到的只有【数据段字符串】：库名 netboxh、IRX_ID、printf 格式串。"
+            echo "（v14 的 verify 就踩过这个坑。）"
+            ls -la modules/network/smap-ingame/*.notiopmod.elf modules/netbox/*.notiopmod.elf 2>&1
+            echo
+            echo "=== [v14 关键证据] 两个真判据（链路 / 钩子自检）==="
+            echo "--- 版本串（在 .irx 里，是数据段的格式串，可查）---"
+            strings -a modules/netbox/netbox.irx 2>/dev/null | grep -i 'netbox_bd: PS2 NetBox' | head -3
+            echo "--- v14 新增符号 4=smap_get_link_status / 5=smap_get_rx_hook（查未 strip 的 ELF）---"
+            echo "smap ELF   smap_get_link_status : $(grep -a -c 'smap_get_link_status' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_get_rx_hook     : $(grep -a -c 'smap_get_rx_hook' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_link_status : $(grep -a -c 'smap_get_link_status' modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_get_rx_hook     : $(grep -a -c 'smap_get_rx_hook' modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "--- v14 自检相关串（在 .irx 里，可查）---"
+            echo "link DOWN 串        : $(grep -a -c 'PHY link DOWN' modules/netbox/netbox.irx 2>&1)"
+            echo "hook selftest 串    : $(grep -a -c 'rx hook self-check FAILED' modules/netbox/netbox.irx 2>&1)"
+            echo
+            echo "=== [v17 关键证据] 「把 PHY 初始化补跑一遍」有没有真的编进二进制 ==="
+            echo "--- 版本串必须是 v1.20 ... + headed probe frame + self-frame filter + fast-boot + lazy-connect（★v29 实机跑过：重链 + 长监听塞在 _start() 里 -> OPL 主页 10 分钟进不去，本版已废弃；看到 v1.20 才是本轮；v1.17=v27 实机跑过一次（headed probe 仍 FAIL identify —— 根因是判据被自发帧污染），v1.16=v26 实机跑过一次（前 8 帧与原厂逐字节相同仍零回应；多发的无 HP 头 probe 帧是唯一残留差异），v1.15=v25 未上机（屏幕宏名泄漏），v1.14=v24 实机跑过一次（帧长/dst MAC 表序未对齐），v1.13=v23，v1.12=v22，v1.11=v21，v1.10=v20，v1.9=v19 空转那一轮（stage 9 被夹成 0））---"
+            strings -a modules/netbox/netbox.irx 2>/dev/null | grep -i 'netbox_bd: PS2 NetBox' | head -3
+            echo "--- v17 第 8 个导出 smap_phy_reinit / v19 第 9 个导出 smap_loopback_set（查【未 strip 的 ELF】）---"
+            echo "smap ELF   smap_phy_reinit    : $(grep -a -c 'smap_phy_reinit'    modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_phy_reinit    : $(grep -a -c 'smap_phy_reinit'    modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_loopback_set  : $(grep -a -c 'smap_loopback_set'  modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "netbox ELF smap_loopback_set  : $(grep -a -c 'smap_loopback_set'  modules/netbox/netbox.notiopmod.elf 2>&1)"
+            echo "--- 旧导出（编号 1..7）一个都不能少：改了导出表就必须整表一起看 ---"
+            echo "smap ELF   smap_get_phy_dump : $(grep -a -c 'smap_get_phy_dump' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_get_rx_diag  : $(grep -a -c 'smap_get_rx_diag'  modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF   smap_get_rx_hook  : $(grep -a -c 'smap_get_rx_hook'  modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "--- xfer.c 的收帧记账符号仍在（v15 那条静默丢帧分支的证据）---"
+            echo "smap ELF nb_dbg_rx_bad     : $(grep -a -c 'nb_dbg_rx_bad'     modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "smap ELF nb_dbg_intr_rxend : $(grep -a -c 'nb_dbg_intr_rxend' modules/network/smap-ingame/smap.notiopmod.elf 2>&1)"
+            echo "--- v17 自检/诊断串（在 .irx 里，可查）---"
+            echo "link gate FAILED 串 : $(grep -a -c 'link gate FAILED' modules/netbox/netbox.irx 2>&1)"
+            echo "phy identify 诊断串 : $(grep -a -c 'phy identify code=' modules/netbox/netbox.irx 2>&1)"
+            echo "link ok 诊断串      : $(grep -a -c 'link ok: code=' modules/netbox/netbox.irx 2>&1)"
+            echo "FAIL stage= 出现次数: $(grep -a -c 'FAIL stage=' modules/netbox/netbox.irx 2>&1)"
+            echo "v1.20 标记           : $(grep -a -c 'v1.20' modules/netbox/netbox.irx 2>&1)"
+            echo "build-tag v30 诊断行 : $(grep -a -c 'build-tag v30' modules/netbox/netbox.irx 2>&1)"
+            echo "lazy-connect 标记   : $(grep -a -c 'lazy-connect' modules/netbox/netbox.irx 2>&1)"
+            echo "LAZY mode 串        : $(grep -a -c 'LAZY mode' modules/netbox/netbox.irx 2>&1)"
+            echo "lazy 诊断串         : $(grep -a -c 'lazy: ' modules/netbox/netbox.irx 2>&1)"
+            echo "factory-aligned 标记 : $(grep -a -c 'factory-aligned tx frame' modules/netbox/netbox.irx 2>&1)"
+            echo "dst-MAC ladder      : $(grep -a -c 'dst-MAC ladder' modules/netbox/netbox.irx 2>&1)"
+            echo "PHY loopback   : $(grep -a -c 'PHY loopback' modules/netbox/netbox.irx 2>&1)"
+            echo "A/B listen     : $(grep -a -c 'A/B listen' modules/netbox/netbox.irx 2>&1)"
+            echo "--- gui.c 侧的 v17 打包解码（EE 侧，编进 OPL.ELF 而不是 irx）---"
+            echo "OPL.elf: 'NO PHY (mdio floats FFFF)' : $(grep -a -c 'NO PHY (mdio floats FFFF)' opl.elf 2>&1)"
+            echo "OPL.elf: 'link DOWN bmsr='           : $(grep -a -c 'link DOWN bmsr=' opl.elf 2>&1)"
+            echo "OPL.elf: 'PHY ok(non-DP83846)'       : $(grep -a -c 'PHY ok(non-DP83846)' opl.elf 2>&1)"
+            echo "OPL.elf: 'PHY reset stuck'           : $(grep -a -c 'PHY reset stuck' opl.elf 2>&1)"
+            echo "OPL.elf: 'link ok lm='               : $(grep -a -c 'link ok lm=' opl.elf 2>&1)"
+            echo "OPL.elf: 'resident (raw SMAP v30)'   : $(grep -a -c 'resident (raw SMAP v30)' opl.elf 2>&1)"
+            echo
+            echo "=== ★[v26 关键闸] 屏幕版本标记唯一 —— 末尾那个 \"(vNN)\" 不许再硬编码 ==="
+            echo "起因：v23 的构建在 stage 6 屏幕上打出 \"(v18)\"、在 stage 11 打出 \"(v22)\"，"
+            echo "      看着像补丁没生效。根因是每条状态串各自硬编码了自己新增那一版的后缀。"
+            echo "约定：后缀一律走 NB_UITAG；字面量只允许 2 处（宏定义 + resident 串）。"
+            echo "--- 旧式硬编码后缀的条数，必须为 0 ---"
+            echo "OPL.elf 里旧后缀 (v17)/(v18)/(v20)/(v21)/(v22) 合计: $(strings -a opl.elf 2>/dev/null | grep -c -E '\((v17|v18|v20|v21|v22)\)' )"
+            echo "--- 新标记必须存在 ---"
+            echo "OPL.elf: '(v30)' 出现次数        : $(strings -a opl.elf 2>/dev/null | grep -c -F '(v30)')"
+            echo "OPL.elf: 'NB_UITAG' 不该出现     : $(strings -a opl.elf 2>/dev/null | grep -c -F 'NB_UITAG')  （宏会被展开，非 0 说明写法有误）"
+            echo "gui.c: '#define NB_UITAG \"(v30)\"' : $(grep -a -c '#define NB_UITAG "(v30)"' src/gui.c 2>&1)"
+            echo "（前两条：旧后缀=0、新标记>=28 才算过；上面任一条不满足就是屏幕又会撒谎）"
+            echo "（每条都应 >=1；为 0 说明 gui.c 的解码分支没编进去）"
+            echo
+            echo "=== [v18 关键证据] 「收发现场计数」上屏那条路通没通 ==="
+            echo "--- gui.c 侧六条 v18 短语，一条都不能少（各对应一种修法方向）---"
+            echo "OPL.elf: 'TX ENGINE STUCK (gnp)'     : $(grep -a -c 'TX ENGINE STUCK (gnp)' opl.elf 2>&1)"
+            echo "OPL.elf: 'TX DEAD CARRIER'           : $(grep -a -c 'TX DEAD CARRIER' opl.elf 2>&1)"
+            echo "OPL.elf: 'BAD FRAMES='               : $(grep -a -c 'BAD FRAMES=' opl.elf 2>&1)"
+            echo "OPL.elf: 'MAL STUCK nrx='            : $(grep -a -c 'MAL STUCK nrx=' opl.elf 2>&1)"
+            echo "OPL.elf: 'rx armed, 0 frames'        : $(grep -a -c 'rx armed, 0 frames' opl.elf 2>&1)"
+            echo "OPL.elf: 'NO RX IRQ at all'          : $(grep -a -c 'NO RX IRQ at all' opl.elf 2>&1)"
+            echo "（每条都应 >=1；为 0 说明 gui.c 的 v18 解码分支没编进去）"
+            echo "--- netbox.irx 侧 v18 打包/诊断串 ---"
+            echo "netbox.irx: 'v18 intr='              : $(grep -a -c 'v18 intr=' modules/netbox/netbox.irx 2>&1)"
+            echo "--- smap.irx 侧 v18 的 MAC 侧再落一遍（改的是 smap.c，只查数据段串）---"
+            echo "smap.irx IRX_ID 仍是 smap_driver     : $(grep -a -c 'smap_driver' modules/network/smap-ingame/smap.irx 2>&1)"
+            echo
+            echo "=== [v19 关键证据] 自环自检那一路有没有真的编进二进制 ==="
+            echo "--- gui.c 侧四条 v19 短语，一条都不能少（各对应一种修法方向）---"
+            echo "OPL.elf: 'LOOPBACK: MAL frames, no IRQ nrx=' : $(grep -a -c 'LOOPBACK: MAL frames, no IRQ nrx=' opl.elf 2>&1)"
+            echo "OPL.elf: 'LOOPBACK OK: PS2 rx path fine'     : $(grep -a -c 'LOOPBACK OK: PS2 rx path fine' opl.elf 2>&1)"
+            echo "OPL.elf: 'LOOPBACK: IRQ ran, no frame nrx='  : $(grep -a -c 'LOOPBACK: IRQ ran, no frame nrx=' opl.elf 2>&1)"
+            echo "OPL.elf: 'LOOPBACK DEAD: PS2 never rx'       : $(grep -a -c 'LOOPBACK DEAD: PS2 never rx' opl.elf 2>&1)"
+            echo "（每条都应 >=1；为 0 说明 gui.c 的 stage 9 分支没编进去）"
+            echo "--- netbox.irx 侧 v20 自环诊断串 + 目的 MAC 阶梯 ---"
+            echo "netbox.irx: 'v20 loopback:'          : $(grep -a -c 'v20 loopback:' modules/netbox/netbox.irx 2>&1)"
+            echo "netbox.irx: 'dstmac_xx='             : $(grep -a -c 'dstmac_xx=' modules/netbox/netbox.irx 2>&1)"
+            echo "netbox.irx: 'PHY loopback'      : $(grep -a -c 'PHY loopback' modules/netbox/netbox.irx 2>&1)"
