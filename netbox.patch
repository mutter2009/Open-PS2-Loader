+            echo "  （v19 的翻车教训：加 stage 必须同步扩上界，否则新分支被 -O2 当死代码删掉。）"
+            echo "gui.c: 'stage > 12'                   : $(grep -a -c 'stage > 12' src/gui.c 2>&1)"
+            echo "gui.c: 'linkchk'                      : $(grep -a -c '\"linkchk\"' src/gui.c 2>&1)"
+            echo "--- v23 判定函数必须读 g_pc[]（BMCR/BMSR/PHYSTS/FCSCR/RECR）+ g_lk[] ---"
+            echo "netbox_bd.c: 'smap_phy_counters(g_pc, 8)' : $(grep -a -c 'smap_phy_counters(g_pc, 8)' modules/netbox/netbox_bd.c 2>&1)"
+            echo "netbox_bd.c: 'NB_BMCR_LPBK_BIT'          : $(grep -a -c 'NB_BMCR_LPBK_BIT' modules/netbox/netbox_bd.c 2>&1)"
+            echo "--- gui.c 侧 v23 短语（LINKCHK 那一格的措辞，至少代表两种修法方向）+ 成功串 ---"
+            echo "OPL.elf: 'LINKCHK: PHY STUCK LOOPBACK' : $(grep -a -c 'LINKCHK: PHY STUCK LOOPBACK' opl.elf 2>&1)"
+            echo "OPL.elf: 'LINKCHK: TX STUCK txq='      : $(grep -a -c 'LINKCHK: TX STUCK txq=' opl.elf 2>&1)"
+            echo "OPL.elf: 'LINKCHK: NO LINK aneg='      : $(grep -a -c 'LINKCHK: NO LINK aneg=' opl.elf 2>&1)"
+            echo "OPL.elf: 'resident (raw SMAP v30)'      : $(grep -a -c 'resident (raw SMAP v30)' opl.elf 2>&1)"
+            echo "OPL.elf: 'RX SILENT; PS2 link+TX clean' : $(grep -a -c 'RX SILENT; PS2 link+TX clean' opl.elf 2>&1)"
+            echo "（每条都应 >=1；为 0 说明 gui.c 的 stage 12 分支没编进去）"
+            echo
+            echo "--- smap-ingame 的构建顺序（必须先于 netbox）---"
+            grep -n "smap-ingame\|netbox" opl.map 2>/dev/null | head -10
+            echo
+            echo "=== 产物清单 ==="
+            ls -la OPNPS2LD*.ELF opl.elf opl_stripped.elf 2>&1
+          } > verify.txt 2>&1
+          cat verify.txt
+
+      - name: Upload ELF（PS2 用这个）
+        if: ${{ success() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: OPNPS2LD-netbox
+          path: OPNPS2LD-*.ELF
+
+      - name: Upload build evidence（排查用，别拷进 PS2）
+        if: ${{ always() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: netbox-build-verify
+          if-no-files-found: warn
+          path: |
+            verify.txt
+            opl.elf
+            opl.map
