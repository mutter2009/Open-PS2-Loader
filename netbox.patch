diff --git a/src/gui.c b/src/gui.c
index 1054228..9865bd6 100644
--- a/src/gui.c
+++ b/src/gui.c
@@ -440,17 +440,200 @@ void guiShowNetCompatUpdateSingle(int id, item_list_t *support, config_set_t *co
 static void guiShowBlockDeviceConfig(void)
 {
     int ret;
+    int i;
 
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEILK, gEnableILK);
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEMX4SIO, gEnableMX4SIO);
     diaSetEnabled(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, !gHDDStartMode);
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, gEnableBdmHDD);
+    diaSetInt(diaBlockDevicesConfig, CFG_ENABLENETBOX, gEnableNetBox); // [NETBOX]
+
+    // [NETBOX] 把驱动状态直接写到 "NetBox Network" 这一行上。
+    // 这样不接电脑、不抓包，也能一眼分清卡在哪一层（顺序 = 实际发生顺序）：
+    //   OFF                        -> 开关没开，驱动不会被加载
+    //   not loaded yet             -> 还没走到 BDM 扫描（正常，进一次设备列表就会变）
+    //   smap LOAD REFUSED / FAILED -> 第 1 关没过：smap_ingame 没驻留 =>
+    //                                 netboxh 库没注册 => netbox.irx 必被 IOP 拒绝。
+    //                                 （netbox.irx 导入 netboxh 的五个符号，
+    //                                   netboxh 由 smap_ingame 的 _start 注册）
+    //   smap ok, netbox pending    -> 第 1 关过了，等 netbox.irx（正常过渡态）
+    //   netbox LOAD REFUSED        -> 第 2 关没过：IOP 拒绝加载 netbox.irx
+    //                                 （库名/版本/函数号对不上，或导入解析不到）
+    //   driver START FAILED        -> 装上了但 _start() 早退
+    //   FAIL ... (v16)             -> 驱动自检失败。它【故意不驻留】（注册了 BD
+    //                                 设备也读不出来，不如直接报），并把失败现场
+    //                                 整串编进返回值：
+    //                                 [格式 A · v15 五字段，仍用于非 PHY 的失败]
+    //                                     ret = 1000000 + stage*100000 + lk*10000
+    //                                                 + rx*1000 + e*100 + hook
+    //                                 stage（名字直接印在标签上，与驱动 NB_STAGE_* 一致）:
+    //                                   hook    钩子自检失败（netboxh 导入是空桩）
+    //                                   link    ★PHY 没有链路★（网线/对端，最常见）
+    //                                   mac     MAC 全零（smap_init 没跑完）
+    //                                   tx      一帧都发不出去（SmapIsInitialized=0）
+    //                                   noreply 发得出去但收不到任何回包
+    //                                   identify 收到回包但 IDENTIFY 对不上
+    //                                   read0   读 LBA0 失败
+    //                                   bootsig LBA0 读到了但没有 55AA 引导签名
+    //                                 lk = PHY 现场链路模式码：
+    //                                   0 无链路 / 1 10M半 / 2 10M全 /
+    //                                   3 100M半 / 4 100M全 / 5 PHY 不响应
+    //                                 rx = MAL 收到过帧的摘要（0 = 一帧都没到过 PS2）
+    //                                 e  = 收帧错误类别（0 无错 / 1 BD 丢帧 / 2 BAD_FCS
+    //                                      / 3 短帧 / 4 其它收帧错 / 5 发帧错误）
+    //                                 hook = 钩子被调用次数（0..99）
+    //                                 ★ 关键读法：lx/rx/e 这三个一起看就能把
+    //                                   "盒子没回话"和"回了但被以太网层丢掉"分开。
+    //                                 [格式 B · v16 PHY 身份诊断包，见下面 0x40000000 分支]
+    //                                   只在"PHY 的 ID 认不出来"时出现，把含糊的
+    //                                   lk=5 拆成三种病，并带上 PHYIDR1/PHYIDR2 原值。
+    //   resident (raw SMAP v16)    -> 自检全过（钩子自检 + PHY 身份 + 链路 + 真读 LBA0
+    //                                 + 55AA 校验），BD 设备已注册，mass0: 应该能挂上。
+    // 注意：diaSetLabel() 只保存指针不复制字符串（见 src/dia.c），必须是 static 缓冲。
+    {
+        static char netboxStatus[160];
+        /* 与驱动 NB_STAGE_* 一一对应；下标 1..8 有效。 */
+        static const char *stageName[] = {
+            "?", "hook", "link", "mac", "tx", "noreply", "identify", "read0", "bootsig"
+        };
+        int stage = 0, lk = 0, rx = 0, e = 0, hook = 0;
+
+        if (!gEnableNetBox)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox Network: OFF");
+        else if (gNetboxSmapStartRC == NETBOX_SMAP_RC_NOT_TRIED)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON (not loaded yet)");
+        else if (gNetboxSmapStartRC == -1)
+            snprintf(netboxStatus, sizeof(netboxStatus),
+                     "NetBox: ON, smap LOAD REFUSED -> netboxh absent, netbox.irx will fail");
+        else if (gNetboxSmapStartRC != 0)
+            snprintf(netboxStatus, sizeof(netboxStatus),
+                     "NetBox: ON, smap START FAILED (rc=%d) -> netboxh absent", gNetboxSmapStartRC);
+        else if (gNetBoxStartRC == NETBOX_START_RC_NOT_TRIED)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, smap ok (netbox.irx pending)");
+        else if (gNetBoxLoadID < 0)
+            snprintf(netboxStatus, sizeof(netboxStatus),
+                     "NetBox: ON, smap ok, netbox LOAD REFUSED (id=%d)", gNetBoxLoadID);
+        else if (gNetBoxStartRC & 0x40000000) {
+            /* [v16] PHY 身份诊断包。位布局与 modules/netbox/netbox_bd.c 的
+             * NB_V16_MARK 注释严格对应：
+             *   bit27..29 code  / bit24..26 stage / bit8..23 PHYIDR1 / bit0..7 PHYIDR2>>8
+             *
+             * ★ 这个分支必须排在下面的 ">= 1000000" 之前：打包值首字节是
+             *   0x40，即 1073741824，比 1000000 大得多，否则会被 v15 那套
+             *   十进制解码吃掉、解出一堆垃圾数字。
+             *
+             * 它只在"PHY 的 ID 认不出来"这条路上出现，作用是把 v15 里
+             * 含糊的 lk=5 拆成三种修法完全不同的病：
+             *   ALL ZERO -> MDIO 轮询超时，操作根本没完成（EMAC3 没在跑）
+             *   NO PHY   -> MDIO 数据线悬空 0xFFFF，这个地址上没有 PHY
+             *   not DP83846 -> PHY 在、ID 也合法，是判据太严（上游并不这么判）
+             * 后两种情况下 id1/id2 就是 PHYIDR1 与 PHYIDR2 的高字节原值。 */
+            int code = (gNetBoxStartRC >> 27) & 7;
+            unsigned int idr1 = ((unsigned int)gNetBoxStartRC >> 8) & 0xFFFFu;
+            unsigned int idr2hi = (unsigned int)gNetBoxStartRC & 0xFFu;
+
+            stage = (gNetBoxStartRC >> 24) & 7;
+            if (stage < 1 || stage > 8)
+                stage = 0;
+
+            switch (code) {
+            case 1: /* PHYIDR 全 0x0000 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s PHY mdio ALL ZERO id1=0000 (v16)", stageName[stage]);
+                break;
+            case 2: /* PHYIDR 全 0xFFFF —— 数据线悬空 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s NO PHY (mdio floats FFFF) (v16)", stageName[stage]);
+                break;
+            case 3: /* 合法 ID 但不是 DP83846 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s PHY not DP83846 id1=%04X id2=%02X (v16)",
+                         stageName[stage], idr1, idr2hi);
+                break;
+            case 4: /* 一个 0 一个非 0：需要看原值 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s PHY mdio mixed id1=%04X id2=%02X (v16)",
+                         stageName[stage], idr1, idr2hi);
+                break;
+            default:
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s phy code=%d id1=%04X id2=%02X (v16)",
+                         stageName[stage], code, idr1, idr2hi);
+                break;
+            }
+        } else if (gNetBoxStartRC >= 1000000) {
+            /* v15 编码：1000000 + stage*100000 + lk*10000 + rx*1000 + e*100 + hook
+             * 每档宽度与驱动侧一致（stage<=8、lk<=5、rx<=9、e<=5、hook<=99）。 */
+            int v = gNetBoxStartRC - 1000000;
+
+            stage = v / 100000; v %= 100000;
+            lk    = v / 10000;  v %= 10000;
+            rx    = v / 1000;   v %= 1000;
+            e     = v / 100;    v %= 100;
+            hook  = v;
+
+            if (stage < 1 || stage > 8)
+                stage = 0; /* 防越界，stageName[0] = "?" */
+
+            if (stage == 2 && lk == 5)
+                /* ★v16 之后这一支已【不可达】：lk==5（PHY 的 ID 认不出来）
+                 * 现在会被上面的 v16 打包分支接走，并带上 PHYIDR1/PHYIDR2
+                 * 的原值。保留它只是兜底（万一打包值恰好落进 v15 的区间）。 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s PHY no response (mdio stuck) (v16)", stageName[stage]);
+            else if (stage == 2)
+                /* PHY 身份已经过了 v16 那道闸，所以这里的"没链路"是真的没链路。 */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL LINK DOWN - check cable (v16)");
+            else if (stage == 1)
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL rx hook not installed (v16)");
+            else
+                /* 这条是主诊断行：stage 名字 + 链路模式 + 收帧摘要 + 错误类别 + 钩子数
+                 * 例：NetBox: FAIL noreply lk=1 rx=0 e=0 hk=0 (v16)
+                 *     -> 链路是 10M 半双工（盒子那头是 10M 口？），一个帧都没到过 PS2。
+                 * （编码格式仍是 v15 那套 5 字段，只有打包的 PHY 诊断包是新格式。） */
+                snprintf(netboxStatus, sizeof(netboxStatus),
+                         "NetBox: FAIL %s lk=%d rx=%d e=%d hk=%d (v16)",
+                         stageName[stage], lk, rx, e, hook);
+        } else if (gNetBoxStartRC != 0)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, driver START FAILED (ret=%d)",
+                     gNetBoxLoadID, gNetBoxStartRC);
+        else
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, resident (raw SMAP v16)", gNetBoxLoadID);
+        diaSetLabel(diaBlockDevicesConfig, CFG_NETBOX_STATUS, netboxStatus);
+    }
+
+    // [NETBOX] 下面这几个 IP 输入框自 v12 起【已不再使用】。
+    // netbox 的收发全部是原始以太网帧：PS2 自发帧的 IP 源地址填 0.0.0.0
+    // （与原厂 loader 一致），目的地址 255.255.255.255，盒子也只广播回。
+    // 也就是说这条链路根本不需要给网卡配 IP，连 lwIP 网卡都不需要。
+    // 控件保留（配置文件里还有对应项）但置灰，避免误以为不改它就通不了。
+    for (i = 0; i < 4; i++) {
