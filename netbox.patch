diff --git a/modules/netbox/Makefile b/modules/netbox/Makefile
new file mode 100644
index 0000000..ff4da73
--- /dev/null
+++ b/modules/netbox/Makefile
@@ -0,0 +1,23 @@
+# 注意：产物名必须是 netbox.irx —— 根目录 Makefile 的
+#   modules/netbox/netbox.irx -> asm/netbox.c (bin2c) -> iop/netbox.o
+# 这条链是按这个名字写死的，改成别的名字 bin2c 会找不到文件。
+IOP_BIN  = netbox.irx
+IOP_OBJS = netbox_bd.o imports.o
+
+# 与 OPL 其他 IOP 模块（如 modules/bdmevent）保持一致
+IOP_INCS += -I../../include/
+
+IOP_CFLAGS += -Wall
+
+# v12 起本模块的收发全部走 SMAP 原始帧（导入 netboxh 库，由
+# modules/network/smap-ingame 注册），不再使用 ps2ip/lwIP：
+#   - 盒子回包的 IP total_length 恒为 124、UDP length 恒为 104，
+#     而以太网帧是 640 字节，ip_input() 里的 pbuf_realloc 会把扇区数据裁掉；
+#   - 收发都靠广播，不需要 IP 配置，也就不需要 ps2ip 的版本号/ABI 兼容。
+# 所以这里没有任何可选宏；"smap-ingame 必须比 netbox.irx 先加载"这个顺序
+# 由 src/bdmsupport.c 的 ethLoadNetboxModules() 保证（netbox.irx 导入
+# netboxh 的三个符号，smap 没起来时 IOP 装载器会直接拒绝加载它）。
+
+include $(PS2SDK)/Defs.make
+include ../Rules.bin.make
+include $(PS2SDK)/samples/Makefile.iopglobal
diff --git a/modules/netbox/imports.lst b/modules/netbox/imports.lst
new file mode 100644
index 0000000..ca81e1c
--- /dev/null
+++ b/modules/netbox/imports.lst
@@ -0,0 +1,68 @@
+/*
+ * netbox.irx 的导入清单。
+ *
+ * 注意：本文件会被 ps2sdk 的 Makefile.iopglobal 原样 cat 进 build-imports.c
+ * （printf '#include "irx_imports.h"' + cat imports.lst），所以：
+ *   - 这里只能写 <lib>_IMPORTS_start / I_xxx / <lib>_IMPORTS_end 三种行；
+ *   - '#' 开头的行是【预处理指令】不是注释，注释只能用 C 风格；
+ *   - 每个 I_xxx 的编号由头文件里的 DECLARE_IMPORT(n, ...) 决定。
+ */
+
+bdm_IMPORTS_start
+I_bdm_connect_bd
+I_bdm_disconnect_bd
+bdm_IMPORTS_end
+
+/*
+ * netboxh = OPL 自带 smap-ingame 模块导出的「SMAP 原始帧收发」库。
+ * v12 起 netbox.irx 完全不用 ps2ip/lwIP，收发都走这一层。
+ * 编号见 modules/netbox/netbox_imports.h 与 modules/network/smap-ingame/exports.tab。
+ */
+netboxh_IMPORTS_start
+I_smap_set_rx_hook
+I_SMAPSendPacket
+I_SMAPGetMACAddress
+I_smap_get_link_status
+I_smap_get_rx_hook
+netboxh_IMPORTS_end
+
+stdio_IMPORTS_start
+I_printf
+stdio_IMPORTS_end
+
+sysclib_IMPORTS_start
+I_memcpy
+I_memset
+I_strcpy
+I_strlen
+I_sprintf
+sysclib_IMPORTS_end
+
+sysmem_IMPORTS_start
+I_AllocSysMemory
+sysmem_IMPORTS_end
+
+intrman_IMPORTS_start
+I_CpuSuspendIntr
+I_CpuResumeIntr
+I_QueryIntrContext
+intrman_IMPORTS_end
+
+thsemap_IMPORTS_start
+I_CreateSema
+I_DeleteSema
+I_SignalSema
+I_iSignalSema
+I_WaitSema
+I_PollSema
+thsemap_IMPORTS_end
+
+thbase_IMPORTS_start
+I_DelayThread
+thbase_IMPORTS_end
+
+loadcore_IMPORTS_start
+I_RegisterLibraryEntries
+I_FlushDcache
+I_FlushIcache
+loadcore_IMPORTS_end
