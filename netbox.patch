@@ -0,0 +1,132 @@
+/*
+ * netbox.h - PS2 NetBox 私有协议 (厂商内部名 NBD) 的字节级定义
+ *
+ * 全部常量来自对真实盒子流量的抓包解析 (见 ../PROTOCOL.md)，不是猜测。
+ * 协议本质: ATA-over-UDP。PS2 把 "写 ATA 寄存器 / 读 ATA 寄存器 / 轮询" 打包成
+ * 55 AA 记录流，用 UDP 广播 30000 -> 40000 发给盒子；盒子执行真实 ATA 命令后
+ * 把 512 字节扇区塞回 UDP 广播应答。
+ */
+
+#ifndef __NETBOX_H__
+#define __NETBOX_H__
+
+#include <types.h>
+
+/* ---------------- 以太网/IP/UDP 层 ---------------- */
+
+#define NB_ETH_HDR  14
+#define NB_IP_HDR   20
+#define NB_UDP_HDR  8
+#define NB_UDP_OFF  (NB_ETH_HDR + NB_IP_HDR + NB_UDP_HDR) /* 42: UDP 载荷起点 */
+
+#define NB_PORT        40000 /* 盒子监听端口，PS2 也从 30000 发往 40000 */
+#define NB_LOCAL_PORT  40000 /* 本机绑定端口（收盒子的广播应答） */
+#define NB_SRC_PORT    30000 /* PS2 源端口（盒子据此识别客户端） */
+
+/*
+ * 诊断通道：驱动把进度以纯文本广播到 UDP 40001。
+ * release 版 OPL 里 IOP 的 printf 看不见（没有 ps2link），
+ * 所以这是唯一能确认"驱动到底走到哪一步"的手段：
+ * PC 与 PS2 同网段抓包即可看到，不干扰协议端口 40000。
+ */
+#define NB_DIAG_PORT   40001
+
+/*
+ * 关键坑：盒子的应答是"畸形 IP 包"。
+ *   IP 头 total_length 声明 124，UDP 头声明 104，但以太网帧实际 640 字节，
+ *   真正的 512 字节扇区在 IP 声明长度之外。
+ *   lwIP 的 ip_input() 里有 pbuf_realloc(p, ntohs(IPH_LEN(iphdr)))，
+ *   会把它裁到 124 字节 -> 扇区数据丢失（socket 只能拿到 96 字节）。
+ *
+ *   所以 v12 起不再走 ps2ip：在 OPL 自带的 smap-ingame 里挂原始帧钩子
+ *   （smap_set_rx_hook，见 ../network/smap-ingame/main.c），在 ps2ip_input()
+ *   之前拿到完整以太网帧；发送也用 SMAPSendPacket 直接发裸帧。
+ *   （v11 及更早试图用自编译 ps2ip 的 ps2ip_set_raw_hook 解决，已废弃 ——
+ *     那条路还得替换菜单网络栈，副作用大。）
+ */
+#define NB_RSP_FRAME_LEN  640
+#define NB_RSP_PAYLOAD    598 /* 640 - 42 */
+#define NB_STATUS_FRAME   256
+
+/*
+ * 请求帧的以太网总长度（我们自己构造，见 netbox_bd.c 的 nb_build_frame）。
+ * 原厂 loader 实测有 256 / 384 / 512 三档，帧尾在记录流之后是未初始化内存
+ * —— 盒子照回不误，说明它只解析到 IP/UDP 长度字段声明的位置。
+ * 取最大的 512，尾部补零。
+ */
+#define NB_TX_FRAME_LEN   512
+
+/* ---------------- 应答帧（盒子 -> PS2）内部布局 ---------------- */
+/*
+ * 重要修正（2026-09-23 开机抓包实测）：
+ * 应答帧开头的填充记录条数【不是固定的 3 条】，而是随应答类型变化：
+ *     读扇区数据帧 (640B)  -> 3 条填充 -> 数据偏移 18
+ *     IDENTIFY 应答 (640B) -> 9 条填充 -> 数据偏移 54
+ *     命令状态帧   (256B)  -> 15 条填充
+ * 所以驱动必须【动态扫描】跳过所有 55aa 4a 00 xx 记录，
+ * 绝不能硬编码偏移 18，否则 IDENTIFY 会读到错位数据。
+ * 下面的常量只作为"典型值/上界"参考。
+ */
+#define NB_RSP_FILL_MAX   64   /* 最多允许扫描的填充记录条数 */
+#define NB_DATA_OFF_TYP   18   /* 读扇区时的典型数据偏移（仅参考） */
+#define NB_DATA_SIZE      512
+#define NB_DATA_END_TYP   530
+#define NB_F_OFF_TYP      530  /* 读扇区时的 F 记录偏移（仅参考） */
+#define NB_F_CMD_OFF      3    /* F 记录内 cmd 字节的相对下标 */
+#define NB_F_PARAM_OFF    4    /* F 记录内事务号的相对下标（大端） */
+
+/* ---------------- 记录格式 ---------------- */
+/* 每条记录 6 字节: 55 AA <type> <cmd> <param16 BE> */
+
+#define NB_SYNC0   0x55
+#define NB_SYNC1   0xAA
+#define NB_T_CMD   0x48 /* PS2 -> 盒子 的请求记录 */
+#define NB_T_RSP   0x4A /* 盒子 -> PS2 的应答记录 */
+
+/* cmd 字节 */
+#define NB_C_P     0x50 /* 帧头: param = 本记录之后所有记录的字节数 */
+#define NB_C_R     0x52 /* 读 ATA 寄存器: param = reg<<8 */
+#define NB_C_W     0x57 /* 写 ATA 寄存器: param = reg<<8 | value */
+#define NB_C_B     0x42 /* 块操作: 0x8000 = 开始, 0x0808 = 数据块 */
+#define NB_C_L     0x4C /* 轮询上限: 0x01ff */
+#define NB_C_F     0x46 /* 提交/刷新 + 携带事务号 */
+
+/* ---------------- ATA 寄存器映射 ---------------- */
+/* 协议里的寄存器编号 = ATA 寄存器号 + 8（抓包实测推导） */
+
+#define NB_REG_COUNT 0x0A /* ATA 0x02 扇区计数 */
+#define NB_REG_LBA0  0x0B /* ATA 0x03 LBA[0:7] / [24:31] */
+#define NB_REG_LBA1  0x0C /* ATA 0x04 LBA[8:15] / [32:39] */
+#define NB_REG_LBA2  0x0D /* ATA 0x05 LBA[16:23] / [40:47] */
+#define NB_REG_DEV   0x0E /* ATA 0x06 device/head */
+#define NB_REG_CMD   0x0F /* ATA 0x07 command/status */
+#define NB_REG_ALT   0xF2 /* 备用状态寄存器 */
+
+/* 开机握手专用寄存器（2026-09-23 开机抓包实测） */
+#define NB_REG_PROBE  0xFF /* 探测：握手第 1/2 帧读它 */
+#define NB_REG_ID1    0xF0 /* 握手第 2 帧读 */
+#define NB_REG_ID2    0xF1 /* 握手第 2 帧读 */
+#define NB_REG_ENABLE 0xFD /* 握手第 3 帧写 0x01（疑似启用 NBD 引擎） */
+#define NB_REG_RESET  0x16 /* 握手第 4/5 帧写 0x04 再写 0x00（软复位脉冲） */
+
+#define NB_DEV_LBA_MASTER 0x40 /* LBA 模式 + 主盘 */
+
+#define NB_ATA_READ_EXT   0x24 /* READ SECTORS EXT (48-bit) */
+#define NB_ATA_WRITE_EXT  0x34 /* WRITE SECTORS EXT (48-bit) */
+#define NB_ATA_IDENTIFY   0xEC /* IDENTIFY DEVICE */
+
+/* ---------------- 事务规则 ---------------- */
+
+/* 一个事务 = 1 个请求帧（内含 1 个提交 F + N 个轮询 F）
+ * 盒子回 1 个状态帧（F=T）+ N 个数据帧（F=T+1 .. T+N）
+ * 所以每事务消耗 N+1 个事务号。抓包实测 N=8 时步长正好是 9。 */
+#define NB_MAX_SECTORS 8 /* 抓包实测真实客户端最大用 8；改大需自行验证 */
+
+#define NB_REC_SIZE     6
+#define NB_CMD_RECS     15 /* 请求里 "P 之后的命令部分" 记录数（不含 N 个轮询块） */
+#define NB_POLL_RECS    4  /* 每个轮询块: B:8000 B:0808 L:01ff F */
+
+/* P 的 param = (NB_CMD_RECS + 4*count) * 6 */
+#define NB_P_PARAM(count) ((NB_CMD_RECS + (NB_POLL_RECS * (count))) * NB_REC_SIZE)
+
+#endif /* __NETBOX_H__ */
diff --git a/modules/netbox/netbox_bd.c b/modules/netbox/netbox_bd.c
new file mode 100644
index 0000000..3c44c1e
--- /dev/null
+++ b/modules/netbox/netbox_bd.c
@@ -0,0 +1,1100 @@
+/*
+ * netbox_bd.c - PS2 NetBox (NBD / ATA-over-UDP) 的 BDM 块设备驱动
+ *
+ * 目标：作为一个 IOP 侧 IRX 模块挂进官方 OPL，通过 bdm_connect_bd() 注册
+ *       struct block_device，让 OPL 把盒子硬盘当成本地块设备来读游戏。
+ *
+ * 协议依据：../PROTOCOL.md / netbox.h（由真实盒子抓包逐字节验证，
+ *          2026-09-23 还抓到了原厂 loader 的对照流量：请求 512 字节帧、
+ *          应答 640 字节帧，逐帧核对过）
+ *
+ * ==========================================================================
+ * ★ v12（2026-09-24）传输层大改：从 lwIP socket 换成 SMAP 裸帧 ★
+ * ==========================================================================
+ *
+ * v11 及更早用 lwIP 的 UDP socket 收发，实机上「模块驻留成功
+ * （id=68, driver resident）但连 netbox 图标都不出来」。原因有两层：
+ *
+ * 1) 应用层看不到帧。盒子把应答【广播】到 255.255.255.255、源 MAC
+ *    08:00:27:7f:f6:27、UDP 30000->40000。发给特定地址的 socket 在 lwIP
+ *    里不一定能收到广播。
+ *
+ * 2) 就算收到，数据也是残的。盒子的 IP 头 total_length 恒为 124、
+ *    UDP 头 length 恒为 104，而以太网帧实际 640 字节（抓包 254148 帧全部
+ *    如此，是固件写死的常数）。lwIP 的 ip_input() 里
+ *    pbuf_realloc(p, ntohs(IPH_TOTLEN)) 会把 pbuf 裁到 124 字节，socket
+ *    最多只能拿到 96 字节 UDP 载荷 —— 而一个读扇区应答有 536 字节
+ *    （18 字节前导记录 + 512 字节扇区 + 6 字节收尾记录）。
+ *    => 扇区数据在进 UDP 层之前就没了 => fatfs 挂不上 mass0: =>
+ *       bdmUpdateDeviceData() 里 fileXioDopen("mass0:/") 失败 =>
+ *       OPL 连设备图标都不显示，更不用说游戏列表。
+ *
+ * 所以 v12 完全绕开 ps2ip：
+ *   收 —— 在 OPL 自带的 smap-ingame 模块里注册「原始帧钩子」
+ *          （smap_set_rx_hook，见 ../network/smap-ingame/main.c），
+ *          钩子在 SMapLowLevelInput() 里、ps2ip_input() 【之前】被调用，
+ *          拿到的是刚 DMA 出来的完整以太网帧，一个字节不少。
+ *   发 —— 同样用 SMAP 直接发裸帧（SMAPSendPacket），自己拼
+ *          ETH+IP+UDP 头。这条路径与原厂 loader 完全一致（原厂请求帧
+ *          源 MAC 全零、目的 MAC 是垃圾、IP 0.0.0.0 -> 255.255.255.255，
+ *          说明盒子只看 UDP 端口和 55 AA 记录流，不看 MAC/IP）。
+ *
+ * 附带好处：不再依赖 ps2ip 的版本号（1.3 还是 2.6）、不再需要知道
+ * 盒子 IP、不需要 DHCP、不需要网卡配置 —— 少了四类可能出错的环节。
+ *
+ * 已知前提 / 注意：
+ *  1. 必须在 smap-ingame 之后加载：本模块导入 netboxh 库的符号，
+ *     没有 smap-ingame 时 IOP 装载器会直接拒绝加载（id < 0）。
+ *  2. 盒子 IP 不写死：全程广播，靠事务号配对。
+ *  3. 写操作未抓到过样本，本驱动只读（write 返回 -1），避免静默写坏数据。
+ *
+ * ==========================================================================
+ * ★ v14（2026-09-24 傍晚）补掉最后一个盲点：链路状态与钩子自检 ★
+ * ==========================================================================
+ *
+ * v13 在实机上报回 "NetBox: FAIL stage=3 hook=0"，也就是
+ * 「发送自检通过、但一个回包都没收到」。去读 smap-ingame/smap.c 的
+ * SMAPStart() 之后发现 v13 的 stage=2 判据是假阳性：
+ *
+ *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ *     if (result == 0 && !NetDevStopFlag) { ...; SmapIsInitialized = 1; }
+ *
+ * 而 InitPHY() 的每一条出口都是【无条件 return 0】（smap.c 末尾），
+ * 它内部所有"等链路"的循环超时后也只是把 LinkStatus 置 0 继续往下走。
+ * ⇒ **链路从来没起来时，InitPHY 也报成功，SmapIsInitialized 也是 1，
+ *   SMAPSendPacket() 也返回 1。** "发送成功"完全不能证明链路上有线。
+ *
+ * 所以 v14 增加了两个 netboxh 导出（见 smap-ingame/exports.tab）：
+ *   smap_get_link_status() —— 直接读 PHY 的 BMSR bit2，这是唯一可信判据
+ *   smap_get_rx_hook()     —— 回读钩子指针，区分「钩子没装上」与「没回包」
+ * 并把两者编进 _start() 的返回码，设置页直接显示。
+ */
+
+#include <bdm.h>
+#include <intrman.h>
+#include <irx.h>
+#include <loadcore.h>
+#include <stdio.h>
+#include <sysclib.h>
+#include <sysmem.h>
+#include <thbase.h>
+#include <thsemap.h>
+#include <types.h>
+
+#include "netbox.h"
+
+IRX_ID("netbox_bd", 1, 0);
+
+/* ------------------------------------------------------------------ */
+/* netboxh 库（OPL 自带的 smap-ingame 模块导出）                        */
+/*                                                                     */
+/* 编号与 modules/network/smap-ingame/exports.tab 严格一致：            */
+/*   1 smap_set_rx_hook    2 SMAPSendPacket      3 SMAPGetMACAddress    */
+/*   4 smap_get_link_status 5 smap_get_rx_hook   （后两个 v14 新增）     */
+/* 导入语句本身在 imports.lst（宏在 netbox_imports.h），这里只是给     */
+/* 编译器提供原型。                                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * 原始帧钩子。签名必须和 smap-ingame/main.c 里的 SmapRxHook 一致：
+ *     void (*)(const unsigned char *frame, int len)
+ * 它在 SMAP 的收包中断线程里被直接调用（xfer.c: HandleRxIntr ->
+ * SMapLowLevelInput -> SmapPassRawFrame），此时模块的 GP 切换由 -G0
+ * 编译选项天然规避（ps2sdk 的 Makefile.iopglobal 一律带 -G0，
+ * 没有小数据段，所以跨模块的函数指针调用是安全的）。
+ */
+typedef void (*nb_rx_hook_t)(const unsigned char *frame, int len);
+
+extern void smap_set_rx_hook(void *fn);
+extern void *smap_get_rx_hook(void);
+extern int SMAPSendPacket(const void *data, unsigned int length);
+extern int SMAPGetMACAddress(unsigned char *buffer);
+extern int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode);
+
+/* ------------------------------------------------------------------ */
+/* 收包环形缓冲（原始帧钩子写入，协议线程消费）                          */
+/* ------------------------------------------------------------------ */
+
+#define NB_RX_SLOTS 32
+#define NB_RX_MAX   1536
+
+static u8          rx_buf[NB_RX_SLOTS][NB_RX_MAX];
+static volatile int rx_len[NB_RX_SLOTS];
+static volatile int rx_head; /* 生产者（收包中断） */
+static volatile int rx_tail; /* 消费者（读盘线程） */
+static int          io_sema; /* 保证同一时刻只有一个事务在飞 */
+
+/*
+ * 诊断计数器（诊断包里以 hook=/rx=/drop= 上报）。
+ * 这三个数能把失败精确定位到四种完全不同的原因：
+ *
+ *   hook=0                -> 收包钩子没被调用：
+ *                            smap-ingame 没被加载（那 netbox.irx 其实也装不上），
+ *                            或者钩子注册失败。方案在这一步就是死的。
+ *   hook>0 但 drop=hook   -> 收到帧了但全被 rx_push 的过滤条件挡掉：
+ *                            ethertype / IP proto / 目的端口 判断与实机不符。
+ *   rx>0 但 IDENTIFY 失败  -> 协议层问题：事务号或数据偏移不对。
+ *   rx=0 且 hook=0        -> 根本没收到任何帧（网线、盒子没上电、链路没起来）。
+ */
+static volatile int g_hook_calls = 0;
+static volatile int g_rx_frames  = 0;
+static volatile int g_rx_drop    = 0;
+
+/*
+ * 发送失败计数（v13 新增）。
+ *
+ * 为什么必须单独数它：SMAPSendPacket() 的第一行是
+ *     if (SmapDriverData.SmapIsInitialized) { ...发... } else result = -1;
+ * 而 SmapIsInitialized 只在 SMAPStart() 里 PHY 真正 up 之后才置 1。
+ * SMAPStart() 是 smap-ingame 在 netif_add() 里调的，**返回值被丢掉了**。
+ * 于是"PHY/链路没起来 ⇒ 一个字节都发不出去 ⇒ 盒子永远收不到请求"
+ * 在 v12 里是完全不可见的：驱动照样返回 resident，设置页照样显示正常。
+ * g_tx_err>0 且 g_hook_calls==0 就是在说这件事。
+ *
+ * ★ v14 更正：上面这段推断在 v13 被实现成了 stage=2 的判据，但它是**错的**。
+ *   InitPHY() 的每一条出口都是无条件 return 0，所以链路从来没起来时
+ *   SmapIsInitialized 照样是 1、SMAPSendPacket() 照样返回 1，
+ *   g_tx_err 永远是 0。真正的判据只有下面这一组（PHY 的 BMSR bit2）。
+ */
+static volatile int g_tx_err = 0;
+
+/*
+ * 链路状态（v14 新增）—— 唯一可信的"线上到底有没有链路"的判据。
+ *
+ *   g_link_up   : 1 = BMSR.LinkStatus 已置位（链路建立），0 = 没有链路
+ *   g_last_bmsr : 最后一次读到的 BMSR 原值（bit2 = link，bit5 = 自动协商完成）
+ *   g_link_mode : InitPHY() 填的 LinkMode：bit0..3 = 1:10M半 2:10M全
+ *                 4:100M半 8:100M全，bit6 = 流控。链路不通时无意义。
+ */
+static volatile int g_link_up   = 0;
+static volatile unsigned int g_last_bmsr = 0;
+static volatile unsigned int g_link_mode = 0;
+
+static void rx_push(const u8 *frame, int len)
+{
+    int next, state;
+
+    if (len <= NB_UDP_OFF || len > NB_RX_MAX) {
+        g_rx_drop++;
+        return;
+    }
+
+    /* 只保留盒子 -> 40000 的 UDP 帧。
+     * 盒子回包实测：ethertype 0x0800、IP proto 17、UDP 30000 -> 40000。 */
+    if (frame[12] != 0x08 || frame[13] != 0x00) {
+        g_rx_drop++;
+        return;
+    }
+    if (frame[23] != 17) { /* IP proto != UDP */
+        g_rx_drop++;
+        return;
+    }
+    /* 目的端口 == 40000 ? （UDP 头在 14+ihl，盒子回包的 ihl 恒为 5 = 20） */
+    if (frame[NB_ETH_HDR + NB_IP_HDR + 2] != (NB_PORT >> 8) ||
+        frame[NB_ETH_HDR + NB_IP_HDR + 3] != (NB_PORT & 0xFF)) {
+        g_rx_drop++;
+        return;
+    }
+
+    CpuSuspendIntr(&state);
+    next = (rx_head + 1) % NB_RX_SLOTS;
+    if (next != rx_tail) { /* 非满 */
+        memcpy(rx_buf[rx_head], frame, len);
+        rx_len[rx_head] = len;
+        rx_head         = next;
+        g_rx_frames++;
+    } else
+        g_rx_drop++; /* 环形缓冲满了：堆积的帧直接丢，别把中断卡住 */
+    CpuResumeIntr(state);
+}
+
+static void netbox_raw_hook(const unsigned char *frame, int len)
+{
+    g_hook_calls++;
+    rx_push((const u8 *)frame, len);
+}
+
+/* ------------------------------------------------------------------ */
+/* 原始帧发送                                                          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * 发送缓冲与长度：NB_TX_FRAME_LEN（512）在 netbox.h 里定义，理由见那里的注释。
+ * 帧尾在记录流结束之后补零 —— 原厂 loader 那里是未初始化内存，盒子照回不误。
+ */
+static u8  nb_tx[NB_TX_FRAME_LEN];
+static u8  nb_mac[6];
+static u16 nb_ipid = 1;
+
+/* IPv4 头校验和（头内校验和字段需先置 0） */
+static u16 nb_ip_cksum(const u8 *p, int n)
+{
+    u32 s = 0;
+
+    while (n > 1) {
+        s += (u32)(((u16)p[0] << 8) | p[1]);
+        p += 2;
+        n -= 2;
+    }
+    if (n > 0)
+        s += (u32)((u16)p[0] << 8);
+    while (s >> 16)
+        s = (s & 0xFFFF) + (s >> 16);
+
+    return (u16)(~s);
+}
+
+/*
+ * 组一个 ETH + IPv4 + UDP 帧，返回整帧长度（固定 NB_TX_FRAME_LEN）。
+ *
+ * 逐字段对齐原厂 loader 的真实请求帧（2026-09-23 桥接抓包）：
+ *   ETH dst = ff:ff:ff:ff:ff:ff   原厂填的是垃圾 MAC，广播最稳
+ *       src = 本机 SMAP MAC       原厂填全零；填真 MAC 更规范，盒子不看
+ *       type= 0x0800
+ *   IP  0.0.0.0 -> 255.255.255.255, TTL 0xff, proto 17, DF
+ *       total_length = 20 + 8 + paylen    <- 必须是真值
+ *   UDP 30000 -> dport, length = 8 + paylen，校验和 0（原厂也是 0）
+ *
+ * 长度字段必须写真值：原厂请求帧的 IP/UDP 长度是对的（8 扇区读 = 316/296），
+ * 而盒子的应答恰恰把这两个字段写成常数 —— 说明盒子是【按请求里的长度】
+ * 确定记录流长度、并只在应答里回填数据的。所以这里绝不能像盒子那样偷懒。
+ */
+static int nb_build_frame(const u8 *payload, int paylen, u16 dport)
+{
+    u8 *f = nb_tx;
+    int iplen, udplen;
+    u16 c;
+
+    if (paylen < 0 || (NB_UDP_OFF + paylen) > NB_TX_FRAME_LEN)
+        return -1;
+
+    iplen  = NB_IP_HDR + NB_UDP_HDR + paylen;
+    udplen = NB_UDP_HDR + paylen;
+
+    memset(f, 0, NB_TX_FRAME_LEN);
+
+    /* ---- Ethernet ---- */
+    memset(f, 0xFF, 6);                 /* dst: 广播 */
+    memcpy(f + 6, nb_mac, 6);           /* src: 本机 SMAP MAC */
+    f[12] = 0x08;
+    f[13] = 0x00;
+
+    /* ---- IPv4 ---- */
+    f[NB_ETH_HDR + 0] = 0x45;           /* v4, IHL=5 */
+    f[NB_ETH_HDR + 1] = 0x00;
+    f[NB_ETH_HDR + 2] = (u8)(iplen >> 8);
+    f[NB_ETH_HDR + 3] = (u8)(iplen & 0xFF);
+    f[NB_ETH_HDR + 4] = (u8)(nb_ipid >> 8);
+    f[NB_ETH_HDR + 5] = (u8)(nb_ipid & 0xFF);
+    f[NB_ETH_HDR + 6] = 0x40;           /* DF，不分片 */
+    f[NB_ETH_HDR + 7] = 0x00;
+    f[NB_ETH_HDR + 8] = 0xFF;           /* TTL，与原厂一致 */
+    f[NB_ETH_HDR + 9] = 17;             /* proto = UDP */
+    /* 10..11：校验和稍后回填 */
+    /* 12..15：源地址 0.0.0.0（已是 0） */
+    memset(f + NB_ETH_HDR + 16, 0xFF, 4); /* 目的 255.255.255.255 */
+
+    c = nb_ip_cksum(f + NB_ETH_HDR, NB_IP_HDR);
+    f[NB_ETH_HDR + 10] = (u8)(c >> 8);
+    f[NB_ETH_HDR + 11] = (u8)(c & 0xFF);
+
+    /* ---- UDP ---- */
+    f[NB_UDP_OFF - 8] = (u8)(NB_SRC_PORT >> 8);
+    f[NB_UDP_OFF - 7] = (u8)(NB_SRC_PORT & 0xFF);
+    f[NB_UDP_OFF - 6] = (u8)(dport >> 8);
+    f[NB_UDP_OFF - 5] = (u8)(dport & 0xFF);
+    f[NB_UDP_OFF - 4] = (u8)(udplen >> 8);
+    f[NB_UDP_OFF - 3] = (u8)(udplen & 0xFF);
+    /* 校验和保持 0：UDP 校验和可选，原厂请求帧也是 0 */
+
+    memcpy(f + NB_UDP_OFF, payload, paylen);
+
+    nb_ipid++;
+    return NB_TX_FRAME_LEN;
+}
+
+/* 发一个协议请求。返回 SMAPSendPacket 的结果（1 = 成功，-1 = SMAP 未初始化） */
+static int nb_send(const u8 *payload, int len)
+{
+    int r;
+
+    if (nb_build_frame(payload, len, NB_PORT) < 0)
+        return -1;
+
+    r = SMAPSendPacket(nb_tx, NB_TX_FRAME_LEN);
+    if (r < 0)
+        g_tx_err++; /* -1 = SmapIsInitialized==0：PHY/链路没起来，见上面的注释 */
+
+    return r;
+}
+
+/*
+ * 诊断通道：把一行纯文本以 UDP 40001 的裸帧广播出去。
+ *
+ * 为什么需要它：release 版 OPL 里 IOP 的 printf 没有输出目标（无 ps2link），
+ * 驱动在 IOP 里跑，成功失败全靠猜。有了这个通道，PC 只要和 PS2 同链路抓包
+ * （tools/netbox_diag_sniff.py），就能看到驱动走到哪一步。
+ * 端口与协议端口 40000 分开，不干扰。
+ */
+static void nb_diag(const char *msg)
+{
+    char buf[192];
+    int len;
+
+    len = sprintf(buf, "[NETBOX] %s\n", msg);
+    if (len <= 0 || len >= (int)sizeof(buf))
+        return;
+
+    if (nb_build_frame((const u8 *)buf, len, NB_DIAG_PORT) > 0)
+        SMAPSendPacket(nb_tx, NB_TX_FRAME_LEN);
+}
+
+/* ------------------------------------------------------------------ */
+/* v13/v14：把"失败在哪一步"编码进 _start() 的返回值，直接显示在设置页上   */
+/*                                                                     */
+/* v12 的问题是：只要代码跑到最后就返回 MODULE_RESIDENT_END(0)，设置页   */
+/* 显示 "resident"，可读盘可能早就失败了 —— 下面这些完全不同的故障在屏幕 */
+/* 上长得一模一样：                                                     */
+/*   - PHY/链路没起来，帧根本出不去                                      */
+/*   - 发得出去但盒子没回（网线接反、盒子没上电、盒子不在这个网段）      */
+/*   - 收到帧了但被 rx_push 的 ethertype/端口过滤挡掉                    */
+/*   - 收到帧了、事务号/数据偏移却对不上                                 */
+/*   - 数据拿到了但内容错位                                              */
+/*                                                                     */
+/* v13 改成：任何"注册 BD 设备之前"的失败都【不驻留】，并把失败位置编码。 */
+/* v14 又补了两关（钩子自检、链路自检），并把链路状态一起编进去：        */
+/*                                                                     */
+/*     _start() 返回值 = 1000000 + stage*10000 + link*5000 + hook计数   */
+/*                                                                     */
+/*   link = 1 表示"失败那一刻 PHY 登记到的链路是通的"                    */
+/*   设置页解码成  "NetBox: FAIL stage=5 hook=0 link ok (v14)"           */
+/*                                                                     */
+/* stage 含义（v14 重新编号 —— v13 的 1/2 是假阳性，已合并重排；        */
+/* 编号顺序 = 实际检查顺序）：                                           */
+/*   1 = 钩子自检失败      -> netboxh 的导入被改写成空桩，收包路径是死的  */
+/*   2 = PHY 没有链路      -> 网线/对端/PHY 问题，先修物理层 ★最常见★     */
+/*   3 = MAC 全零          -> smap_init() 没跑完（EMAC3 地址寄存器没写）  */
+/*   4 = 一帧都发不出去    -> SmapIsInitialized==0                        */
+/*   5 = 发得出去但收不到任何回包 -> link 已在第 2 关确认过               */
+/*   6 = 收到回包但 IDENTIFY 没匹配上 -> 事务号或应答偏移不符             */
+/*   7 = 读 LBA0 失败      -> 扇区数据没拿到                             */
+/*   8 = LBA0 读到了但无 55AA 签名 -> 数据错位                           */
+/* 返回 0 且设置页显示 resident = 自检全过（含真读 LBA0），BD 设备已注册  */
+/* ------------------------------------------------------------------ */
+
+#define NB_STAGE_HOOK     1
+#define NB_STAGE_LINK     2
+#define NB_STAGE_MAC      3
+#define NB_STAGE_TX       4
+#define NB_STAGE_NO_REPLY 5
+#define NB_STAGE_IDENTIFY 6
+#define NB_STAGE_READ0    7
+#define NB_STAGE_BOOTSIG  8
+
+/* 返回值编码的基址：减去它就得到 stage/link/hook。见上方说明。 */
+#define NB_FAIL_BASE      1000000
+
+/*
+ * 返回失败码给 IOP 装载器（= MODULE_NO_RESIDENT_END，模块随后被卸载）。
+ * 【钩子必须先摘掉】：钩子函数体在本模块里，模块一卸载，
+ * smap-ingame 之后每收一帧就会跳进已释放的代码 -> 必崩。
+ * smap-ingame 的 SmapPassRawFrame() 有 NULL 判断，摘掉就是干净的。
+ */
+static int nb_fail(int stage)
+{
+    char msg[160];
+    int  hooks = g_hook_calls;
+    int  link  = g_link_up ? 1 : 0;
+
+    if (hooks > 4999) /* 编码里 hook 占 0..4999，link 占 5000 那一档 */
+        hooks = 4999;
+
+    /* 摘钩子：函数体在本模块里，模块卸载后 smap 每收一帧跳进来必崩。
+     * smap-ingame 的 SmapPassRawFrame() 有 NULL 判断，摘掉就是干净的。 */
+    smap_set_rx_hook(NULL);
+
+    sprintf(msg, "FAIL stage=%d link=%d bmsr=0x%04x hook=%d rx=%d drop=%d txerr=%d -> not resident",
+            stage, link, (unsigned int)g_last_bmsr & 0xFFFF, hooks,
+            g_rx_frames, g_rx_drop, g_tx_err);
+    nb_diag(msg);
+
+    printf("netbox: FAIL stage=%d link=%d hook=%d txerr=%d (not resident)\n",
+           stage, link, hooks, g_tx_err);
+
+    /* 编码见上方注释：1000000 + stage*10000 + link*5000 + hook */
+    return NB_FAIL_BASE + stage * 10000 + link * 5000 + hooks;
+}
+
+/*
+ * v14：读 PHY 的真实链路状态，最多等 3 秒。
+ *
+ * 为什么不能直接用"发送成功"当判据 —— 见上方 g_tx_err 处的长注释：
+ * InitPHY() 无条件 return 0，所以没有链路时 SmapIsInitialized 也是 1、
+ * SMAPSendPacket() 也返回 1。只有 PHY 的 BMSR bit2 是可信的。
+ *
+ * 为什么要等：SMAPStart() 在我们加载之前就跑完了（smap_init -> SMAPStart
+ * 里的自动协商可能要好几秒），正常情况下这里一次就读到；但插拔线、
+ * 对端刚上电这类情形下链路可能还在协商中，给 3 秒余量免得误报。
+ */
+static int nb_wait_link(void)
+{
+    unsigned int bmsr = 0, anlpar = 0, linkmode = 0;
+    int i;
+
+    for (i = 0; i < 30; i++) { /* 30 x 100ms = 3s */
+        if (smap_get_link_status(&bmsr, &anlpar, &linkmode) == 1) {
+            g_link_up   = 1;
+            g_last_bmsr = bmsr;
+            g_link_mode = linkmode;
+            return 1;
+        }
+        g_last_bmsr = bmsr;
+        DelayThread(100 * 1000);
+    }
+
+    g_link_up = 0;
+    return 0;
+}
+
+/*
+ * v13：确认 SMAP 真的能发帧。
+ *
+ * SMAPSendPacket() 在 SmapIsInitialized==0 时返回 -1 且什么都不发。这个状态
+ * 只由 SMAPStart() 里 PHY up 之后置位，而 SMAPStart() 的返回值在
+ * smap-ingame 的 SMapIFInit() 里被丢掉了 —— 所以这里自己探一遍。
+ *
+ * 探针帧就是握手的第一条记录（R:FF00），不是垃圾数据：即使盒子收到它，
+ * 也只是正常握手序列的第一步。
+ *
+ * 【为什么不在这里调 SMAPStart() 重试】链路真的不通时 InitPHY() 会在
+ * 自动协商里长时间阻塞（甚至 goto 重来），在菜单初始化路径上反复调用
+ * 会把 OPL 卡死。所以这里只观察、只报告。
+ */
+static int nb_probe_tx(void)
+{
+    static const u8 probe[] = { NB_SYNC0, NB_SYNC1, NB_T_CMD, NB_C_R, 0xFF, 0x00 };
+    int i;
+
+    for (i = 0; i < 20; i++) { /* 20 x 100ms = 2s */
+        if (nb_send(probe, (int)sizeof(probe)) == 1)
+            return 1;
+        DelayThread(100 * 1000);
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* 请求构造                                                            */
+/* ------------------------------------------------------------------ */
+
+static void put_rec(u8 *b, int *off, u8 type, u8 cmd, u16 param)
+{
+    b[(*off)++] = NB_SYNC0;
+    b[(*off)++] = NB_SYNC1;
+    b[(*off)++] = type;
+    b[(*off)++] = cmd;
+    b[(*off)++] = (u8)(param >> 8);
+    b[(*off)++] = (u8)(param & 0xFF);
+}
+
+/* 注意：put_rec 的第二参数是 int*（要回填偏移），所以宏里必须取地址 &off。
+ * 只应在声明了 (u8 *b, int off) 的函数体内使用。 */
+#define W(reg, val) put_rec(b, &off, NB_T_CMD, NB_C_W, (u16)(((reg) << 8) | ((val) & 0xFF)))
+#define R(reg)      put_rec(b, &off, NB_T_CMD, NB_C_R, (u16)(((reg) << 8)))
+
+/*
+ * 构造一个读请求。布局与抓包完全一致（已用两条真实抓包逐字节验证过）：
+ *   P | R:0f00 | B:8000 | W:0e40 | 高32位LBA(0b,0c,0d) + count高(0a)
+ *     | 低32位LBA(0b,0c,0d) + count低(0a) | W:0f24 | R:0f00 | R:f200 | F:txn
+ *     | count × (B:8000 B:0808 L:01ff F:txn+k)
+ */
+static int nb_build_read(u8 *b, int max, u64 lba, u16 count, u16 txn, u8 ata_cmd)
+{
+    int off = 0, p_off, i;
+
+    if (count == 0 || count > NB_MAX_SECTORS)
+        return -1;
+    if (max < (int)(NB_P_PARAM(count) + NB_REC_SIZE))
+        return -1;
+
+    p_off = off;
+    put_rec(b, &off, NB_T_CMD, NB_C_P, 0); /* 占位，最后回填 */
+
+    R(NB_REG_CMD);                         /* 读状态寄存器 */
+    put_rec(b, &off, NB_T_CMD, NB_C_B, 0x8000);
+    W(NB_REG_DEV, NB_DEV_LBA_MASTER);
+
+    /* 先写高 32 位（对应 ATA 48-bit 的第一次写入） */
+    W(NB_REG_LBA0, (u8)((lba >> 24) & 0xFF));
+    W(NB_REG_LBA1, (u8)((lba >> 32) & 0xFF));
+    W(NB_REG_LBA2, (u8)((lba >> 40) & 0xFF));
+    W(NB_REG_COUNT, (u8)((count >> 8) & 0xFF));
+
+    /* 再写低 32 位 */
+    W(NB_REG_LBA0, (u8)((lba >> 0) & 0xFF));
+    W(NB_REG_LBA1, (u8)((lba >> 8) & 0xFF));
+    W(NB_REG_LBA2, (u8)((lba >> 16) & 0xFF));
+    W(NB_REG_COUNT, (u8)((count >> 0) & 0xFF));
+
+    W(NB_REG_CMD, ata_cmd);                /* 0x24 READ SECTORS EXT / 0xEC IDENTIFY */
+
+    R(NB_REG_CMD);
+    R(NB_REG_ALT);
+    put_rec(b, &off, NB_T_CMD, NB_C_F, txn); /* 提交 */
+
+    /* count 个轮询块，每个块拿到一个扇区 */
+    for (i = 1; i <= count; i++) {
+        put_rec(b, &off, NB_T_CMD, NB_C_B, 0x8000);
+        put_rec(b, &off, NB_T_CMD, NB_C_B, 0x0808);
+        put_rec(b, &off, NB_T_CMD, NB_C_L, 0x01FF);
+        put_rec(b, &off, NB_T_CMD, NB_C_F, (u16)(txn + i));
+    }
+
+    /* 回填 P: 本记录之后的字节数 */
+    b[p_off + 4] = (u8)((off - NB_REC_SIZE) >> 8);
+    b[p_off + 5] = (u8)((off - NB_REC_SIZE) & 0xFF);
+
+    return off;
+}
+
+#undef W
+#undef R
+
+static u16 g_txn = 1;
+
+/* ------------------------------------------------------------------ */
+/* 通用构造器 + 开机握手序列                                            */
+/* ------------------------------------------------------------------ */
+
+typedef struct {
+    u8  type;
+    u8  cmd;
+    u16 param;
+} nb_rec_t;
+
+/* 构造 P + recs[0..n-1] + F:txn，P 的 param 自动回填 */
+static int nb_build_generic(u8 *b, int max, const nb_rec_t *recs, int n, u16 txn)
+{
+    int off = 0, p_off, i;
+
+    if (max < (int)((n + 2) * NB_REC_SIZE))
+        return -1;
+
+    p_off = off;
+    put_rec(b, &off, NB_T_CMD, NB_C_P, 0);
+    for (i = 0; i < n; i++)
+        put_rec(b, &off, recs[i].type, recs[i].cmd, recs[i].param);
+    put_rec(b, &off, NB_T_CMD, NB_C_F, txn);
+
+    b[p_off + 4] = (u8)((off - NB_REC_SIZE) >> 8);
+    b[p_off + 5] = (u8)((off - NB_REC_SIZE) & 0xFF);
+    return off;
+}
+
+#define NB_T NB_T_CMD
+/*
+ * PS2 开机握手序列 —— 2026-09-23 实机开机抓包逐帧还原。
+ * PS2 上电后 42ms 内连续发完这 7 帧，然后才发 IDENTIFY 和第一个读扇区。
+ * 事务号从 0x011c 起连续递增，每帧 1 个。
+ */
+static const nb_rec_t NB_HS0[] = {                                       /* P:001e */
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xFF00},
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xFF00},
+};
+static const nb_rec_t NB_HS1[] = {                                       /* P:0018 */
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xF000}, {NB_T, NB_C_R, 0xF100},
+};
+static const nb_rec_t NB_HS2[] = {{NB_T, NB_C_W, 0xFD01}};               /* 启用 */
+static const nb_rec_t NB_HS3[] = {{NB_T, NB_C_W, 0x1604}};               /* 复位拉高 */
+static const nb_rec_t NB_HS4[] = {{NB_T, NB_C_W, 0x1600}};               /* 复位拉低 */
+/* 注意：读 device 寄存器时 param 是 0x0E40（带 LBA+master 位），不是 0x0E00 */
+static const nb_rec_t NB_HS5[] = {{NB_T, NB_C_R, 0x0E40}, {NB_T, NB_C_R, 0x0F00}};
+static const nb_rec_t NB_HS6[] = {{NB_T, NB_C_R, 0x0E40}, {NB_T, NB_C_R, 0x0F00}};
+
+/* IDENTIFY DEVICE 请求（注意：结构与读扇区不同，没有 LBA 写入）        P:0036 */
+static const nb_rec_t NB_IDENTIFY[] = {
+    {NB_T, NB_C_W, 0x0E40}, {NB_T, NB_C_B, 0x8000},
+    {NB_T, NB_C_W, 0x0FEC}, {NB_T, NB_C_R, 0x0F00},
+    {NB_T, NB_C_B, 0x8000}, {NB_T, NB_C_B, 0x0808},
+    {NB_T, NB_C_R, 0x0F00}, {NB_T, NB_C_L, 0x01FF},
+};
+#undef NB_T
+
+static int nb_send_recs(const nb_rec_t *recs, int n)
+{
+    static u8 req[512];
+    int len = nb_build_generic(req, sizeof(req), recs, n, g_txn);
+
+    if (len < 0)
+        return -1;
+    g_txn = (u16)(g_txn + 1);
+    return nb_send(req, len);
+}
+
+/* 开机握手：必须在第一次读扇区之前调用 */
+static void nb_handshake(void)
+{
+    static const struct {
+        const nb_rec_t *r;
+        int             n;
+    } seq[] = {
+        {NB_HS0, 4}, {NB_HS1, 3}, {NB_HS2, 1},
+        {NB_HS3, 1}, {NB_HS4, 1}, {NB_HS5, 2}, {NB_HS6, 2},
+    };
+    int i;
+
+    for (i = 0; i < (int)(sizeof(seq) / sizeof(seq[0])); i++) {
+        nb_send_recs(seq[i].r, seq[i].n);
+        DelayThread(5 * 1000); /* 5ms；实机握手帧间隔 3~13ms */
+    }
+}
+
+/*
+ * 从环形缓冲取一帧，解析出 (事务号, 扇区数据指针)。
+ * 返回 1=数据帧  0=状态帧/无关帧  -1=无帧
+ *
+ * 关键：应答帧开头的填充记录条数不固定
+ *   （读扇区 = 3 条、数据偏移 18；IDENTIFY = 9 条、偏移 54；状态帧更多），
+ * 必须动态扫描跳过，不能硬编码偏移 18。
+ * 帧类型用【以太网帧长】判定最稳：640 = 数据帧，256 = 状态帧。
+ * v12 起帧长是真实值（钩子拿到的就是线上长度），判定比以前更可靠。
+ */
+static int nb_poll_frame(u16 *txn_out, const u8 **data_out)
+{
+    int state, idx, len, paylen, off = 0, fillcnt = 0;
+    const u8 *pl;
+
+    CpuSuspendIntr(&state);
+    if (rx_tail == rx_head) {
+        CpuResumeIntr(state);
+        return -1;
+    }
+    idx = rx_tail;
+    len = rx_len[idx];
+    CpuResumeIntr(state);
+
+    pl     = rx_buf[idx] + NB_UDP_OFF;
+    paylen = len - NB_UDP_OFF;
+
+    /* 1) 跳过前导填充记录：55 aa 4a 00 xx */
+    while (fillcnt < NB_RSP_FILL_MAX && off + NB_REC_SIZE <= paylen &&
+           pl[off] == NB_SYNC0 && pl[off + 1] == NB_SYNC1 &&
+           pl[off + 2] == NB_T_RSP && pl[off + 3] == 0x00) {
+        off += NB_REC_SIZE;
+        fillcnt++;
+    }
+
+    *data_out = NULL;
+    *txn_out  = 0xFFFF;
+
+    /* 2) 数据帧（640 字节以太网帧）：数据紧跟填充，之后是 F 记录 */
+    if (len >= NB_RSP_FRAME_LEN && off + NB_DATA_SIZE + NB_REC_SIZE <= paylen) {
+        const u8 *f = pl + off + NB_DATA_SIZE;
+        if (f[0] == NB_SYNC0 && f[1] == NB_SYNC1 && f[NB_F_CMD_OFF] == NB_C_F) {
+            *txn_out  = (u16)((f[NB_F_PARAM_OFF] << 8) | f[NB_F_PARAM_OFF + 1]);
+            *data_out = pl + off;
+        }
+    }
+
+    /* 3) 状态帧 / 未识别：线性扫描找 F 记录取事务号 */
+    if (*data_out == NULL) {
+        int i;
+        for (i = 0; i + NB_REC_SIZE <= paylen; i += NB_REC_SIZE) {
+            if (pl[i] == NB_SYNC0 && pl[i + 1] == NB_SYNC1 && pl[i + NB_F_CMD_OFF] == NB_C_F)
+                *txn_out = (u16)((pl[i + NB_F_PARAM_OFF] << 8) | pl[i + NB_F_PARAM_OFF + 1]);
+        }
+    }
+
+    CpuSuspendIntr(&state);
+    rx_tail = (rx_tail + 1) % NB_RX_SLOTS;
+    CpuResumeIntr(state);
+
+    return (*data_out != NULL) ? 1 : 0;
+}
+
+/*
+ * 执行一次读事务。
+ * 返回实际读到的扇区数（应等于 count），失败返回 < 0。
+ */
+static int nb_transaction(u64 lba, u16 count, u8 *buffer, u8 ata_cmd)
+{
+    static u8 req[1536];
+    u16 txn;
+    int len, got = 0, tries, deadline;
+    u32 bitmap = 0;
+
+    if (count > NB_MAX_SECTORS)
+        return -1;
+
+    WaitSema(io_sema);
+
+    txn = g_txn;
+    g_txn = (u16)(g_txn + count + 1); /* 每事务消耗 count+1 个事务号 */
+
+    len = nb_build_read(req, sizeof(req), lba, count, txn, ata_cmd);
+    if (len < 0) {
+        SignalSema(io_sema);
+        return -1;
+    }
+
+    for (tries = 0; tries < 3; tries++) {
+        if (nb_send(req, len) < 0) {
+            SignalSema(io_sema);
+            return -2;
+        }
+
+        deadline = 400; /* ~400 次 * 1ms */
+        while (deadline-- > 0 && got < count) {
+            u16 t;
+            const u8 *data;
+            int r = nb_poll_frame(&t, &data);
+
+            if (r < 0) {
+                DelayThread(1000); /* 1ms */
+                continue;
+            }
+            if (r == 1 && t > txn && t <= (u16)(txn + count)) {
+                int idx = t - txn - 1;
+                if (!(bitmap & (1u << idx))) {
+                    memcpy(buffer + (idx * NB_DATA_SIZE), data, NB_DATA_SIZE);
+                    bitmap |= (1u << idx);
+                    got++;
+                }
+            }
+        }
+        if (got >= count)
+            break;
+        got = 0;
+        bitmap = 0;
+    }
+
+    SignalSema(io_sema);
+    return (got >= count) ? (int)count : -3;
+}
+
+/* ------------------------------------------------------------------ */
+/* IDENTIFY：取容量                                                    */
+/* ------------------------------------------------------------------ */
+
+static u64 nb_identify_sectors(void)
+{
+    static u8 req[512];
+    u8  id[512];
+    u64 cap = 0;
+    u16 txn;
+    int len, got = 0, tries, deadline;
+
+    memset(id, 0, sizeof(id));
+
+    /*
+     * 注意：IDENTIFY 请求的结构与读扇区不同（无 LBA 写入），
+     * 且应答的前导填充是 9 条（数据偏移 54），不是读扇区的 3 条。
+     */
+    WaitSema(io_sema);
+    txn   = g_txn;
+    g_txn = (u16)(g_txn + 1);
+
+    len = nb_build_generic(req, sizeof(req), NB_IDENTIFY,
+                           (int)(sizeof(NB_IDENTIFY) / sizeof(NB_IDENTIFY[0])), txn);
+    if (len < 0) {
+        SignalSema(io_sema);
+        return 0;
+    }
+
+    for (tries = 0; tries < 3 && !got; tries++) {
+        if (nb_send(req, len) < 0)
+            break;
+        deadline = 500; /* ~500ms */
+        while (deadline-- > 0) {
+            u16        t;
+            const u8  *data;
+            int        r = nb_poll_frame(&t, &data);
+
+            if (r < 0) {
+                DelayThread(1000); /* 1ms */
+                continue;
+            }
+            if (r == 1 && t == txn) {
+                memcpy(id, data, NB_DATA_SIZE);
+                got = 1;
+                break;
+            }
+        }
+    }
+    SignalSema(io_sema);
+
+    if (!got) {
+        printf("netbox: IDENTIFY 失败，使用默认容量\n");
+        return 0;
+    }
+
+    /* LBA48 容量: word 100..103（小端，注意 ATA 的字节序） */
+    cap = (u64)(id[200] | (id[201] << 8)) |
+          ((u64)(id[202] | (id[203] << 8)) << 16) |
+          ((u64)(id[204] | (id[205] << 8)) << 32) |
+          ((u64)(id[206] | (id[207] << 8)) << 48);
+
+    if (cap == 0 || cap > 0x1000000000000ULL) {
+        /* 退回 LBA28: word 60..61 */
+        cap = (u64)(id[120] | (id[121] << 8)) | ((u64)(id[122] | (id[123] << 8)) << 16);
+    }
+    return cap;
+}
+
+/* ------------------------------------------------------------------ */
+/* struct block_device 回调                                            */
+/* ------------------------------------------------------------------ */
+
+static int netbox_read(struct block_device *bd, u64 sector, void *buffer, u16 count)
+{
+    u8 *p = (u8 *)buffer;
+    u16 remaining = count;
+    static int nreads = 0;
+    static int nfails = 0;
+    (void)bd;
+
+    /* 能进这里说明 OPL 已经在尝试挂载并读盘了 */
+    if (nreads == 0) {
+        char msg[80];
+        sprintf(msg, "first read lba=%u count=%d", (unsigned int)sector, (int)count);
+        nb_diag(msg);
+    }
+    nreads++;
+
+    while (remaining > 0) {
+        u16 n = (remaining > NB_MAX_SECTORS) ? NB_MAX_SECTORS : remaining;
+        int r = nb_transaction(sector, n, p, NB_ATA_READ_EXT);
+        if (r != (int)n) {
+            /* 只报前 3 次避免刷屏；带上计数器区分"根本没收到帧"和"帧不对" */
+            if (nfails < 3) {
+                char msg[112];
+                sprintf(msg, "read FAIL lba=%u n=%d ret=%d hook=%d rx=%d drop=%d",
+                        (unsigned int)sector, (int)n, r, g_hook_calls, g_rx_frames, g_rx_drop);
+                nb_diag(msg);
+            }
+            nfails++;
+            return -1;
+        }
+        sector += n;
+        p += (u32)n * NB_DATA_SIZE;
+        remaining = (u16)(remaining - n);
+    }
+    if (nreads == 1)
+        nb_diag("first read OK");
+    return count;
+}
+
+static int netbox_write(struct block_device *bd, u64 sector, const void *buffer, u16 count)
+{
+    /* 写路径从未抓到样本（真实客户端只读）。为安全起见不猜。 */
+    (void)bd; (void)sector; (void)buffer; (void)count;
+    return -1;
+}
+
+static void netbox_flush(struct block_device *bd) { (void)bd; }
+static int  netbox_stop(struct block_device *bd)  { (void)bd; return 0; }
+
+/* 用"指定初始化"而不是按位置初始化，两个原因：
+ *  1) ps2sdk 新版的 bdm.h 给 struct block_device 加了 path 字段，旧版没有；
+ *     指定初始化对两种版本都能编译（不给 path 赋值 = 保持 NULL）。
+ *  2) path 必须留 NULL。OPL 是按 "mass%d:" 前缀枚举 BDM 设备的
+ *     （见 src/bdmsupport.c 的 bdmUpdateDeviceData / bdmFindPartition），
+ *     一旦给 path 赋了前缀，设备会注册到别的 iomanX 前缀下，OPL 反而找不到它。
+ */
+static struct block_device g_netbox_bd = {
+    .priv         = NULL,
+    .name         = "netbox",
+    .devNr        = 0,
+    .parNr        = 0,
+    .parId        = 0,
+    .sectorSize   = 512,
+    .sectorOffset = 0,
+    .sectorCount  = 0, /* 运行时由 IDENTIFY 填入 */
+    .read         = netbox_read,
+    .write        = netbox_write,
+    .flush        = netbox_flush,
+    .stop         = netbox_stop,
+};
+
+/* ------------------------------------------------------------------ */
+/* 模块入口                                                            */
+/* ------------------------------------------------------------------ */
+
+int _start(int argc, char *argv[])
+{
+    iop_sema_t sema;
+    static u8 sec0[NB_DATA_SIZE]; /* LBA0 自检缓冲；static 免得吃 IOP 线程栈 */
+    u64 sectors = 0; /* 必须初始化：下面的重试循环拿它当条件 */
+    int mac_ok, try, r;
+    (void)argc; (void)argv;
+
+    printf("netbox_bd: PS2 NetBox (NBD/ATA-over-UDP) BDM driver v1.4 (raw SMAP + link/hook selftest)\n");
+
+    sema.initial = 1;
+    sema.max     = 1;
+    sema.option  = 0;
+    sema.attr    = 0;
+    io_sema      = CreateSema(&sema);
+
+    /*
+     * 1) 注册原始帧钩子 + 【自检】。
+     *
+     * 钩子必须在任何读操作之前装上：握手和 IDENTIFY 的应答全靠它进来，
+     * 它在 ps2ip_input() 之前被调用，拿到的是刚 DMA 出来的完整帧。
+     *
+     * 为什么要回读自检（v14 新增）：IOP 装载器在找不到某个导入的库时，
+     * 会把那个导入桩改写成空桩（ps2sdk loadcore.c 的 cleanStub，改成
+     * "jr $ra"）。空桩【不报错、不影响模块装载】，只是静默什么都不做。
+     * 如果 netboxh 库在运行时不存在，smap_set_rx_hook() 就是这样——
+     * 钩子根本没装上，hook 计数永远是 0，和"盒子没回包"完全无法区分。
+     * 回读一次并和刚传进去的地址比对，就能把这两种情况彻底分开。
+     */
+    smap_set_rx_hook((void *)netbox_raw_hook);
+    if (smap_get_rx_hook() != (void *)netbox_raw_hook) {
+        printf("netbox: rx hook self-check FAILED -> netboxh import is a no-op stub\n");
+        return nb_fail(NB_STAGE_HOOK);
+    }
+
+    /*
+     * 2) 链路自检（v14 新增，★这一关是 v13 缺的关键判据★）。
+     *
+     * 实机上报回 "stage=3 hook=0"（发送自检通过、但一个回包都没收到）之后
+     * 去读 smap-ingame 的 SMAPStart()，发现 v13 的发送判据是假阳性：
+     *
+     *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+     *     if (result == 0 && !NetDevStopFlag) { ...; SmapIsInitialized = 1; }
+     *
+     * 而 InitPHY() 的每一条出口都是【无条件 return 0】（smap.c 末尾），
+     * 内部所有"等链路"的循环超时后也只是把 LinkStatus 置 0 继续往下。
+     * ⇒ 链路从来没起来时，SmapIsInitialized 也是 1、SMAPSendPacket() 也
+     *   返回 1 —— "发得出去"根本不能证明链路上有线。
+     *
+     * PHY 的 BMSR bit2 是唯一可信的判据，所以这一关单独判、单独报。
+     * 链路不通时静默发帧 = 盒子永远收不到请求 = 硬盘一动不动 + 菜单空白，
+     * 而驱动照样一路跑到 resident（v12 的整个玄学都在这里）。
+     */
+    if (!nb_wait_link()) {
+        char msg[96];
+        sprintf(msg, "PHY link DOWN (bmsr=0x%04x) -> 帧发不出去, 先查网线/对端",
+                (unsigned int)g_last_bmsr & 0xFFFF);
+        nb_diag(msg);
+        printf("netbox: PHY link DOWN (BMSR=0x%04x)\n", (unsigned int)g_last_bmsr & 0xFFFF);
+        return nb_fail(NB_STAGE_LINK);
+    }
+
+    /*
+     * 3) 取本机 SMAP MAC（用来填自发帧的源 MAC，盒子并不看）。
+     *    判据是"值"不是"返回值"：SMAPGetMACAddress() 自己恒返回 0。
+     *    这三对寄存器由 smap_init() 从 DEV9 EEPROM 读出后写进 EMAC3，
+     *    全零就说明 smap_init() 没跑完 —— 那后面所有寄存器操作都没意义。
+     */
+    memset(nb_mac, 0, sizeof(nb_mac));
+    mac_ok = (SMAPGetMACAddress(nb_mac) == 0);
+    if (!mac_ok || (nb_mac[0] | nb_mac[1] | nb_mac[2] | nb_mac[3] | nb_mac[4] | nb_mac[5]) == 0) {
+        printf("netbox: MAC unusable -> smap_init() did not complete\n");
+        return nb_fail(NB_STAGE_MAC);
+    }
+
+    {
+        char msg[128];
+        sprintf(msg, "hooked ok, link up (bmsr=0x%04x mode=0x%02x), mac=%02x:%02x:%02x:%02x:%02x:%02x",
+                (unsigned int)g_last_bmsr & 0xFFFF, (unsigned int)g_link_mode & 0xFF,
+                nb_mac[0], nb_mac[1], nb_mac[2], nb_mac[3], nb_mac[4], nb_mac[5]);
+        nb_diag(msg);
+    }
+
+    /* 4) 确认真的发得出去。SMAPSendPacket() 在 SmapIsInitialized==0 时
+     *    【静默】返回 -1 且一个字节都不发。走到这里链路已经确认是通的，
+     *    所以这一关失败就只剩"smap-ingame 没真正初始化"一种解释。 */
+    if (!nb_probe_tx()) {
+        printf("netbox: SMAPSendPacket() always -1 -> SmapIsInitialized==0\n");
+        return nb_fail(NB_STAGE_TX);
+    }
+    nb_diag("SMAP tx ready");
+
+    /*
+     * 5) 开机握手（激活盒子）+ 探容量。
+     *    盒子可能刚上电还没就绪，或者内置盘在休眠（IDENTIFY 会顺带唤醒它，
+     *    机械盘转起来要好几秒），所以重试窗口比 v12 放宽：6 轮 x 100ms，
+     *    每轮里 IDENTIFY 自己还有 3 次 x 500ms。
+     */
+    for (try = 0; try < 6 && sectors == 0; try++) {
+        char msg[64];
+
+        sprintf(msg, "handshake round %d (hook=%d)", try + 1, g_hook_calls);
+        nb_diag(msg);
+
+        nb_handshake();
+        DelayThread(100 * 1000); /* 100ms，等盒子应答 */
+        sectors = nb_identify_sectors();
+    }
+
+    /* 失败要分清"根本没收到帧"和"收到帧了但对不上"：前者看 hook 计数，
+     * 后者说明协议层（事务号/数据偏移）有问题。v12 这两种都一样是沉默。 */
+    if (sectors == 0)
+        return nb_fail(g_hook_calls == 0 ? NB_STAGE_NO_REPLY : NB_STAGE_IDENTIFY);
+
+    {
+        char msg[80];
+        /* 1 GB = 2097152 个 512 字节扇区，所以 GB 就是 sectors >> 21。
+         * （v11 写的是 (sectors>>11)/1024，数值对但单位标成 MB 了。）
+         * 容量只影响上报大小、不影响读盘正确性，所以不合理也不再兜底，
+         * 只如实打到诊断通道上。 */
+        sprintf(msg, "IDENTIFY ok: %u sectors (%u GB)",
+                (unsigned int)(sectors & 0xFFFFFFFF),
+                (unsigned int)(sectors >> 21));
+        nb_diag(msg);
+    }
+
+    /*
+     * 7) 自检：真读一次 LBA0。
+     *    这一步和 fatfs 挂载时做的第一件事【完全一样】（先读引导扇区），
+     *    所以它过了，就说明 mass0: 基本一定能挂上、设备图标一定会出现。
+     *    它不过，就没必要注册 BD 设备 —— 反正 OPL 那边的
+     *    fileXioDopen("mass0:/") 也会失败、图标也不会出现。宁可让设置页
+     *    明确报出死在哪一段，也不要再出现"resident 但什么都没有"。
+     */
+    r = -1;
+    for (try = 0; try < 3; try++) {
+        r = nb_transaction(0, 1, sec0, NB_ATA_READ_EXT);
+        if (r == 1)
+            break;
+        nb_diag("read LBA0 failed, retrying");
+        DelayThread(300 * 1000); /* 300ms：给休眠中的盘一点时间 */
+    }
+    if (r != 1) {
+        printf("netbox: selftest read LBA0 failed (ret=%d)\n", r);
+        return nb_fail(NB_STAGE_READ0);
+    }
+
+    /* 引导扇区的最后两个字节必须是 55 AA（MBR / exFAT / FAT 都遵守）。
+     * 读得到但这两个字节不对 => 数据错位。这比"读不到"更需要单独报出来，
+     * 因为它意味着协议通了、但偏移或扇区对齐算错了。 */
+    if (sec0[510] != 0x55 || sec0[511] != 0xAA) {
+        char msg[96];
+        sprintf(msg, "LBA0 read ok but no 55AA signature (tail=%02x %02x)",
+                sec0[510], sec0[511]);
+        nb_diag(msg);
+        return nb_fail(NB_STAGE_BOOTSIG);
+    }
+
+    /* 8) 全通了才注册 BD 设备 */
+    g_netbox_bd.sectorCount = sectors;
+
+    {
+        char msg[144];
+        sprintf(msg, "selftest passed (%u sectors) link up (bmsr=0x%04x) hook=%d rx=%d drop=%d -> resident",
+                (unsigned int)(sectors & 0xFFFFFFFF), (unsigned int)g_last_bmsr & 0xFFFF,
+                g_hook_calls, g_rx_frames, g_rx_drop);
+        nb_diag(msg);
+    }
+
+    printf("netbox: selftest ok, %u sectors (%u GB), link up, hook=%d\n",
+           (unsigned int)(sectors & 0xFFFFFFFF),
+           (unsigned int)(sectors >> 21), g_hook_calls);
+
+    bdm_connect_bd(&g_netbox_bd);
+    nb_diag("bdm_connect_bd() done -> resident");
+
+    return MODULE_RESIDENT_END;
+}
diff --git a/modules/netbox/netbox_imports.h b/modules/netbox/netbox_imports.h
new file mode 100644
index 0000000..3bcf405
--- /dev/null
+++ b/modules/netbox/netbox_imports.h
@@ -0,0 +1,71 @@
+/*
+ * netbox_imports.h - PS2 NetBox 驱动对外的全部导入声明
+ *
+ * ★ v12（2026-09-24）重大改动：netbox.irx 不再导入 ps2ip ★
+ *
+ * 之前（v11 及更早）netbox.irx 用 lwIP 的 UDP socket 收发。这条路在实机上
+ * 永远读不出扇区，原因有两条，且两条都是硬的：
+ *
+ *   1) 盒子把应答【广播】到 255.255.255.255（2026-09-23 原厂 loader 抓包：
+ *      dst MAC = ff:ff:ff:ff:ff:ff、IP dst = 255.255.255.255），
+ *      发给特定 IP 的 socket 在 lwIP 里不一定收得到；
+ *   2) 更致命：盒子的 IP 头 total_length 恒为 124、UDP length 恒为 104，
+ *      而以太网帧实际 640 字节。lwIP 的 ip_input() 里
+ *      pbuf_realloc(p, ntohs(IPH_TOTLEN)) 把 pbuf 裁到 124 字节，
+ *      socket 只能拿到 96 字节载荷，而一帧读扇区应答是 536 字节
+ *      （18 前导 + 512 扇区 + 6 收尾）=> 扇区数据在进 UDP 层之前就没了。
+ *
+ * v12 改成直接用 SMAP 的原始帧收发，于是：
+ *   - 不导入 ps2ip => 版本号（ps2ip 1.3 还是 2.6）、ABI、广播语义全部无关；
+ *   - 不再有 ip_input() 裁包 => 帧就是 640 字节，一个字节不少。
+ * 这条路径与原厂 loader 的做法一致（原厂请求帧就是从 0.0.0.0 发往
+ * 255.255.255.255 的裸帧，源 MAC 全零、目的 MAC 是垃圾 —— 说明盒子只看
+ * UDP 端口和 55 AA 记录流，完全不看 MAC/IP）。
+ *
+ * 导入的库是 netboxh —— OPL 自带的 smap-ingame 模块新加的导出表
+ * （modules/network/smap-ingame/exports.tab），编号必须与那张表严格一致。
+ */
+
+#ifndef __NETBOX_IMPORTS_H__
+#define __NETBOX_IMPORTS_H__
+
+#include <irx.h>
+
+/* netboxh 1.0 —— SMAP 原始帧收发（实现在 modules/network/smap-ingame） */
+#ifndef netboxh_IMPORTS_start
+#define netboxh_IMPORTS_start DECLARE_IMPORT_TABLE(netboxh, 1, 0)
+#define netboxh_IMPORTS_end   END_IMPORT_TABLE
+#endif
+
+/* 1: 注册原始帧钩子。fn = void (*)(const unsigned char *frame, int len)
+ *    钩子被 SMAP 的收包中断线程直接调用，frame 是刚 DMA 出来的整帧，
+ *    调用点在 ps2ip_input() 之前 —— 这是整条网络栈上唯一能拿到完整帧的地方。
+ *    传 NULL 可注销。 */
+#define I_smap_set_rx_hook DECLARE_IMPORT(1, smap_set_rx_hook)
+
+/* 2: 直接发送一个以太网帧（含 14 字节以太头），length 是整帧长度。
+ *    返回 1 成功、-1 表示 SMAP 还没初始化。 */
+#define I_SMAPSendPacket DECLARE_IMPORT(2, SMAPSendPacket)
+
+/* 3: 取本机 SMAP MAC（6 字节），用来填自发帧的源 MAC。 */
+#define I_SMAPGetMACAddress DECLARE_IMPORT(3, SMAPGetMACAddress)
+
+/* 4: 读 PHY 的真实链路状态（v14 新增）。
+ *    int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode)
+ *    返回 1 = 链路已建立，0 = 没链路；三个指针可为 NULL。
+ *
+ *    为什么必须有它：SmapIsInitialized（决定 SMAPSendPacket 能否发帧）是在
+ *    InitPHY() "成功" 之后被置 1 的，而 InitPHY() 的每一条出口都是
+ *    【无条件 return 0】—— 链路从来没起来时它也报成功。于是
+ *    "SMAPSendPacket() 返回 1" 完全不能证明链路上有线，
+ *    "hook=0（一个回包都没有）" 也就无法区分「没链路」和「盒子不回话」。
+ *    这一位（BMSR bit2）是唯一可信的判据。 */
+#define I_smap_get_link_status DECLARE_IMPORT(4, smap_get_link_status)
+
+/* 5: 回读已注册的原始帧钩子指针（v14 新增）。
+ *    void *smap_get_rx_hook(void)
+ *    只有自检用：netboxh 库若在运行时不存在，IOP 装载器会把导入桩改写成
+ *    空桩，smap_set_rx_hook() 静默无效、钩子计数永远是 0。回读比对即可分开。 */
+#define I_smap_get_rx_hook DECLARE_IMPORT(5, smap_get_rx_hook)
+
+#endif /* __NETBOX_IMPORTS_H__ */
