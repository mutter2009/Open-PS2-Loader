+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, netbox_dns[i]);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, 0);
+    }
 
     ret = diaExecuteDialog(diaBlockDevicesConfig, -1, 1, NULL);
     if (ret) {
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEILK, &gEnableILK);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEMX4SIO, &gEnableMX4SIO);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, &gEnableBdmHDD);
+        diaGetInt(diaBlockDevicesConfig, CFG_ENABLENETBOX, &gEnableNetBox); // [NETBOX]
+
+        // [NETBOX] 读回 NetBox 网络配置（静态）
+        for (i = 0; i < 4; i++) {
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, &netbox_ip[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, &netbox_netmask[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, &netbox_gateway[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, &netbox_dns[i]);
+        }
     }
 }
 
