+int gNetboxSmapStartRC = NETBOX_SMAP_RC_NOT_TRIED;
+
+// [NETBOX] 与 src/bdmsupport.c 里同一个理由，见上面的说明。
+extern int SifExecModuleBuffer(void *buffer, unsigned int size, unsigned int arg_len, const char *args, int *mod_res);
+
+// [NETBOX] 装载一个 IRX，并把 (id, rc) 分开记日志（便于从 IOP 日志/诊断定位）。
+// rc 初值 -1：装载器直接拒绝时 mod_res 不会被写，留 -1 正好表示"没跑起来"。
+static int ethNetboxExecModule(void *irx, int size, const char *what, int *rc_out)
+{
+    int id, rc = -1;
+
+    id = SifExecModuleBuffer(irx, size, 0, NULL, &rc);
+    LOG("[NETBOX] %s: id=%d rc=%d\n", what, id, rc);
+
+    if (rc_out != NULL)
+        *rc_out = rc;
+
+    return id;
