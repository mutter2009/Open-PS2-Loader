diff --git a/src/gui.c b/src/gui.c
index 1054228..2329307 100644
--- a/src/gui.c
+++ b/src/gui.c
@@ -440,17 +440,62 @@ void guiShowNetCompatUpdateSingle(int id, item_list_t *support, config_set_t *co
 static void guiShowBlockDeviceConfig(void)
 {
     int ret;
+    int i;
 
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEILK, gEnableILK);
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEMX4SIO, gEnableMX4SIO);
     diaSetEnabled(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, !gHDDStartMode);
     diaSetInt(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, gEnableBdmHDD);
+    diaSetInt(diaBlockDevicesConfig, CFG_ENABLENETBOX, gEnableNetBox); // [NETBOX]
+
+    // [NETBOX] 把驱动状态直接写到 "NetBox Network" 这一行上。
+    // 这样不接电脑、不抓包，也能一眼分清卡在哪一层：
+    //   OFF                        -> 开关没开，驱动不会被加载
+    //   not loaded yet             -> 还没走到 BDM 扫描（正常，进一次设备列表就会变）
+    //   LOAD REFUSED (id<0)        -> IOP 装载器拒绝加载 netbox.irx（导入的 ps2ip 版本/函数号对不上）
+    //   loaded, ret!=0             -> 模块装上了，但 _start() 早退（socket/bind 失败）
+    //   resident                   -> 装载成功且 _start() 驻留，网络栈已起来
+    // 注意：diaSetLabel() 只保存指针不复制字符串（见 src/dia.c），必须是 static 缓冲。
+    {
+        static char netboxStatus[96];
+        if (!gEnableNetBox)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox Network: OFF");
+        else if (gNetBoxStartRC == NETBOX_START_RC_NOT_TRIED)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON (not loaded yet)");
+        else if (gNetBoxLoadID < 0)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, LOAD REFUSED (id=%d)", gNetBoxLoadID);
+        else if (gNetBoxStartRC != 0)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, driver START FAILED (ret=%d)",
+                     gNetBoxLoadID, gNetBoxStartRC);
+        else
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, driver resident", gNetBoxLoadID);
+        diaSetLabel(diaBlockDevicesConfig, CFG_NETBOX_STATUS, netboxStatus);
+    }
+
+    // [NETBOX] NetBox 专用网络配置（独立 SMB）。
+    // 直连盒子的链路没有 DHCP 服务器（盒子只回广播、自身不跑 DHCP），
+    // 所以只有静态配置，v9 起已去掉 DHCP 开关（否则会白等 30 秒超时卡转圈）。
+    for (i = 0; i < 4; i++) {
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, netbox_ip[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, netbox_netmask[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, netbox_gateway[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, netbox_dns[i]);
+    }
 
     ret = diaExecuteDialog(diaBlockDevicesConfig, -1, 1, NULL);
     if (ret) {
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEILK, &gEnableILK);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEMX4SIO, &gEnableMX4SIO);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, &gEnableBdmHDD);
+        diaGetInt(diaBlockDevicesConfig, CFG_ENABLENETBOX, &gEnableNetBox); // [NETBOX]
+
+        // [NETBOX] 读回 NetBox 网络配置（静态）
+        for (i = 0; i < 4; i++) {
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, &netbox_ip[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, &netbox_netmask[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, &netbox_gateway[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, &netbox_dns[i]);
+        }
     }
 }
 
