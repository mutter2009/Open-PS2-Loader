diff --git a/modules/netbox/netbox.h b/modules/netbox/netbox.h
new file mode 100644
index 0000000..6b7e972
--- /dev/null
+++ b/modules/netbox/netbox.h
@@ -0,0 +1,132 @@
+/*
+ * netbox.h - PS2 NetBox 私有协议 (厂商内部名 NBD) 的字节级定义
+ *
+ * 全部常量来自对真实盒子流量的抓包解析 (见 ../PROTOCOL.md)，不是猜测。
+ * 协议本质: ATA-over-UDP。PS2 把 "写 ATA 寄存器 / 读 ATA 寄存器 / 轮询" 打包成
+ * 55 AA 记录流，用 UDP 广播 30000 -> 40000 发给盒子；盒子执行真实 ATA 命令后
+ * 把 512 字节扇区塞回 UDP 广播应答。
+ */
+
+#ifndef __NETBOX_H__
+#define __NETBOX_H__
+
+#include <types.h>
+
+/* ---------------- 以太网/IP/UDP 层 ---------------- */
+
+#define NB_ETH_HDR  14
+#define NB_IP_HDR   20
+#define NB_UDP_HDR  8
+#define NB_UDP_OFF  (NB_ETH_HDR + NB_IP_HDR + NB_UDP_HDR) /* 42: UDP 载荷起点 */
+
+#define NB_PORT        40000 /* 盒子监听端口，PS2 也从 30000 发往 40000 */
+#define NB_LOCAL_PORT  40000 /* 本机绑定端口（收盒子的广播应答） */
+#define NB_SRC_PORT    30000 /* PS2 源端口（盒子据此识别客户端） */
+
+/*
+ * 诊断通道：驱动把进度以纯文本广播到 UDP 40001。
+ * release 版 OPL 里 IOP 的 printf 看不见（没有 ps2link），
+ * 所以这是唯一能确认"驱动到底走到哪一步"的手段：
+ * PC 与 PS2 同网段抓包即可看到，不干扰协议端口 40000。
+ */
+#define NB_DIAG_PORT   40001
+
+/*
+ * 关键坑：盒子的应答是"畸形 IP 包"。
+ *   IP 头 total_length 声明 124，UDP 头声明 104，但以太网帧实际 640 字节，
+ *   真正的 512 字节扇区在 IP 声明长度之外。
+ *   lwIP 的 ip_input() 里有 pbuf_realloc(p, ntohs(IPH_LEN(iphdr)))，
+ *   会把它裁到 124 字节 -> 扇区数据丢失（socket 只能拿到 96 字节）。
+ *
+ *   所以 v12 起不再走 ps2ip：在 OPL 自带的 smap-ingame 里挂原始帧钩子
+ *   （smap_set_rx_hook，见 ../network/smap-ingame/main.c），在 ps2ip_input()
+ *   之前拿到完整以太网帧；发送也用 SMAPSendPacket 直接发裸帧。
+ *   （v11 及更早试图用自编译 ps2ip 的 ps2ip_set_raw_hook 解决，已废弃 ——
+ *     那条路还得替换菜单网络栈，副作用大。）
+ */
+#define NB_RSP_FRAME_LEN  640
+#define NB_RSP_PAYLOAD    598 /* 640 - 42 */
+#define NB_STATUS_FRAME   256
+
+/*
+ * 请求帧的以太网总长度（我们自己构造，见 netbox_bd.c 的 nb_build_frame）。
+ * 原厂 loader 实测有 256 / 384 / 512 三档，帧尾在记录流之后是未初始化内存
+ * —— 盒子照回不误，说明它只解析到 IP/UDP 长度字段声明的位置。
+ * 取最大的 512，尾部补零。
+ */
+#define NB_TX_FRAME_LEN   512
+
+/* ---------------- 应答帧（盒子 -> PS2）内部布局 ---------------- */
+/*
+ * 重要修正（2026-09-23 开机抓包实测）：
+ * 应答帧开头的填充记录条数【不是固定的 3 条】，而是随应答类型变化：
+ *     读扇区数据帧 (640B)  -> 3 条填充 -> 数据偏移 18
+ *     IDENTIFY 应答 (640B) -> 9 条填充 -> 数据偏移 54
+ *     命令状态帧   (256B)  -> 15 条填充
+ * 所以驱动必须【动态扫描】跳过所有 55aa 4a 00 xx 记录，
+ * 绝不能硬编码偏移 18，否则 IDENTIFY 会读到错位数据。
+ * 下面的常量只作为"典型值/上界"参考。
+ */
+#define NB_RSP_FILL_MAX   64   /* 最多允许扫描的填充记录条数 */
+#define NB_DATA_OFF_TYP   18   /* 读扇区时的典型数据偏移（仅参考） */
+#define NB_DATA_SIZE      512
+#define NB_DATA_END_TYP   530
+#define NB_F_OFF_TYP      530  /* 读扇区时的 F 记录偏移（仅参考） */
+#define NB_F_CMD_OFF      3    /* F 记录内 cmd 字节的相对下标 */
+#define NB_F_PARAM_OFF    4    /* F 记录内事务号的相对下标（大端） */
+
+/* ---------------- 记录格式 ---------------- */
+/* 每条记录 6 字节: 55 AA <type> <cmd> <param16 BE> */
+
+#define NB_SYNC0   0x55
+#define NB_SYNC1   0xAA
+#define NB_T_CMD   0x48 /* PS2 -> 盒子 的请求记录 */
+#define NB_T_RSP   0x4A /* 盒子 -> PS2 的应答记录 */
+
+/* cmd 字节 */
+#define NB_C_P     0x50 /* 帧头: param = 本记录之后所有记录的字节数 */
+#define NB_C_R     0x52 /* 读 ATA 寄存器: param = reg<<8 */
+#define NB_C_W     0x57 /* 写 ATA 寄存器: param = reg<<8 | value */
+#define NB_C_B     0x42 /* 块操作: 0x8000 = 开始, 0x0808 = 数据块 */
+#define NB_C_L     0x4C /* 轮询上限: 0x01ff */
+#define NB_C_F     0x46 /* 提交/刷新 + 携带事务号 */
+
+/* ---------------- ATA 寄存器映射 ---------------- */
+/* 协议里的寄存器编号 = ATA 寄存器号 + 8（抓包实测推导） */
+
+#define NB_REG_COUNT 0x0A /* ATA 0x02 扇区计数 */
+#define NB_REG_LBA0  0x0B /* ATA 0x03 LBA[0:7] / [24:31] */
+#define NB_REG_LBA1  0x0C /* ATA 0x04 LBA[8:15] / [32:39] */
+#define NB_REG_LBA2  0x0D /* ATA 0x05 LBA[16:23] / [40:47] */
+#define NB_REG_DEV   0x0E /* ATA 0x06 device/head */
+#define NB_REG_CMD   0x0F /* ATA 0x07 command/status */
+#define NB_REG_ALT   0xF2 /* 备用状态寄存器 */
+
+/* 开机握手专用寄存器（2026-09-23 开机抓包实测） */
+#define NB_REG_PROBE  0xFF /* 探测：握手第 1/2 帧读它 */
+#define NB_REG_ID1    0xF0 /* 握手第 2 帧读 */
+#define NB_REG_ID2    0xF1 /* 握手第 2 帧读 */
+#define NB_REG_ENABLE 0xFD /* 握手第 3 帧写 0x01（疑似启用 NBD 引擎） */
+#define NB_REG_RESET  0x16 /* 握手第 4/5 帧写 0x04 再写 0x00（软复位脉冲） */
+
+#define NB_DEV_LBA_MASTER 0x40 /* LBA 模式 + 主盘 */
+
+#define NB_ATA_READ_EXT   0x24 /* READ SECTORS EXT (48-bit) */
+#define NB_ATA_WRITE_EXT  0x34 /* WRITE SECTORS EXT (48-bit) */
+#define NB_ATA_IDENTIFY   0xEC /* IDENTIFY DEVICE */
+
+/* ---------------- 事务规则 ---------------- */
+
+/* 一个事务 = 1 个请求帧（内含 1 个提交 F + N 个轮询 F）
+ * 盒子回 1 个状态帧（F=T）+ N 个数据帧（F=T+1 .. T+N）
+ * 所以每事务消耗 N+1 个事务号。抓包实测 N=8 时步长正好是 9。 */
+#define NB_MAX_SECTORS 8 /* 抓包实测真实客户端最大用 8；改大需自行验证 */
+
+#define NB_REC_SIZE     6
+#define NB_CMD_RECS     15 /* 请求里 "P 之后的命令部分" 记录数（不含 N 个轮询块） */
+#define NB_POLL_RECS    4  /* 每个轮询块: B:8000 B:0808 L:01ff F */
+
+/* P 的 param = (NB_CMD_RECS + 4*count) * 6 */
+#define NB_P_PARAM(count) ((NB_CMD_RECS + (NB_POLL_RECS * (count))) * NB_REC_SIZE)
+
+#endif /* __NETBOX_H__ */
diff --git a/modules/netbox/netbox_bd.c b/modules/netbox/netbox_bd.c
new file mode 100644
index 0000000..2b1fb29
--- /dev/null
+++ b/modules/netbox/netbox_bd.c
@@ -0,0 +1,2662 @@
+/*
+ * netbox_bd.c - PS2 NetBox (NBD / ATA-over-UDP) 的 BDM 块设备驱动
+ *
+ * 目标：作为一个 IOP 侧 IRX 模块挂进官方 OPL，通过 bdm_connect_bd() 注册
+ *       struct block_device，让 OPL 把盒子硬盘当成本地块设备来读游戏。
+ *
+ * 协议依据：../PROTOCOL.md / netbox.h（由真实盒子抓包逐字节验证，
+ *          2026-09-23 还抓到了原厂 loader 的对照流量：请求 512 字节帧、
+ *          应答 640 字节帧，逐帧核对过）
+ *
+ * ==========================================================================
+ * ★ v12（2026-09-24）传输层大改：从 lwIP socket 换成 SMAP 裸帧 ★
+ * ==========================================================================
+ *
+ * v11 及更早用 lwIP 的 UDP socket 收发，实机上「模块驻留成功
+ * （id=68, driver resident）但连 netbox 图标都不出来」。原因有两层：
+ *
+ * 1) 应用层看不到帧。盒子把应答【广播】到 255.255.255.255、源 MAC
+ *    08:00:27:7f:f6:27、UDP 30000->40000。发给特定地址的 socket 在 lwIP
+ *    里不一定能收到广播。
+ *
+ * 2) 就算收到，数据也是残的。盒子的 IP 头 total_length 恒为 124、
+ *    UDP 头 length 恒为 104，而以太网帧实际 640 字节（抓包 254148 帧全部
+ *    如此，是固件写死的常数）。lwIP 的 ip_input() 里
+ *    pbuf_realloc(p, ntohs(IPH_TOTLEN)) 会把 pbuf 裁到 124 字节，socket
+ *    最多只能拿到 96 字节 UDP 载荷 —— 而一个读扇区应答有 536 字节
+ *    （18 字节前导记录 + 512 字节扇区 + 6 字节收尾记录）。
+ *    => 扇区数据在进 UDP 层之前就没了 => fatfs 挂不上 mass0: =>
+ *       bdmUpdateDeviceData() 里 fileXioDopen("mass0:/") 失败 =>
+ *       OPL 连设备图标都不显示，更不用说游戏列表。
+ *
+ * 所以 v12 完全绕开 ps2ip：
+ *   收 —— 在 OPL 自带的 smap-ingame 模块里注册「原始帧钩子」
+ *          （smap_set_rx_hook，见 ../network/smap-ingame/main.c），
+ *          钩子在 SMapLowLevelInput() 里、ps2ip_input() 【之前】被调用，
+ *          拿到的是刚 DMA 出来的完整以太网帧，一个字节不少。
+ *   发 —— 同样用 SMAP 直接发裸帧（SMAPSendPacket），自己拼
+ *          ETH+IP+UDP 头。这条路径与原厂 loader 完全一致（原厂请求帧
+ *          源 MAC 全零、目的 MAC 是垃圾、IP 0.0.0.0 -> 255.255.255.255，
+ *          说明盒子只看 UDP 端口和 55 AA 记录流，不看 MAC/IP）。
+ *
+ * 附带好处：不再依赖 ps2ip 的版本号（1.3 还是 2.6）、不再需要知道
+ * 盒子 IP、不需要 DHCP、不需要网卡配置 —— 少了四类可能出错的环节。
+ *
+ * 已知前提 / 注意：
+ *  1. 必须在 smap-ingame 之后加载：本模块导入 netboxh 库的符号，
+ *     没有 smap-ingame 时 IOP 装载器会直接拒绝加载（id < 0）。
+ *  2. 盒子 IP 不写死：全程广播，靠事务号配对。
+ *  3. 写操作未抓到过样本，本驱动只读（write 返回 -1），避免静默写坏数据。
+ *
+ * ==========================================================================
+ * ★ v14（2026-09-24 傍晚）补掉最后一个盲点：链路状态与钩子自检 ★
+ * ==========================================================================
+ *
+ * v13 在实机上报回 "NetBox: FAIL stage=3 hook=0"，也就是
+ * 「发送自检通过、但一个回包都没收到」。去读 smap-ingame/smap.c 的
+ * SMAPStart() 之后发现 v13 的 stage=2 判据是假阳性：
+ *
+ *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ *     if (result == 0 && !NetDevStopFlag) { ...; SmapIsInitialized = 1; }
+ *
+ * 而 InitPHY() 的每一条出口都是【无条件 return 0】（smap.c 末尾），
+ * 它内部所有"等链路"的循环超时后也只是把 LinkStatus 置 0 继续往下走。
+ * ⇒ **链路从来没起来时，InitPHY 也报成功，SmapIsInitialized 也是 1，
+ *   SMAPSendPacket() 也返回 1。** "发送成功"完全不能证明链路上有线。
+ *
+ * 所以 v14 增加了两个 netboxh 导出（见 smap-ingame/exports.tab）：
+ *   smap_get_link_status() —— 直接读 PHY 的 BMSR bit2，这是唯一可信判据
+ *   smap_get_rx_hook()     —— 回读钩子指针，区分「钩子没装上」与「没回包」
+ * 并把两者编进 _start() 的返回码，设置页直接显示。
+ */
+
+#include <bdm.h>
+#include <intrman.h>
+#include <irx.h>
+#include <loadcore.h>
+#include <stdio.h>
+#include <sysclib.h>
+#include <sysmem.h>
+#include <thbase.h>
+#include <thsemap.h>
+#include <types.h>
+
+#include "netbox.h"
+
+IRX_ID("netbox_bd", 1, 0);
+
+/* ------------------------------------------------------------------ */
+/* netboxh 库（OPL 自带的 smap-ingame 模块导出）                        */
+/*                                                                     */
+/* 编号与 modules/network/smap-ingame/exports.tab 严格一致：            */
+/*   1 smap_set_rx_hook    2 SMAPSendPacket      3 SMAPGetMACAddress    */
+/*   4 smap_get_link_status 5 smap_get_rx_hook   （后两个 v14 新增）     */
+/* 导入语句本身在 imports.lst（宏在 netbox_imports.h），这里只是给     */
+/* 编译器提供原型。                                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * 原始帧钩子。签名必须和 smap-ingame/main.c 里的 SmapRxHook 一致：
+ *     void (*)(const unsigned char *frame, int len)
+ * 它在 SMAP 的收包中断线程里被直接调用（xfer.c: HandleRxIntr ->
+ * SMapLowLevelInput -> SmapPassRawFrame），此时模块的 GP 切换由 -G0
+ * 编译选项天然规避（ps2sdk 的 Makefile.iopglobal 一律带 -G0，
+ * 没有小数据段，所以跨模块的函数指针调用是安全的）。
+ */
+typedef void (*nb_rx_hook_t)(const unsigned char *frame, int len);
+
+extern void smap_set_rx_hook(void *fn);
+extern void *smap_get_rx_hook(void);
+extern int SMAPSendPacket(const void *data, unsigned int length);
+extern int SMAPGetMACAddress(unsigned char *buffer);
+extern int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode);
+/* v15：收发路径现场计数 + PHY 快照。都只是读寄存器/读计数器，无副作用。 */
+extern int smap_get_rx_diag(unsigned int *out, int n);
+extern int smap_get_phy_dump(unsigned int *out, int n);
+/* v17：主动把 PHY 初始化补跑一遍（SMAPStart 里因为 BMSR 报有链路而被跳过的那一刀），
+ * 并把 BMCR/BMSR/ANAR/ANLPAR/PHYSTS/EMAC3-FDX/LinkMode 现场交出来。
+ * 它是【有界】的（上限约 10.6 秒）—— 上游 InitPHY() 里有个会无限循环的
+ * goto，网线没插时永不返回，会直接把 OPL 启动卡死，所以不能用。
+ * 返回 0 = 链路就绪 / 1 = 没就绪；细节在 out[11] 低 4 位。
+ * 编号 8，见 netbox_imports.h 与 smap-ingame/exports.tab。 */
+extern int smap_phy_reinit(unsigned int *out, int n);
+/* v19：EMAC3 内部自环开关。打开后 MAC 的发送路径在芯片内部接回接收路径，
+ * 不经过 PHY / 网线 / 盒子 —— 于是"PS2 自己收不收得到帧"变成一个二元答案。
+ * 这是整轮里唯一不依赖外部设备、也不需要抓包的判据（见 nb_loopback_selftest）。
+ * 编号 9，见 netbox_imports.h 与 smap-ingame/exports.tab。 */
+extern int smap_loopback_set(int on);
+/* v21：PHY/MII 自环 + PHY 统计寄存器。
+ * v20 实机报回 "LOOPBACK OK: PS2 rx path fine" —— EMAC3 内自环通了，也就是说
+ * MAC 数字部分 + 地址过滤 + MAL RX FIFO + RXEND 中断 + 收帧钩子这一整串完好。
+ * 那 PS2 侧唯一还没被验证过的数据通路就只剩 PHY 的 MII 段了 —— 注意 v17 读回
+ * BMSR=0x2D 只证明 PHY 的 MDIO【管理】通道可用，与数据能不能过去是两件事。
+ *   10 smap_phy_loopback_set：置/清 PHY 的 BMCR bit14（802.3 Loopback），
+ *      让 PHY 在 MII 接口处把发送数据回环到接收侧。
+ *   11 smap_phy_counters：读 PHYSTS + FCSCR/RECR/PCSR。FCSCR/RECR 非 0 就说明
+ *      线上真有信号进来过并被 PHY 接收侧处理过 —— 比自环更硬，因为自环不碰网线。
+ * 编号 10/11，见 netbox_imports.h 与 smap-ingame/exports.tab。 */
+extern int smap_phy_loopback_set(int on);
+extern int smap_phy_counters(unsigned int *out, int n);
+
+/* ------------------------------------------------------------------ */
+/* 收包环形缓冲（原始帧钩子写入，协议线程消费）                          */
+/* ------------------------------------------------------------------ */
+
+#define NB_RX_SLOTS 32
+#define NB_RX_MAX   1536
+
+static u8          rx_buf[NB_RX_SLOTS][NB_RX_MAX];
+static volatile int rx_len[NB_RX_SLOTS];
+static volatile int rx_head; /* 生产者（收包中断） */
+static volatile int rx_tail; /* 消费者（读盘线程） */
+static int          io_sema; /* 保证同一时刻只有一个事务在飞 */
+
+/*
+ * 诊断计数器（诊断包里以 hook=/rx=/drop= 上报）。
+ * 这三个数能把失败精确定位到四种完全不同的原因：
+ *
+ *   hook=0                -> 收包钩子没被调用：
+ *                            smap-ingame 没被加载（那 netbox.irx 其实也装不上），
+ *                            或者钩子注册失败。方案在这一步就是死的。
+ *   hook>0 但 drop=hook   -> 收到帧了但全被 rx_push 的过滤条件挡掉：
+ *                            ethertype / IP proto / 目的端口 判断与实机不符。
+ *   rx>0 但 IDENTIFY 失败  -> 协议层问题：事务号或数据偏移不对。
+ *   rx=0 且 hook=0        -> 根本没收到任何帧（网线、盒子没上电、链路没起来）。
+ */
+static volatile int g_hook_calls = 0;
+static volatile int g_rx_frames  = 0;
+static volatile int g_rx_drop    = 0;
+/* [v28] 收到「我们自己发出去的帧」的次数 —— 见 netbox_raw_hook 的说明。 */
+static volatile int g_self_calls = 0;
+/* [v29] 收到盒子（源 MAC = 08:00:27:7f:f6:27）帧的次数 —— 诊断用，
+ * 让诊断通道能显示「盒子到底开没开过门」。只读不改收包逻辑：SMAP 的接收模式
+ * 在 smap_init() 里已开 RX_BCAST/RX_MCAST，盒子的广播帧本来就能进 hook。 */
+static volatile int g_box_frames = 0;
+/* [v30] 1 = 启动时没等到盒子开门 -> 惰性模式：设备先注册出去，
+ * 重链 + 长监听推迟到 OPL 第一次读盘（见 nb_lazy_connect）。 */
+static int g_lazy_pending = 0;
+
+/*
+ * 发送失败计数（v13 新增）。
+ *
+ * 为什么必须单独数它：SMAPSendPacket() 的第一行是
+ *     if (SmapDriverData.SmapIsInitialized) { ...发... } else result = -1;
+ * 而 SmapIsInitialized 只在 SMAPStart() 里 PHY 真正 up 之后才置 1。
+ * SMAPStart() 是 smap-ingame 在 netif_add() 里调的，**返回值被丢掉了**。
+ * 于是"PHY/链路没起来 ⇒ 一个字节都发不出去 ⇒ 盒子永远收不到请求"
+ * 在 v12 里是完全不可见的：驱动照样返回 resident，设置页照样显示正常。
+ * g_tx_err>0 且 g_hook_calls==0 就是在说这件事。
+ *
+ * ★ v14 更正：上面这段推断在 v13 被实现成了 stage=2 的判据，但它是**错的**。
+ *   InitPHY() 的每一条出口都是无条件 return 0，所以链路从来没起来时
+ *   SmapIsInitialized 照样是 1、SMAPSendPacket() 照样返回 1，
+ *   g_tx_err 永远是 0。真正的判据只有下面这一组（PHY 的 BMSR bit2）。
+ */
+static volatile int g_tx_err = 0;
+
+/*
+ * 链路状态（v14 新增）—— 唯一可信的"线上到底有没有链路"的判据。
+ *
+ *   g_link_up   : 1 = BMSR.LinkStatus 已置位（链路建立），0 = 没有链路
+ *   g_last_bmsr : 最后一次读到的 BMSR 原值（bit2 = link，bit5 = 自动协商完成）
+ *   g_link_mode : InitPHY() 填的 LinkMode：bit0..3 = 1:10M半 2:10M全
+ *                 4:100M半 8:100M全，bit6 = 流控。链路不通时无意义。
+ */
+static volatile int g_link_up   = 0;
+static volatile unsigned int g_last_bmsr = 0;
+static volatile unsigned int g_link_mode = 0;
+
+static void rx_push(const u8 *frame, int len)
+{
+    int next, state;
+
+    if (len <= NB_UDP_OFF || len > NB_RX_MAX) {
+        g_rx_drop++;
+        return;
+    }
+
+    /* 只保留盒子 -> 40000 的 UDP 帧。
+     * 盒子回包实测：ethertype 0x0800、IP proto 17、UDP 30000 -> 40000。 */
+    if (frame[12] != 0x08 || frame[13] != 0x00) {
+        g_rx_drop++;
+        return;
+    }
+    if (frame[23] != 17) { /* IP proto != UDP */
+        g_rx_drop++;
+        return;
+    }
+    /* 目的端口 == 40000 ? （UDP 头在 14+ihl，盒子回包的 ihl 恒为 5 = 20） */
+    if (frame[NB_ETH_HDR + NB_IP_HDR + 2] != (NB_PORT >> 8) ||
+        frame[NB_ETH_HDR + NB_IP_HDR + 3] != (NB_PORT & 0xFF)) {
+        g_rx_drop++;
+        return;
+    }
+
+    CpuSuspendIntr(&state);
+    next = (rx_head + 1) % NB_RX_SLOTS;
+    if (next != rx_tail) { /* 非满 */
+        memcpy(rx_buf[rx_head], frame, len);
+        rx_len[rx_head] = len;
+        rx_head         = next;
+        g_rx_frames++;
+    } else
+        g_rx_drop++; /* 环形缓冲满了：堆积的帧直接丢，别把中断卡住 */
+    CpuResumeIntr(state);
+}
+
+/*
+ * [v21] 抓帧窗口 —— 只记每个窗口最前面几帧的头 32 字节。
+ *
+ * 为什么需要它：走到 stage 10/11 时，PS2 自己能收包已经被 v20 的内自环证明了，
+ * 剩下的问题只有"线上到底有没有东西、对端长什么样"。把窗口内收到的前几帧的
+ * 以太网头留下来，由 nb_diag() 打成明文广播出去，PC 侧一抓就能直接看到
+ * 目的/源 MAC 和 EtherType —— 这比任何间接推断都硬。
+ *
+ * 开销：正常运行时 g_cap_on == 0，钩子里只多一次 volatile 读；窗口本身很窄
+ * （最多几百毫秒），缓冲是静态的，不在中断里分配，也不加锁（中断上下文里
+ * 只做递增和一个短 memcpy）。
+ */
+#define NB_CAP_MAX   4
+/* [v22] 32 -> 48：UDP 头的源/目的端口在以太网头 14 + IP 头 20 之后的
+ * 第 34..37 字节，32 字节的旧上限刚好差一点够不到 —— 而"目的端口是不是
+ * 40000"正是判断"这帧是不是我们这套协议"最直接的证据。 */
+#define NB_CAP_BYTES 48
+
+static volatile int g_cap_on = 0;
+static volatile int g_cap_n  = 0;
+static u8           g_cap[NB_CAP_MAX][NB_CAP_BYTES];
+static volatile int g_cap_len[NB_CAP_MAX];
+
+/* [v22] A/B 对照窗口 + 首帧身份判定的全局状态。
+ * ★ 必须放在所有用到它的函数之前（nb_diag_pack_listen 在 700 行量级、nb_listen_probe
+ *   在 1489 行），否则 C 编译器会因"先使用后声明"报 undeclared。 */
+static int          g_listen_a  = 0; /* 窗口 A（纯听）内 MAL 硬件收到的帧数 */
+static int          g_listen_b  = 0; /* 窗口 B（发帧后）内 MAL 硬件收到的帧数 */
+static int          g_listen_ca = 0; /* 窗口 A 内抓到的帧数（判定首帧来自哪个窗口） */
+static int          g_listen_silent = 0; /* 两窗口都 0 帧 => SILENT（符合盒子静默监听，不证明故障）*/
+static unsigned int g_f_kind = 0; /* 首帧种类 0=无 1=广播 2=厂商多播 3=其他多播 4=单播 */
+static unsigned int g_f_d3   = 0; /* 首帧 (dst[3]>>5)&3（分 ff:34:43:{52,30,00,ff}）*/
+static unsigned int g_f_u    = 0; /* 首帧源 MAC 前 3 字节 == 08:00:27（盒子）*/
+static unsigned int g_f_et   = 0; /* 首帧 EtherType == 0x0800（IPv4）*/
+static unsigned int g_f_p4   = 0; /* 首帧 UDP 目的端口 == 40000 */
+static unsigned int g_f_p3   = 0; /* 首帧 UDP 源端口  == 30000 */
+
+/* [v23] 链路体检 + TX 残留的全局状态。
+ *
+ * 为什么是全局：这些值在 nb_phy_loopback_selftest() / nb_listen_probe() 里
+ * 采集，却要在 nb_diag_pack_linkchk()（文件更靠前）里打包上屏 —— 和上面
+ * v22 那几个一样，声明必须落在所有使用者之前，否则 undeclared。
+ *
+ * 起因（本轮两条实机+代码复核结论）：
+ *   1) v22 屏幕上的 "RX SILENT 0 frames" 不能直接读成"线坏了" ——
+ *      2026-09-23 的真值抓包（NETBOX_REFERENCE_FRAMES.md §2）写明：
+ *      **盒子单独接 PC 时一个包都不发**，它是"静默监听、只在收到正确探测后
+ *      才应答"的设计。所以纯听窗口本来就该是 0，"听不到"不是新信息。
+ *   2) 真正悬着没验证过的是【我们的帧到底有没有上线路】。参考帧文档 §6
+ *      记着"我们的构建在 PS2 侧抓到 0 帧"，而发送侧一律返回 1。
+ *      SMAP_R_TXFIFO_FRAME_CNT（"发送队列里还没发完的帧数"）就是查它用的：
+ *      发完等 120ms 之后它还不是 0  =>  MAC 压根没把帧取走。
+ */
+static int          g_txq10 = 0;  /* stage 10（PHY 自环）发送后 TX FIFO 残留帧数 */
+static int          g_txq11 = 0;  /* stage 11 窗口 B 发送后 TX FIFO 残留帧数    */
+static int          g_lk_rc = -1; /* smap_phy_reinit() 的返回：0=链路就绪 1=没就绪 */
+static unsigned int g_lk[12];     /* smap_phy_reinit() 的现场快照（索引见其注释）*/
+static unsigned int g_pc[8];      /* smap_phy_counters() 的新鲜读值（stage 12 用）*/
+
+static void netbox_raw_hook(const unsigned char *frame, int len)
+{
+    /* [v28] ★ 只把「不是我们自己发的」帧当成盒子应答 ★
+     *
+     * 起因是 capG 11:44 我们那一轮的实测：PS2 侧线上只有我们自己发的帧
+     * （71 帧源 MAC 全是 00:00:00:00:00:00），盒子侧 0 帧，可是诊断通道
+     * 打出来的是 hook=19 / ok=19 / wait=19 —— 说明我们【收回了自己发出去
+     * 的帧】19 次（EMAC3/MAL 侧的内部回环，不是回灌：抓包里没有重复帧）。
+     *
+     * 这 19 次会把 g_hook_calls 顶起来，于是 _start 里
+     *     if (g_hook_calls != 0) return nb_fail(NB_STAGE_IDENTIFY);
+     * 判定成「收到过帧但对不上」，屏幕上就永远是 FAIL identify；后面的
+     * 自环(stage 9) / PHY 自环(10) / 监听(11) / linkchk(12) 四级阶梯
+     * 一次都没跑过。前面几轮的诊断结论全被这一条带偏了。
+     *
+     * 判据用「源 MAC 全零」就够：实测（capB/capG 两次独立抓包）我们自己
+     * 发出去的帧源 MAC 恒为全零 —— nb_build_frame 不写源 MAC（见其注释），
+     * 盒子的回包源 MAC 是 08:00:27:7f:f6:27，不会被误滤。 */
+    if (len >= 12 &&
+        (frame[6] | frame[7] | frame[8] | frame[9] | frame[10] | frame[11]) == 0) {
+        g_self_calls++;
+        return;
+    }
+
+    /* [v29] 认出盒子的帧（源 MAC = 08:00:27:7f:f6:27）并计数 —— 只读不改收包逻辑。
+     * 盒子只在自身链路 flap 后广播开门（JF=306），这个计数让诊断通道能显示
+     * 「盒子到底开没开过门」。注意：rx_push 的收包过滤不依赖目的 MAC，所以盒子的
+     * 广播回包本来就能进环形缓冲，这里只是额外打个计数器方便诊断。 */
+    if (len >= 12 &&
+        frame[6] == 0x08 && frame[7] == 0x00 && frame[8] == 0x27 &&
+        frame[9] == 0x7f && frame[10] == 0xf6 && frame[11] == 0x27)
+        g_box_frames++;
+
+    g_hook_calls++;
+
+    if (g_cap_on && g_cap_n < NB_CAP_MAX) {
+        int n = (len < NB_CAP_BYTES) ? len : NB_CAP_BYTES;
+        int k;
+
+        for (k = 0; k < n; k++)
+            g_cap[g_cap_n][k] = frame[k];
+        g_cap_len[g_cap_n] = n;
+        g_cap_n++;
+    }
+
+    rx_push((const u8 *)frame, len);
+}
+
+/* ------------------------------------------------------------------ */
+/* 原始帧发送                                                          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * 发送缓冲与长度：NB_TX_FRAME_LEN（512）在 netbox.h 里定义 —— 那是【缓冲上限】。
+ * [v24] 实际发出去的字节数不再等于缓冲上限，而是每次由 nb_build_frame 按
+ *       [v25] 原厂实测的公式算出来放在 nb_tx_len 里，理由见其注释。
+ * 帧尾在记录流结束之后补零 —— 原厂 loader 那里是未接续写的老内存残留，
+ * （v26 已证：尾巴逐字节等于上一帧的内容），盒子照回不误。
+ */
+static u8  nb_tx[NB_TX_FRAME_LEN];
+static u8  nb_mac[6];
+static u16 nb_ipid = 1;
+
+/*
+ * [v24] 本次实际要发的长度（由 nb_build_frame 按需算好）。
+ *
+ * 为什么要动态而不是恒定 NB_TX_FRAME_LEN：2026-09-25 的桥接抓包里，
+ * 【我们】发的每一帧都是 512 字节（记录流之后全零补齐），而【原厂】在
+ * 同一台盒子上发的同类请求帧是 256 字节 —— 两条流逐字节比对后，除了
+ * 源 MAC 之外这是仅剩的差别。既然原厂 256 字节的帧盒子会回，就没必要
+ * 赌"盒子容忍 512"，直接按原厂的规矩来。[v25] 把"原厂的规矩"落实成了
+ * 它真正用的那条公式（256 + 128×floor((ulen+42)/128)），见 nb_build_frame。
+ *
+ * 取整规则（对齐原厂实测的 256 / 384 / 512 三档）：
+ *     256 字节起步，(14+20+8+载荷) 向上取整到 256 的倍数。
+ * 小请求（握手/IDENTIFY，载荷 30~60 字节）⇒ 256，与原厂逐字节同类。
+ * 大请求自动涨到 512 甚至 768，所以不会因为改小了上限而发不出去。
+ */
+static int nb_tx_len = NB_TX_FRAME_LEN;
+
+/* ------------------------------------------------------------------
+ * [v19] 目的 MAC 候选表 —— 驱动器与"厂商可用版本"之间唯一未验证的差异。
+ *
+ * 2026-09-23 的桥接抓包里有【厂商 netbox 版】PS2 侧发出的 31,286 个请求帧
+ * （captures/bridge_run2_ps2_20260923.pcap / bridge_run3_ps2_20260923.pcap），
+ * 统计它们的以太网目的 MAC，结果是三个值：
+ *     ff:34:43:52:ff:ff  17339 帧
+ *     ff:34:43:30:ff:ff   7288 帧
+ *     ff:34:43:00:ff:ff   6659 帧
+ * 而且同一个载荷会在 0.2ms 内背靠背发到两个不同的地址上（:30 然后 :52），
+ * 看起来厂商是在向一组候选地址盲发。
+ *
+ * ★ 而我们自己从 v1 起一直用标准广播 ff:ff:ff:ff:ff:ff ★
+ * 这不是"随便选一个"——ff:34:43:xx 的第一个字节 0xff 说明它是【多播】地址，
+ * 一个正常网卡在多播模式下广播和多播都收；但盒子是 Zynq 上跑 Linux 的
+ * 专用设备，它的过滤规则是它自己定的，我们从来没验证过"盒子认不认标准广播"。
+ * 而这一条恰好是唯一一个"厂商能用、我们没用"的差别，之前一直没测过。
+ *
+ * 所以 v19 把开机握手改成【阶梯】：每轮换一个候选地址，谁先换来盒子的第一个
+ * 回包，谁就是对的那个。四个候选一轮跑完，代价只有 4 轮握手的等待时间。
+ * （v19~v24 时期下表第 0 项是标准广播，v26 按 capB 的实测把它挪到了最后，
+ *   见下一段注释 —— 阶梯机制本身没变。）
+ * ------------------------------------------------------------------ */
+/* [v25] 表序重排：第 0 项从"标准广播"改成厂商实测的 ff:34:43:00:ff:ff。
+ *
+ * 2026-09-25 的 capB 抓包（21 分钟、两侧 pcap 全落盘）里，厂商 loader 的
+ * 三个"开机 + 读游戏目录"会话（14:01 / 14:02 / 14:08）一共 17199 帧，
+ * 目的 MAC 【全部】是 ff:34:43:00:ff:ff；标准广播 ff:ff:ff:ff:ff:ff
+ * 出现 【0 次】。
+ *
+ * 也就是说：握手阶段那个"对的"地址是 ..00，不是广播。而 v19~v24 把广播
+ * 放在第 0 项，等于每一轮阶梯的头一枪都打在一个厂商从来没用过的地址上。
+ * 这里把广播挪到最后兜底，第 0 项交给 ..00。
+ *
+ * ..30 / ..52 只在进入大批量读盘之后才出现（14:09 / 14:10 两个会话里
+ * 30 与 52 交替），所以它们仍是有效候选，只是不是开机握手用的那个。 */
+#define NB_DSTMAC_BCAST 3               /* 表里"标准广播"那一项的序号 */
+static const u8 nb_dstmac_tab[4][6] = {
+    {0xFF, 0x34, 0x43, 0x00, 0xFF, 0xFF}, /* 0：厂商握手/读目录实测，17199 帧 */
+    {0xFF, 0x34, 0x43, 0x30, 0xFF, 0xFF}, /* 1：厂商读盘实测                  */
+    {0xFF, 0x34, 0x43, 0x52, 0xFF, 0xFF}, /* 2：厂商读盘实测                  */
+    {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}, /* 3：标准广播（v1~v18 的老行为）    */
+};
+static int nb_dstmac_idx = 0;
+/* [v30] ★ v29 的教训 ★：v29 把「flap 重链 + 120 轮长监听（≈5 分钟）」全塞在
+ * _start() 里，而 _start() 是在 OPL 的 bdmLoadBlockDeviceModules() 中被【同步】
+ * 调用的（那个函数一直持着 bdmLoadModuleLock），于是 OPL 主页 10 分钟都进不去。
+ * v30 重新分工：
+ *   _start()          —— 只跑 NB_V30_BOOT_ROUNDS 轮（秒级、不 flap）；拿不到盒子
+ *                        就注册设备走惰性模式并立刻返回，保证 OPL 秒进主页。
+ *   nb_lazy_connect() —— OPL 第一次读盘时才做「flap 逼开门 + 长监听」。
+ *                        盒子服务窗只有约 26.5 秒，所以每阶段前先 flap 一次。 */
+#define NB_V30_BOOT_ROUNDS   6    /* 启动尝试轮数（≈10 秒上限）*/
+#define NB_V30_LAZY_PHASE1   10   /* 惰性阶段1：flap 后听 10 轮 */
+#define NB_V30_LAZY_PHASE2   10   /* 惰性阶段2：再 flap 后再听 10 轮 */
+/* 没拿到盒子时先报给 OPL 的占位容量（128 GB / 512B 扇区）。
+ * 只影响菜单显示的大小，读盘正确性不受影响；nb_lazy_connect() 拿到真
+ * IDENTIFY 后会把它改成真实容量。 */
+#define NB_V30_LAZY_SECTORS  0x10000000u
+
+/* IPv4 头校验和（头内校验和字段需先置 0） */
+static u16 nb_ip_cksum(const u8 *p, int n)
+{
+    u32 s = 0;
+
+    while (n > 1) {
+        s += (u32)(((u16)p[0] << 8) | p[1]);
+        p += 2;
+        n -= 2;
+    }
+    if (n > 0)
+        s += (u32)((u16)p[0] << 8);
+    while (s >> 16)
+        s = (s & 0xFFFF) + (s >> 16);
+
+    return (u16)(~s);
+}
+
+/*
+ * 组一个 ETH + IPv4 + UDP 帧，返回整帧长度（[v24] 起 = nb_tx_len，
+ * [v25] 按原厂公式 256 + 128×floor((ulen+42)/128) 取档，不再固定 NB_TX_FRAME_LEN）。
+ *
+ * 逐字段对齐原厂 loader 的真实请求帧（2026-09-23 桥接抓包）：
+ *   ETH dst = 【候选表】          v19 起是阶梯，见 nb_dstmac_tab：
+ *                                厂商实测用的是 ff:34:43:{00,30,52}:ff:ff，
+ *                                而 v1~v18 一直用标准广播。这一条从没验证过。
+ *       src = 本机 SMAP MAC       原厂填全零；填真 MAC 更规范，盒子不看
+ *       type= 0x0800
+ *   IP  0.0.0.0 -> 255.255.255.255, TTL 0xff, proto 17, DF
+ *       total_length = 20 + 8 + paylen    <- 必须是真值
+ *   UDP 30000 -> dport, length = 8 + paylen，校验和 0（原厂也是 0）
+ *
+ * 长度字段必须写真值：原厂请求帧的 IP/UDP 长度是对的（8 扇区读 = 316/296），
+ * 而盒子的应答恰恰把这两个字段写成常数 —— 说明盒子是【按请求里的长度】
+ * 确定记录流长度、并只在应答里回填数据的。所以这里绝不能像盒子那样偷懒。
+ */
+static int nb_build_frame(const u8 *payload, int paylen, u16 dport)
+{
+    u8 *f = nb_tx;
+    int iplen, udplen, flen;
+    u16 c;
+
+    if (paylen < 0 || (NB_UDP_OFF + paylen) > NB_TX_FRAME_LEN)
+        return -1;
+
+    iplen  = NB_IP_HDR + NB_UDP_HDR + paylen;
+    udplen = NB_UDP_HDR + paylen;
+
+    /* [v25] 帧长按原厂实测公式：
+     *     flen = 256 + 128 * floor((ulen + 42) / 128)      ulen = UDP 总长
+     *          = 256 + 128 * floor((paylen + 50) / 128)
+     *
+     * 2026-09-25 capB 抓包里厂商那 17199 个请求帧，这条公式 【17199/17199
+     * 全中】（实测档位只有 256 / 384 / 512 三档：ulen 44→256、128→384、
+     * 200→384、296→512）。注意它不是"最小的能装下的 128 倍数"——而是
+     * 那个倍数【再加 128】。v24 用的是"256 起步向上取 256 倍数"，对小包
+     * （握手，ulen 44）恰好也对（=256），但对中包会偏小（ulen 128 时
+     * 应该是 384，v24 给 256），所以这里换成原厂的原式。
+     *
+     * 上限仍夹在 NB_TX_FRAME_LEN：本驱动实际最大请求载荷约 300 字节，
+     * 对应 flen ≤ 512，够用；夹住只是防御性的。 */
+    flen = 256 + 128 * ((NB_UDP_HDR + paylen + 42) / 128);
+    if (flen > NB_TX_FRAME_LEN)
+        flen = NB_TX_FRAME_LEN;
+    nb_tx_len = flen;
+
+    memset(f, 0, flen);
+
+    /* ---- Ethernet ---- */
+    /* [v19] 目的 MAC 从候选表取（见 nb_dstmac_tab 的说明）：
+     * [v25] 第 0 项 = 厂商握手实测的 ff:34:43:00:ff:ff（阶梯从它开始打），
+     * 第 3 项 = 标准广播，只作兜底。阶梯由 nb_dstmac_idx 控制。 */
+    memcpy(f, nb_dstmac_tab[nb_dstmac_idx & 3], 6);
+    /* [v24] src = 全零 —— 对齐原厂。
+     *
+     * 2026-09-25 的 capB 抓包里，原厂发出来的每一帧源 MAC 都是
+     * 00:00:00:00:00:00，而我们从 v1 起一直填本机 SMAP MAC。
+     * 这一条【经实测是安全的】：同一份抓包里盒子发出的 98644 个应答帧
+     * 中，【98644 个（100%）】的目的 MAC 都是标准广播 ff:ff:ff:ff:ff:ff
+     * （源 08:00:27:7f:f6:27）—— 盒子【完全不学习】请求的源 MAC，
+     * 应答地址是写死的广播，所以把源 MAC 归零不会让应答发错地方。
+     * 而它恰好是"原厂能做、我们没做"的差别之一。
+     * nb_mac 保留（诊断通道要打出来），只是不再写进以太头。 */
+    memset(f + 6, 0, 6);                /* src: 全零，与原厂一致 */
+    f[12] = 0x08;
+    f[13] = 0x00;
+
+    /* ---- IPv4 ---- */
+    f[NB_ETH_HDR + 0] = 0x45;           /* v4, IHL=5 */
+    f[NB_ETH_HDR + 1] = 0x00;
+    f[NB_ETH_HDR + 2] = (u8)(iplen >> 8);
+    f[NB_ETH_HDR + 3] = (u8)(iplen & 0xFF);
+    f[NB_ETH_HDR + 4] = (u8)(nb_ipid >> 8);
+    f[NB_ETH_HDR + 5] = (u8)(nb_ipid & 0xFF);
+    f[NB_ETH_HDR + 6] = 0x40;           /* DF，不分片 */
+    f[NB_ETH_HDR + 7] = 0x00;
+    f[NB_ETH_HDR + 8] = 0xFF;           /* TTL，与原厂一致 */
+    f[NB_ETH_HDR + 9] = 17;             /* proto = UDP */
+    /* 10..11：校验和稍后回填 */
+    /* 12..15：源地址 0.0.0.0（已是 0） */
+    memset(f + NB_ETH_HDR + 16, 0xFF, 4); /* 目的 255.255.255.255 */
+
+    c = nb_ip_cksum(f + NB_ETH_HDR, NB_IP_HDR);
+    f[NB_ETH_HDR + 10] = (u8)(c >> 8);
+    f[NB_ETH_HDR + 11] = (u8)(c & 0xFF);
+
+    /* ---- UDP ---- */
+    f[NB_UDP_OFF - 8] = (u8)(NB_SRC_PORT >> 8);
+    f[NB_UDP_OFF - 7] = (u8)(NB_SRC_PORT & 0xFF);
+    f[NB_UDP_OFF - 6] = (u8)(dport >> 8);
+    f[NB_UDP_OFF - 5] = (u8)(dport & 0xFF);
+    f[NB_UDP_OFF - 4] = (u8)(udplen >> 8);
+    f[NB_UDP_OFF - 3] = (u8)(udplen & 0xFF);
+    /* 校验和保持 0：UDP 校验和可选，原厂请求帧也是 0 */
+
+    memcpy(f + NB_UDP_OFF, payload, paylen);
+
+    nb_ipid++;
+    return nb_tx_len;
+}
+
+/* 发一个协议请求。返回 SMAPSendPacket 的结果（1 = 成功，-1 = SMAP 未初始化） */
+static int nb_send(const u8 *payload, int len)
+{
+    int r;
+
+    if (nb_build_frame(payload, len, NB_PORT) < 0)
+        return -1;
+
+    r = SMAPSendPacket(nb_tx, nb_tx_len);   /* [v24] 用本次算好的长度（256 起步） */
+    if (r < 0)
+        g_tx_err++; /* -1 = SmapIsInitialized==0：PHY/链路没起来，见上面的注释 */
+
+    return r;
+}
+
+/*
+ * 诊断通道：把一行纯文本以 UDP 40001 的裸帧广播出去。
+ *
+ * 为什么需要它：release 版 OPL 里 IOP 的 printf 没有输出目标（无 ps2link），
+ * 驱动在 IOP 里跑，成功失败全靠猜。有了这个通道，PC 只要和 PS2 同链路抓包
+ * （tools/netbox_diag_sniff.py），就能看到驱动走到哪一步。
+ * 端口与协议端口 40000 分开，不干扰。
+ */
+static void nb_diag(const char *msg)
+{
+    char buf[192];
+    int len;
+
+    len = sprintf(buf, "[NETBOX] %s\n", msg);
+    if (len <= 0 || len >= (int)sizeof(buf))
+        return;
+
+    if (nb_build_frame((const u8 *)buf, len, NB_DIAG_PORT) > 0)
+        SMAPSendPacket(nb_tx, nb_tx_len);   /* [v24] 用本次算好的长度 */
+}
+
+/* ------------------------------------------------------------------ */
+/* v13/v14：把"失败在哪一步"编码进 _start() 的返回值，直接显示在设置页上   */
+/*                                                                     */
+/* v12 的问题是：只要代码跑到最后就返回 MODULE_RESIDENT_END(0)，设置页   */
+/* 显示 "resident"，可读盘可能早就失败了 —— 下面这些完全不同的故障在屏幕 */
+/* 上长得一模一样：                                                     */
+/*   - PHY/链路没起来，帧根本出不去                                      */
+/*   - 发得出去但盒子没回（网线接反、盒子没上电、盒子不在这个网段）      */
+/*   - 收到帧了但被 rx_push 的 ethertype/端口过滤挡掉                    */
+/*   - 收到帧了、事务号/数据偏移却对不上                                 */
+/*   - 数据拿到了但内容错位                                              */
+/*                                                                     */
+/* v13 改成：任何"注册 BD 设备之前"的失败都【不驻留】，并把失败位置编码。 */
+/* v14 又补了两关（钩子自检、链路自检），并把链路状态一起编进去。        */
+/* v15 再把"寄存器级的收发现场"编进去 —— 起因是实机报回                  */
+/*     "FAIL stage=5 hook=0 link ok"：链路通、帧发得出去、一个回包都没有。 */
+/* 而 v14 的屏幕信息到这一步就到头了，其背后的三种原因要往三个完全不同的  */
+/* 方向修，屏幕上却一模一样：                                            */
+/*   (a) 盒子的应答根本没到 PS2 的 MAC/PHY   -> 查线/盒子/协议            */
+/*   (b) 帧到了 MAL，但以太网收帧带错误标志被 xfer.c 里一个【空 if】静默   */
+/*       丢掉                                -> MAC 双工/速率与实际链路不符 */
+/*   (c) 帧到了、也交给上层了，却没进钩子    -> 库/空桩问题               */
+/* v15 用四种"读寄存器得到"的量把 (a)(b)(c) 分开：                        */
+/*   1. PHY 的 PHYSTS（bit0 link / bit1 10M / bit2 全双工）+ PHY ID       */
+/*      —— 直接问 PHY。BMSR 的 link 位不可靠：PHY 不响应时 MDIO 常读回     */
+/*      0xFFFF、link 位就是 1（这正是"链路 OK"假阳性的来源）。           */
+/*   2. MAL 的 SMAP_R_RXFIFO_FRAME_CNT —— 硬件收帧计数，【不依赖中断】，   */
+/*      所以它一定是可信的参照：>0 就证明帧确实到过 PS2。                 */
+/*   3. EMAC3 INTR_STAT 的收发错误位（BAD_FCS / RUNT / OVERRUN / DEAD_0）  */
+/*      —— 区分"收到全是坏帧"和"根本没帧"。                              */
+/*   4. xfer.c 里新增的四个计数器 —— 区分"中断没跑"和"跑了但被丢"。        */
+/*                                                                     */
+/*     _start() 返回值 = 1000000 + stage*100000 + lk*10000               */
+/*                                 + rx*1000 + e*100 + hook             */
+/*                                                                     */
+/*   lk   = PHY 现场模式码：0 无链路 / 1 10M半 / 2 10M全 / 3 100M半 /     */
+/*          4 100M全 / 5 PHY 不响应                                      */
+/*   rx   = MAL 收帧摘要：0 一帧都没到过 PS2 / 1..8 现场压着 N 帧 /       */
+/*          9 有帧到过                                                  */
+/*   e    = 收帧错误类别：0 无 / 1 BD 丢帧 / 2 BAD_FCS / 3 短帧 /         */
+/*          4 其它收帧错 / 5 发帧错误（DEAD_0 等，帧没上线路）            */
+/*   hook = 钩子被调用次数（截到 99）                                    */
+/*   设置页解码成 "NetBox: FAIL noreply lk=1 rx=0 e=0 hk=0 (v15)"        */
+/*   其中 stage 名字（noreply/link/tx/...）直接印在标签上。               */
+/*                                                                     */
+/* stage 含义（v14 重新编号 —— v13 的 1/2 是假阳性，已合并重排；        */
+/* 编号顺序 = 实际检查顺序）：                                           */
+/*   1 = 钩子自检失败      -> netboxh 的导入被改写成空桩，收包路径是死的  */
+/*   2 = PHY 没有链路      -> 网线/对端/PHY 问题，先修物理层 ★最常见★     */
+/*   3 = MAC 全零          -> smap_init() 没跑完（EMAC3 地址寄存器没写）  */
+/*   4 = 一帧都发不出去    -> SmapIsInitialized==0                        */
+/*   5 = 发得出去但收不到任何回包 -> link 已在第 2 关确认过               */
+/*   6 = 收到回包但 IDENTIFY 没匹配上 -> 事务号或应答偏移不符             */
+/*   7 = 读 LBA0 失败      -> 扇区数据没拿到                             */
+/*   8 = LBA0 读到了但无 55AA 签名 -> 数据错位                           */
+/*   9 = 发了但收不到 + 自环自检结果 -> v19 新增，见 nb_loopback_selftest */
+/*       屏幕上那三个数是【自环】的读数，不是盒子的：                   */
+/*         收到过帧（fl bit19/bit22 置位或 nok>0）-> PS2 侧收包链路完好， */
+/*                                                    病在 PS2 之外      */
+/*         一帧都没有（全区 0）  -> PS2 自己就收不到帧，病在 MAC/MAL/BD  */
+/*       为什么自环读数可以直接用：走到 stage 9 的前提就是"盒子一个回包  */
+/*       都没有"，那时全部计数器本来就是 0，所以自环后读到的就是自环的。 */
+/* 返回 0 且设置页显示 resident = 自检全过（含真读 LBA0），BD 设备已注册  */
+/* ------------------------------------------------------------------ */
+
+#define NB_STAGE_HOOK     1
+#define NB_STAGE_LINK     2
+#define NB_STAGE_MAC      3
+#define NB_STAGE_TX       4
+#define NB_STAGE_NO_REPLY 5
+#define NB_STAGE_IDENTIFY 6
+#define NB_STAGE_READ0    7
+#define NB_STAGE_BOOTSIG  8
+#define NB_STAGE_LOOPBACK 9
+/*  10 = 内自环通了、PHY 自环没通 -> 病在 MII 接口或 PHY 数字部分，可修（v21）*/
+/*  11 = PHY 自环也通了 -> 剩下的只能是网线 / 对端盒子；附带监听结果（v21）    */
+/*       二者都复用 v18 的位布局，只是 g_rxd 里装的是【那个实验自己】的读数。   */
+#define NB_STAGE_PHYLPBK 10
+#define NB_STAGE_LISTEN  11
+/* [v23] 12 = 链路 + TX 体检。走到这里说明"两格自环通过、而且 A/B 窗口一帧
+ *        都没有"。这一格报的不是"又听了一遍"，而是三组硬信息：
+ *        TX FIFO 残留（帧有没有被 MAC 发出去）、PHY 的 link 状态、
+ *        PHY 有没有还停在 v21/v22 留下的自环里。
+ *        ★ 位布局与 stage 11 完全不同，见 nb_diag_pack_linkchk()。 */
+#define NB_STAGE_LINKCHK 12
+
+/* ------------------------------------------------------------------
+ * [v17] 链路诊断包 —— 失败时把「链路现场」整个编进返回值。
+ *
+ * 演进：v15 用十进制 5 段编码（stage/lk/rx/e/hook）；v16 为了装下 16 位
+ * PHYIDR1 改成位打包；v17 保留位打包，但把字段换成此刻更该看的四个量。
+ *
+ * 起因：v16 实机报回 "FAIL link PHY not DP83846 id1=0143 id2=BC" ——
+ * 这是当时列的三种可能里【最好的那一种】：PHY 在、MDIO 通、ID 合法，
+ * 只是它不是 National DP83846。也就是说 v16 那条"ID 必须等于 DP83846"
+ * 的判据太严，把自己拦住了（OPL 上游对 ID 不匹配的处理是"跳过 DP83846
+ * 专有的几条 workaround，继续往下走并 return 0"，并不判失败）。
+ *
+ * 判据放宽之后，真正要回答的问题只剩一句：**链路到底通没通、通在什么
+ * 速率什么双工**。因为 SMAPStart() 里那一行是
+ *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ * —— BMSR 报"有链路"时 InitPHY() 根本不跑，而 InitPHY() 里"算出 LinkMode
+ * + 把 FDX 写进 EMAC3 MODE1"这两件【任何 PHY 都必须做】的事就一起被跳过了
+ * （它们在 DP83846 那段 if 之外，本该人人执行）。
+ * 结果 MAC 停在 smap_init() 硬编码的 100M 全双工，与 PHY 实际模式可能不符
+ * => 收帧全部采样错 => "发得出去、一个回包都收不到"。
+ *
+ * 所以 v17 先主动补跑一次 PHY 初始化（smap_phy_reinit，导入编号 8），
+ * 失败时再把这四个量连同身份分类一起打包，由 EE 侧 src/gui.c 解回人话。
+ * 位布局（bit31 必须为 0，否则 gNetBoxStartRC 变负数、gui.c 分支全乱）：
+ *
+ *   bit30     = 1               标记：这是位打包诊断包
+ *   bit26..29 = stage  (1..15)  哪一关报的（NB_STAGE_*）
+ *   bit21..25 = code   (0..31)  诊断码，见 NB_D_*
+ *   bit13..20 = BMSR 低 8 位    ★含 bit5 ANCP / bit2 Link（MII 标准位）
+ *   bit5..12  = PHYSTS 低 8 位  含 link/10M/FDX（DP83846 扩展位，仅参考）
+ *   bit0..4   = LinkMode 低 5 位 驱动结算出的速率+双工
+ * ------------------------------------------------------------------ */
+#define NB_V17_MARK     0x40000000
+
+/* 诊断码。前 5 个回答"PHY 是谁"，后 4 个回答"链路通没通"。 */
+#define NB_D_PHY_DP83846   0 /* PHY ID = DP83846（正常路径，不会报失败）      */
+#define NB_D_PHY_ALL_ZERO  1 /* PHYIDR1/2 全 0x0000 —— MDIO 超时没完成        */
+#define NB_D_PHY_ALL_FFFF  2 /* 全 0xFFFF —— 数据线悬空，该地址上没有 PHY     */
+#define NB_D_PHY_OTHER     3 /* 合法 ID 但不是 DP83846（v16 实测就是这种）    */
+#define NB_D_PHY_MIXED     4 /* 一个 0 一个非 0 —— 需要人看原值               */
+#define NB_D_LINK_NO_PHY   5 /* 补跑之后 BMSR 仍全 0/全 F —— 这次读不可信     */
+#define NB_D_LINK_DOWN     6 /* 补跑之后 BMSR.link 仍为 0 —— 链路真的没起来   */
+#define NB_D_LINK_UP       7 /* 补跑之后 BMSR.link=1（不该走到失败，留给断言）*/
+#define NB_D_PHY_RST_STUCK 8 /* PHY 软复位没在第一次读就清位（InitPHY 早退）  */
+
+/*
+ * [v15] 失败现场快照。所有值都来自「读寄存器 / 读计数器」，无副作用。
+ *
+ * 为什么要专门做这件事：v14 实机报回的是 "FAIL stage=5 hook=0 link ok"。
+ * 这句话把范围缩小到了"链路读着是通的、帧也发得出去，但一个回包都没进来"，
+ * 然而它背后的三种原因【要往三个完全不同的方向修】，而屏幕上看不出区别：
+ *   (a) 盒子的应答根本没到 PS2 的 MAC      -> 查线/盒子/协议
+ *   (b) 帧到了 MAL，但以太网收帧带错误标志被静默丢掉
+ *       -> MAC 的双工/速率与实际链路不符，或 PHY 其实没真正 link
+ *   (c) 帧到了、也交给上层了，却没进钩子   -> 库/空桩问题
+ * 这里的四组值正好把它们分开：
+ *   1. PHY 的 PHYSTS（bit0 link / bit1 10M / bit2 全双工）+ PHY ID
+ *      —— 这是【直接问 PHY】，比 BMSR 的 link 位可靠（PHY 不响应时 MDIO
+ *         常读回 0xFFFF，BMSR 的 link 位就是 1，正是"链路 OK"的假阳性来源）。
+ *         顺带回答了那个一开始就被忽略的问题：smap_init() 写进 MAC 的是
+ *         硬编码的 100M 全双工，而 InitPHY() 只在"BMSR 说没链路"时才被调用
+ *         —— 链路一开始就 up 的话，速度/双工从来没被协商过。
+ *   2. MAL 的 SMAP_R_RXFIFO_FRAME_CNT —— 硬件收帧计数，【不依赖中断】，
+ *      所以它一定是可信的参照：>0 就证明帧确实到过 PS2。
+ *   3. EMAC3 的 INTR_STAT（收发错误位）—— 区分"坏帧"和"没帧"。
+ *   4. HandleRxIntr 里新增的四个计数器 —— 区分"中断没跑"和"跑了但被丢"。
+ */
+static int          g_lk_code = 0;   /* PHY 链路模式码 0..5 */
+static unsigned int g_phy[10];       /* PHY 原始快照 */
+static unsigned int g_rxd[20];       /* 收发路径计数/错误位 */
+
+static void nb_snapshot(void)
+{
+    memset(g_phy, 0, sizeof(g_phy));
+    memset(g_rxd, 0, sizeof(g_rxd));
+
+    g_lk_code = smap_get_phy_dump(g_phy, 10);
+    smap_get_rx_diag(g_rxd, 20);
+}
+
+/* ------------------------------------------------------------------
+ * [v17] 链路现场诊断 —— 见文件上方 NB_V17_MARK 那段说明。
+ * ------------------------------------------------------------------ */
+
+static int          g_phy_code = NB_D_PHY_DP83846; /* 诊断码，见 NB_D_*   */
+static unsigned int g_link2[12];                   /* smap_phy_reinit 快照 */
+static int          g_link_rc = -1;                /* smap_phy_reinit 返回 */
+
+/* 把 stage/code/BMSR/PHYSTS/LinkMode 打进一个 int（布局见 NB_V17_MARK 注释）。
+ * bit31 恒为 0：EE 侧 gNetBoxStartRC 是 int，置了符号位就变负数，
+ * gui.c 的分支判断会全乱。 */
+static int nb_diag_pack(int stage, int code, unsigned int bmsr, unsigned int sts, unsigned int lm)
+{
+    unsigned int v;
+
+    v = (unsigned int)NB_V17_MARK
+        | ((((unsigned int)stage) & 0x0Fu) << 26)
+        | ((((unsigned int)code) & 0x1Fu) << 21)
+        | ((bmsr & 0xFFu) << 13)
+        | ((sts & 0xFFu) << 5)
+        | (lm & 0x1Fu);
+
+    return (int)v;
+}
+
+/* ------------------------------------------------------------------
+ * [v18] 收发现场打包 —— 「链路已证明是通的」之后该看的那一组数。
+ *
+ * 起因：v17 实机报回
+ *     "FAIL noreply [link ok lm=08 bmsr=2D] (v17)"
+ * 这一句已经把物理层彻底排除了：
+ *   lm=08    驱动结算出 100M 全双工，与 smap_init() 硬编码的一致
+ *   bmsr=2D  bit2（链路）与 bit5（自协商完成）都是 1 —— 不是 MDIO 悬空
+ *            读回 0xFFFF 那种假阳性
+ * 也就是说：链路真通了、帧也发得出去（第 4 关 SMAPSendPacket 返回 1），
+ * 却一个回包都没有。而背后还剩四种【修法完全不同】的病：
+ *
+ *   (a) DEV9/SMAP 中断根本没进来 —— 收包路径压根没被碰过
+ *       （中断没使能 / dev9 侧没接上 / SMAP 被别的实例重置了）
+ *   (b) MAL 里压着帧却没人取走 —— 中断没跑，或帧带着以太网收帧错误标志
+ *   (c) 帧取走了、却全是坏帧 —— 双工/速率与实际链路不符、线材、PHY 侧
+ *   (d) 所有计数都是 0 —— 帧压根没上线路，或者盒子真的没回
+ *
+ * v17 那四个字段（code/bmsr/sts/lm）走到这一步已经没有信息量了 ——
+ * 链路那一关过了之后它们是常量。所以 v18 把同样的位换成【收发路径计数器】，
+ * 一次 smap_get_rx_diag()（只读寄存器/读计数器，无副作用）就能全部拿到。
+ *
+ * ★ 布局选择不靠新标记位，而是靠 stage 本身 ★
+ *   stage == NB_STAGE_LINK(2) -> 用 nb_diag_pack() 的 v17 语义
+ *                                （那时 bmsr/lm 正是要看的量）
+ *   stage 为其它值            -> 用本函数的 v18 语义
+ *                                （那时链路已过，该看收发计数）
+ *   这样两边共用同一组位、不需要额外的判别位，也就不可能与 v17 撞车 ——
+ *   曾经考虑过加一个标记位，但 bits 0..30 在 v17 布局里全被占满，
+ *   任何"空闲位"其实都会被 v17 的某个字段踩到（stage 8 会踩 bit29、
+ *   code 8 会踩 bit24）。按 stage 分流是唯一不会自相矛盾的方案。
+ *
+ * 位布局（bit31 必须为 0，否则 gNetBoxStartRC 变负数、gui.c 的分支全乱）：
+ *   bit30     = 1                打包标记（与 v17 相同）
+ *   bit26..29 = stage  1..15     哪一关报的（NB_STAGE_*）—— 与 v17 同位置
+ *   bit19..24 = flags  6 位观察位，每一位 = "某个计数器非 0"：
+ *                                 bit19 DEV9 中断回调被调用过
+ *                                 bit20 RXEND（收到帧）事件出现过
+ *                                 bit21 HandleRxIntr() 跑过
+ *                                 bit22 RXFIFO_FRAME_CNT 读到过 > 0
+ *                                 bit23 有帧因 BD 错误标志被丢（原值走诊断通道）
+ *                                 bit24 发送 FIFO 里还压着帧（没发完）
+ *   bit16..18 = errcode  0..5    驱动算好的收/发帧错误分类（g_rxd[18]）
+ *   bit10..15 = nrx      0..63   MAL 里还没被取走的帧数（硬件计数，不依赖中断）
+ *   bit4..9   = nok      0..63   真正交给收帧钩子的帧数（= 钩子调用次数）
+ *   bit2..3   = nbad     0..3    因 BD 错误标志被丢掉的帧数
+ *   bit0..1   = txst     0..3    发送引擎：0 空闲 / bit0 = TxMODE0 的 GNP 位
+ *                                挂着（帧根本没上线路）/ bit1 = 有发帧错误位
+ *                                （DEAD_0・TX_ERR・SQE_ERR，即
+ *                                 "引擎试着发了、线路侧报死"）
+ *   bit25     = 保留 0
+ *
+ * 读法（一张表就能定位）：
+ *   flags 说没中断 & nrx==0  -> (a)：收包路径压根没动过
+ *   nrx>0 & nok==0           -> (b)：帧到了 MAL 却没人取走
+ *   nbad>0 或 errcode!=0     -> (c)：帧到了但全是坏的 -> 查双工/速率/线材
+ *   txst!=0                  -> 发送侧就没把帧送上线 -> 先修发送
+ *   全 0 且 flags==0         -> (d)：帧没上线或盒子真的没回
+ * ------------------------------------------------------------------ */
+
+static int nb_diag_pack18(int stage)
+{
+    unsigned int v = (unsigned int)NB_V17_MARK; /* 同一个打包标记 */
+    unsigned int nrx, nok, nbad, err, tx, fl = 0;
+
+    /* g_rxd[] 由 nb_snapshot() 填好，索引见 smap-ingame/smap.c 的 smap_get_rx_diag：
+     *   0 MAL RXFIFO 帧计数   1 TXFIFO 帧计数    3 EMAC3 标志累计 OR
+     *   4 中断回调次数        5 RXEND 次数        7 HandleRxIntr 次数
+     *   8 看到 FRAME_CNT>0 的次数   9 交给钩子的帧数   10 丢掉帧数
+     *   11 第一条丢帧的 ctrl_stat   13 EMAC3 TxMODE0（bit31 = GNP）
+     *   18 错误分类（0 无 / 1 BD 丢帧 / 2 BAD_FCS / 3 短帧 / 4 其它收帧错 /
+     *                5 发帧错误） */
+    nrx  = (g_rxd[0] > 63u) ? 63u : g_rxd[0];
+    nok  = (g_rxd[9] > 63u) ? 63u : g_rxd[9];
+    nbad = (g_rxd[10] > 3u) ? 3u : g_rxd[10];
+    err  = (g_rxd[18] > 7u) ? 7u : g_rxd[18];
+
+    if (g_rxd[4])
+        fl |= 1u;  /* bit19 */
+    if (g_rxd[5])
+        fl |= 2u;  /* bit20 */
+    if (g_rxd[7])
+        fl |= 4u;  /* bit21 */
+    if (g_rxd[8])
+        fl |= 8u;  /* bit22 */
+    if (g_rxd[11])
+        fl |= 16u; /* bit23 */
+    if (g_rxd[1])
+        fl |= 32u; /* bit24 发送 FIFO 还压着帧 */
+
+    /* 发送侧两个判据：
+     *   TxMODE0 的 bit31 = TX_GNP_0「挂着没发完」—— 描述符交了但引擎没动
+     *   errcode == 5     = 出现过 DEAD_0 / TX_ERR / SQE_ERR —— 引擎动了、
+     *                      线路侧报了死（PHY 侧根本没载波）
+     * 两者是"没启动"和"启动了但失败"，必须分开。 */
+    tx = (g_rxd[13] & 0x80000000u) ? 1u : 0u;
+    if (err == 5u)
+        tx |= 2u;
+
+    v |= ((((unsigned int)stage) & 0x0Fu) << 26)
+        | ((fl & 0x3Fu) << 19)
+        | ((err & 0x07u) << 16)
+        | ((nrx & 0x3Fu) << 10)
+        | ((nok & 0x3Fu) << 4)
+        | ((nbad & 0x03u) << 2)
+        | (tx & 0x03u);
+
+    return (int)v;
+}
+
+/* ------------------------------------------------------------------
+ * [v22] stage 11（对照窗口）专用的打包 —— 32 位里装"对端到底在不在回我们"。
+ *
+ * ★ 为什么另起一个打包函数而不是塞进 pack18 ★
+ *   pack18 装的是 v18 语义的收发计数器，而 stage 11 这一步要回答的问题
+ *   完全换了一个（不再问"PS2 收到没有"，而是问"对端有没有反应"）。
+ *   位布局按 stage 分流是这个通道一贯的做法（见 pack18 上面的说明），
+ *   所以这里整块重定义，而不是去挤 pack18 的字段。
+ *
+ * 位布局（与 src/gui.c 里 stage == 11 分支的注释【必须逐字一致】）：
+ *   bit0..7    nA      窗口 A（纯听）内 MAL 硬件收到的帧数（截到 255）
+ *   bit8..15   nB      窗口 B（发帧后）内 MAL 硬件收到的帧数（截到 255）
+ *   bit16..18  kind    首帧种类 0=无帧 1=广播 2=厂商多播(ff:34:43)
+ *                              3=其他多播 4=单播★（单播必然写着我们）
+ *   bit19..20  d3      首帧 (dst[3] >> 5) & 3（0x52->2 0x30->1 0x00->0 0xFF->3）
+ *   bit21      ip      首帧 EtherType == 0x0800（是个 IPv4 帧）
+ *   bit22      p4      首帧 UDP 目的端口 == 40000（我们协议的服务器端口）
+ *   bit23      box     首帧源 MAC 前 3 字节 == 08:00:27（盒子）
+ *   bit24      p3      首帧 UDP 源端口  == 30000（我们协议的客户端端口）
+ *   bit25      rp      ★ nB > nA + 1：发帧之后明显多出帧来 => 对端在回我们 ★
+ *   bit26..29  stage   （与 v17/v18 布局共用这个位置）
+ *   bit30      —       ★ 不能动：NB_V17_MARK = 0x40000000 就是这一位，
+ *                        是 gui.c 判"这是不是一个打包值"的标记位。
+ *                        （v22 第一版把 rp 放在这里，结果 rp 恒为 1，
+ *                          屏幕会永远显示"对端在回我们" —— 已挪到 bit25。）
+ *   bit31      0       （必须为 0：返回值是 int，置了符号位上面全乱）
+ *
+ * bit0..25 只有 26 位，而"种类 + 变体 + 三个协议判据 + 结论"一共要 9 位 ——
+ * 所以 d3 只留 2 位（够分开厂商实测的三个值）、EtherType 只留"是不是 IPv4"
+ * 一位。更细的（完整 dst/src MAC、真实端口号）走诊断通道的 v22 f0/f1/f2。
+ *
+ * 阈值取 nA+1 而不是 nA：单帧的抖动不算数，至少多两帧才认定"被触发"。
+ * ------------------------------------------------------------------ */
+static int nb_diag_pack_listen(int stage)
+{
+    unsigned int v = (unsigned int)NB_V17_MARK;
+    unsigned int na, nb, rp;
+
+    na = (g_listen_a > 255) ? 255u : (unsigned int)g_listen_a;
+    nb = (g_listen_b > 255) ? 255u : (unsigned int)g_listen_b;
+
+    rp = ((unsigned int)g_listen_b > (unsigned int)g_listen_a + 1u) ? 1u : 0u;
+
+    v |= (na << 0)
+       | (nb << 8)
+       | ((g_f_kind & 0x07u) << 16)
+       | ((g_f_d3   & 0x03u) << 19)
+       | ((g_f_et   & 0x01u) << 21)
+       | ((g_f_p4   & 0x01u) << 22)
+       | ((g_f_u    & 0x01u) << 23)
+       | ((g_f_p3   & 0x01u) << 24)
+       | (rp << 25)
+       | ((((unsigned int)stage) & 0x0Fu) << 26);
+
+    return (int)v;
+}
+
+/* ------------------------------------------------------------------
+ * [v23] stage 12 —— 「链路 + TX」体检
+ *
+ * 为什么要有这一格：v22 实机报 "RX SILENT 0 frames"。
+ * 而 2026-09-23 的真值抓包（NETBOX_REFERENCE_FRAMES.md §2）写明：
+ * **盒子单独接 PC 时一个包都不发** —— 它是"静默监听、只在收到正确探测后
+ * 才应答"的设计。所以"纯听窗口 0 帧"是【符合预期】的，它既不能证明线坏、
+ * 也不能证明盒子没工作。上一轮把 SILENT 读成"线/盒子"偏重了。
+ *
+ * 真正还没被验证过的是另外两件事：
+ *   (a) **我们发出去的帧到底有没有上线路** —— 参考帧文档 §6 记着
+ *       "我们的构建在 PS2 侧抓到 0 帧"，而发送侧一律返回 1。
+ *       查法：SMAP_R_TXFIFO_FRAME_CNT（"发送队列里还没发完的帧数"）。
+ *       发完等 120ms 它还不是 0  =>  MAC 压根没把帧取走。
+ *   (b) PHY 到底停在什么状态 —— 尤其是 v21/v22 那两次 PHY 自环实验留下的
+ *       BMCR bit14 有没有真的清掉（没清掉的话线上一帧都进不来）。
+ *
+ * 位布局（与 src/gui.c 里 stage == 12 分支的注释【必须逐字一致】）：
+ *   bit0      link1    smap_phy_reinit() 报的 LinkStatus（做完完整恢复之后）
+ *   bit1      link2    之后再读一次 BMSR 的 link 位（判它稳不稳）
+ *   bit2      lp_stuck BMCR 回读 bit14 仍为 1 => PHY 还停在自环里（致命）
+ *   bit3      aneg     BMSR bit5 自协商完成
+ *   bit4      spd100   LinkMode 报的是 100M（>0x0C 或 0x0A 组）
+ *   bit5      fdx      LinkMode 报的是全双工
+ *   bit6      flow     LinkMode 的流控位（0x40）
+ *   bit7      partner  ANLPAR 有效（不是 0 也不是 0xFFFF => 真有活对端）
+ *   bit8      txq10    stage 10 发完 120ms 后 TX FIFO 仍有残留 => TX 卡住
+ *   bit9      txq11    stage 11 窗口 B 发完后 TX FIFO 仍有残留
+ *   bit10     fcscr_nz FCSCR != 0
+ *   bit11     recr_nz  RECR != 0
+ *   bit12..15 bmsr_lo  BMSR 低 4 位（原始值，人工判读用）
+ *   bit16..19 sts_lo   PHYSTS 低 4 位
+ *   bit20..23 anlpar_lo ANLPAR 低 4 位（0 = 对端什么都没说）
+ *   bit24     phy_gone PHYIDR1/PHYIDR2 都是 0xFFFF（该地址上没有 PHY）
+ *   bit25     0        保留
+ *   bit26..29 stage    （与其它 stage 共用这个位置）
+ *   bit30     MARK     打包标记（NB_V17_MARK，绝不能被别的字段占用）
+ *   bit31     0        必须为 0
+ * ------------------------------------------------------------------ */
+#define NB_BMCR_LPBK_BIT (1u << 14) /* BMCR bit14 = Loopback（802.3）*/
+
+static int nb_diag_pack_linkchk(int stage)
+{
+    unsigned int v = (unsigned int)NB_V17_MARK;
+    unsigned int bmcr    = g_pc[0] & 0xFFFFu;
+    unsigned int bmsr    = g_pc[1] & 0xFFFFu;
+    unsigned int sts     = g_pc[2] & 0xFFFFu;
+    unsigned int fcscr   = g_pc[3] & 0xFFFFu;
+    unsigned int recr    = g_pc[4] & 0xFFFFu;
+    unsigned int anlpar  = g_lk[5] & 0xFFFFu;
+    unsigned int lm      = g_lk[8];
+    unsigned int idr1    = g_lk[2] & 0xFFFFu;
+    unsigned int idr2    = g_lk[3] & 0xFFFFu;
+
+    v |= (((g_lk[9] != 0u) ? 1u : 0u) << 0)
+       | ((((bmsr & 0x0004u) != 0u) ? 1u : 0u) << 1)   /* BMSR bit2 = Link */
+       | ((((bmcr & NB_BMCR_LPBK_BIT) != 0u) ? 1u : 0u) << 2)
+       | ((((bmsr & 0x0020u) != 0u) ? 1u : 0u) << 3)   /* BMSR bit5 = AN 完成 */
+       /* LinkMode：bit0..3 编码 1:10M半 2:10M全 4:100M半 8:100M全，bit6 = 流控 */
+       | ((((lm & 0x0Cu) != 0u) ? 1u : 0u) << 4)
+       | ((((lm & 0x0Au) != 0u) ? 1u : 0u) << 5)
+       | ((((lm & 0x40u) != 0u) ? 1u : 0u) << 6)
+       | (((anlpar != 0u && anlpar != 0xFFFFu) ? 1u : 0u) << 7)
+       | (((g_txq10 != 0) ? 1u : 0u) << 8)
+       | (((g_txq11 != 0) ? 1u : 0u) << 9)
+       | (((fcscr != 0u && fcscr != 0xFFFFu) ? 1u : 0u) << 10)
+       | (((recr  != 0u && recr  != 0xFFFFu) ? 1u : 0u) << 11)
+       | ((bmsr & 0x0Fu) << 12)
+       | ((sts  & 0x0Fu) << 16)
+       | ((anlpar & 0x0Fu) << 20)
+       | ((((idr1 == 0xFFFFu && idr2 == 0xFFFFu) ? 1u : 0u)) << 24)
+       | ((((unsigned int)stage) & 0x0Fu) << 26);
+
+    return (int)v;
+}
+
+/*
+ * [v16→v17] PHY 身份分类 —— 只分类，不再判失败。
+ *
+ * v16 时这个函数在"ID 不是 DP83846"时【直接终止启动】。v16 的实机结果证明
+ * 那是错的：本机这颗 PHY 的 ID 是 0x0143BCxx —— 合法 OUI、不是 0xFFFF 也不是 0,
+ * 只是不是 National DP83846。而 OPL 上游对非 DP83846 的 PHY 本来就是容忍的：
+ * InitPHY() 里那几段 DP83846 专有 workaround 被跳过，函数照样往下算完
+ * LinkMode 并 return 0。所以"ID 不是 DP83846"只是一条信息，不是错误。
+ *
+ * 只有"真的读不到 PHY"（全 0 = MDIO 超时 / 全 F = 数据线悬空 / 半读回）
+ * 才算异常；而且异常也不在这里终止 —— 交给后面的链路闸用 BMSR 去判，
+ * 因为那个判据更靠近"帧到底能不能收发"这个真问题。
+ */
+static void nb_phy_identify(void)
+{
+    unsigned int idr1, idr2;
+    int rc;
+
+    memset(g_phy, 0, sizeof(g_phy));
+    rc = smap_get_phy_dump(g_phy, 10); /* rc==5 就是"ID 不匹配 DP83846" */
+    idr1 = g_phy[2] & 0xFFFFu;
+    idr2 = g_phy[3] & 0xFFFFu;
+
+    if (rc != 5) {
+        g_phy_code = NB_D_PHY_DP83846;
+    } else if (idr1 == 0xFFFFu && idr2 == 0xFFFFu) {
+        g_phy_code = NB_D_PHY_ALL_FFFF; /* 数据线悬空，该地址上没有 PHY */
+    } else if (idr1 == 0u && idr2 == 0u) {
+        g_phy_code = NB_D_PHY_ALL_ZERO; /* MDIO 轮询超时，没完成 */
+    } else if (idr1 == 0u || idr2 == 0u) {
+        g_phy_code = NB_D_PHY_MIXED; /* 半读回，需要人看原值 */
+    } else {
+        g_phy_code = NB_D_PHY_OTHER; /* 合法 ID、不是 DP83846（实测就是这样）*/
+    }
+}
+
+/*
+ * ★v17 的核心★ 先把 PHY 初始化补跑一遍，再用 MII 标准位判链路。
+ *
+ * 为什么必须"先补跑"：SMAPStart() 里那一行是
+ *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ * BMSR 报"有链路"时 InitPHY() 根本不跑；而 InitPHY() 里
+ * 「算 LinkMode + 把 FDX/流控写进 EMAC3 MODE1」这两件【任何 PHY 都必须做】
+ * 的事，正好在 DP83846 那段 if 之外 —— 本该人人执行，却跟着一起被跳过。
+ * 而 BMSR 的 link 位有两个假阳性来源：
+ *   - PHY 不响应时 MDIO 数据线悬空、读回 0xFFFF，bit2 恰好是 1；
+ *   - 链路刚插上、自协商还没跑完的那一瞬间，bit2 也会是 1。
+ * 于是 MAC 停在 smap_init() 硬编码的 100M 全双工，与 PHY 实际模式可能不符
+ * => 收帧全部采样错 => "发得出去、一个回包都收不到"。
+ * 这也正是 xfer.c 里那条"收帧带错误标志 -> 空 if 静默丢弃"的另一半。
+ *
+ * 调 smap_phy_reinit() 之后：
+ *   - 链路已 up 且自协商完成 -> 它只做 MAC 侧对齐，不打断链路；
+ *   - 否则 -> 老老实实跑完整 InitPHY()（软复位 / 自协商 / 手动 fallback）。
+ * 判链路【只看 BMSR】（MII 标准 bit2 = Link Status），不看 PHYSTS ——
+ * 后者是 DP83846 的扩展寄存器，本机这颗非 DP83846 的 PHY 上那几位含义
+ * 可能完全不同，拿它当判据会重演"假阳性"。
+ *
+ * 返回 1 = 链路可用；0 = 不可用（调用方用 nb_diag_pack 报出去）。
+ */
+static int nb_link_gate(void)
+{
+    unsigned int bmsr;
+    int i;
+
+    for (i = 0; i < 12; i++)
+        g_link2[i] = 0;
+    g_link_rc = smap_phy_reinit(g_link2, 12);
+
+    bmsr = g_link2[1] & 0xFFFFu;
+
+    if (bmsr == 0xFFFFu || bmsr == 0x0000u) {
+        /* 连 BMSR 都读不回来 —— 它的 link 位不能作依据。
+         * 这时最有用的信息是 nb_phy_identify() 已经判好的"PHY 在不在"：
+         *   - 那时读到过合法 ID（code != DP83846 那档的其它值）-> 说明
+         *     PHY 在、只是这次 BMSR 单独读失败；
+         *   - 那时也是全 0/全 F -> 那本来就是"没 PHY"，保留那个更准的码。 */
+        if (g_phy_code == NB_D_PHY_DP83846)
+            g_phy_code = NB_D_LINK_NO_PHY;
+        return 0;
+    }
+
+    if ((bmsr & 0x0004u) == 0) {
+        /* BMSR bit2 为 0 = 真的没有链路。再分一层：
+         * smap_phy_reinit() 在 out[11] 的低 4 位带回细节 ——
+         *   1 = PHY 软复位那一步就没完成（RST 位一直不清）-> 查 PHY 与供电
+         *   2 = 复位完成了、自协商与手动 100M/10M 都试过，链路仍不 up
+         *       -> 查网线与对端
+         * 两者修法完全不同，不能混成一句话。 */
+        g_phy_code = ((g_link2[11] & 0x0Fu) == 1u) ? NB_D_PHY_RST_STUCK : NB_D_LINK_DOWN;
+        return 0;
+    }
+
+    g_phy_code = NB_D_LINK_UP;
+    return 1;
+}
+
+/*
+ * rx 字段（1 位数字）—— "帧到底有没有到过 PS2"：
+ *   0     = 完全没有：现场计数 0，且所有 RX 事件计数也都是 0
+ *   1..8  = 现场 MAL 里还压着 N 帧没被取走（上限 8）
+ *   9     = 有帧到过（被中断取走过），或压着 >=9 帧
+ * （原始数字仍在诊断通道/printf 里，屏幕上只放这个摘要。）
+ */
+static int nb_rx_summary(void)
+{
+    int n = (int)g_rxd[0];
+
+    if (n > 9)
+        n = 9;
+    if (n == 0 && (g_rxd[5] | g_rxd[7] | g_rxd[8] | g_rxd[9]) != 0)
+        n = 9;
+
+    return n;
+}
+
+/*
+ * 返回失败码给 IOP 装载器（= MODULE_NO_RESIDENT_END，模块随后被卸载）。
+ * 【钩子必须先摘掉】：钩子函数体在本模块里，模块一卸载，
+ * smap-ingame 之后每收一帧就会跳进已释放的代码 -> 必崩。
+ * smap-ingame 的 SmapPassRawFrame() 有 NULL 判断，摘掉就是干净的。
+ *
+ * 编码（v18 —— 布局随 stage 分流，见 nb_diag_pack18 的位布局表）：
+ *   stage == 2（链路关自己失败）: v17 语义
+ *       ret = 0x40000000 | stage<<26 | code<<21 | BMSR低8位<<13
+ *                        | PHYSTS低8位<<5 | LinkMode低5位
+ *   stage 为其它值（链路已过）: v18 语义
+ *       ret = 0x40000000 | stage<<26 | flags<<19 | errcode<<16
+ *                        | nrx<<10 | nok<<4 | nbad<<2 | txst
+ * 这一串是【整条链路上唯一免费的 IOP->EE 通道】：release 版 OPL 没有 ps2link，
+ * IOP 的 printf 没有输出目标，所以失败信息只能挤在返回值里。
+ * 原始数字（不截断）另外走 UDP 40001 诊断通道，见上面那三行 nb_diag()。
+ */
+static int nb_fail(int stage)
+{
+    char msg[192];
+    int  hooks = g_hook_calls;
+    int  rxq;
+    unsigned int bmsr, sts, lm;
+
+    if (hooks > 99)
+        hooks = 99;
+
+    /* 先抓现场（读寄存器/计数器，无副作用），再摘钩子 —— 摘掉之后 smap 那边
+     * 就不再更新计数器了。 */
+    nb_snapshot();
+    rxq = nb_rx_summary();
+
+    /* 链路现场优先用 smap_phy_reinit() 的那一份 —— 它记的是"补跑 InitPHY
+     * 之后"的寄存器值，而 g_phy 是补跑之前的快照。没走到链路闸就失败的
+     * （stage=1，钩子自检都没过）才退回 g_phy。 */
+    if (g_link_rc >= 0) {
+        bmsr = g_link2[1] & 0xFFFFu;
+        sts  = g_link2[6] & 0xFFFFu;
+        lm   = g_link2[8] & 0xFFu;
+    } else {
+        bmsr = g_phy[1] & 0xFFFFu;
+        sts  = g_phy[7] & 0xFFFFu;
+        lm   = (unsigned int)g_lk_code;
+    }
+
+    /* 摘钩子：函数体在本模块里，模块卸载后 smap 每收一帧跳进来必崩。 */
+    smap_set_rx_hook(NULL);
+
+    /* 诊断通道（PC 抓 UDP 40001）。只有发帧真通时才能收到，所以这里是
+     * "锦上添花"；上屏那条（_start 的返回值）才是主通道。 */
+    sprintf(msg, "FAIL stage=%d code=%d bmsr=%04x sts=%04x lm=%02x -> not resident",
+            stage, g_phy_code, bmsr, sts, lm);
+    nb_diag(msg);
+
+    sprintf(msg, "link rc=%d bmcr=%04x anar=%04x anlpar=%04x aner=%04x emac3fdx=%u",
+            g_link_rc, g_link2[0] & 0xFFFFu, g_link2[4] & 0xFFFFu,
+            g_link2[5] & 0xFFFFu, g_link2[10] & 0xFFFFu, g_link2[7] & 1u);
+    nb_diag(msg);
+
+    sprintf(msg, "rxq=%u txq=%u ok=%u bad=0x%04x rxintr=%u wait=%u hk=%d",
+            g_rxd[0], g_rxd[1], g_rxd[9], g_rxd[11], g_rxd[7], g_rxd[8], hooks);
+    nb_diag(msg);
+
+    /* [v18] 上屏那 32 位是挤出来的，只放得下摘要；原始数字走诊断通道。
+     * 这一行是"屏幕上那个摘要"的注解，对照 NB_D 那段位布局读。 */
+    sprintf(msg, "v18 intr=%u/%u/%u/%u ok=%u bad=%u err=%u txfifo=%u gnp=%u",
+            g_rxd[4], g_rxd[5], g_rxd[7], g_rxd[8], g_rxd[9], g_rxd[10],
+            g_rxd[18], g_rxd[1], (g_rxd[13] & 0x80000000u) ? 1u : 0u);
+    nb_diag(msg);
+
+    printf("netbox: FAIL stage=%d code=%d bmsr=0x%04x sts=0x%04x lm=0x%02x (not resident)\n",
+           stage, g_phy_code, bmsr, sts, lm);
+
+    /* 布局按 stage 分流（见 nb_diag_pack18 的说明）：
+     *   链路那一关自己失败 -> v17 语义，bmsr/sts/lm 才是要看的量
+     *   链路已过、后面任一步失败 -> v18 语义，看收发路径计数器
+     * 两边共用同一组位，靠 stage 区分，不需要额外的标记位。 */
+    if (stage == NB_STAGE_LINK)
+        return nb_diag_pack(stage, g_phy_code, bmsr, sts, lm);
+
+    /* [v22] stage 11 装的不再是 v18 计数器，而是"对端有没有在回我们"
+     * 那一组（A/B 计数 + 首帧身份），位布局见 nb_diag_pack_listen()。 */
+    if (stage == NB_STAGE_LISTEN)
+        return nb_diag_pack_listen(stage);
+
+    /* [v23] stage 12 装的是"链路 + TX"体检：TX FIFO 残留 / link 状态 /
+     * link 速率双工 / 对端能力 / PHY 有没有还卡在自环里。
+     * 位布局见 nb_diag_pack_linkchk()。 */
+    if (stage == NB_STAGE_LINKCHK)
+        return nb_diag_pack_linkchk(stage);
+
+    return nb_diag_pack18(stage);
+}
+
+/*
+ * [v17 已删除 nb_wait_link()] —— 它原来是"读 smap_get_link_status() 最多等 3 秒"
+ * 的被动观察者。v17 换成 nb_link_gate()：先主动把 PHY 初始化补跑一遍
+ * （smap_phy_reinit()，因为 SMAPStart() 在 BMSR 报有链路时会跳过 InitPHY()，
+ * 而 InitPHY() 里"算 LinkMode + 写 EMAC3 FDX"这两件任何 PHY 都必须做的事
+ * 就跟着被跳过了），再用同一份快照里的 BMSR 判链路。
+ * 被动等 3 秒读到的还是那个可能为假的 BMSR 位，主动补跑才有意义。
+ * smap_get_link_status 的导入仍保留（编号 4，不在任何路径上移除，
+ * 保持 ordinal 表稳定 —— 见 tools/irx_ordinal_check.py）。 */
+
+/*
+ * v13：确认 SMAP 真的能发帧。
+ *
+ * SMAPSendPacket() 在 SmapIsInitialized==0 时返回 -1 且什么都不发。这个状态
+ * 只由 SMAPStart() 里 PHY up 之后置位，而 SMAPStart() 的返回值在
+ * smap-ingame 的 SMapIFInit() 里被丢掉了 —— 所以这里自己探一遍。
+ *
+ * 探针帧就是握手的第一条记录（R:FF00），不是垃圾数据：即使盒子收到它，
+ * 也只是正常握手序列的第一步。
+ *
+ * 【为什么不在这里调 SMAPStart() 重试】链路真的不通时 InitPHY() 会在
+ * 自动协商里长时间阻塞（甚至 goto 重来），在菜单初始化路径上反复调用
+ * 会把 OPL 卡死。所以这里只观察、只报告。
+ */
+static int nb_probe_tx(void)
+{
+    /* [v27] 这一帧必须带 HP 帧头，不能发裸记录。
+     *
+     * v26 及以前这里发的是裸的 6 字节 "55aa HR ff00" —— 没有 55aa HP 头，
+     * UDP 长度只有 14。capG 的同场 A/B 实测：原厂 6930 个请求帧里
+     * 【从来没有】这种无头帧（原厂最小的 UDP 长度是 26），只有我们发，
+     * 而且它是握手的第一步、排在所有正常帧之前。
+     *
+     * 两边其后 8 个握手帧是逐字节相同的（连 HP/HR/HW/HB 记录流和帧长 256
+     * 都一样，只有 HF 不同），却只有原厂能换来盒子的应答；HF 又已经被
+     * netbox_hf_ab.py 排除（取原厂真值 309 也一样零回应）。所以这个多
+     * 出来的无头帧是最后一个未被排除的差异 —— 先把它补成合法帧。 */
+    static const u8 probe[] = {
+        NB_SYNC0, NB_SYNC1, NB_T_CMD, NB_C_P, 0x00, 0x06,   /* 55aa HP 0006 */
+        NB_SYNC0, NB_SYNC1, NB_T_CMD, NB_C_R, 0xFF, 0x00    /* 55aa HR ff00 */
+    };
+    int i;
+
+    for (i = 0; i < 20; i++) { /* 20 x 100ms = 2s */
+        if (nb_send(probe, (int)sizeof(probe)) == 1)
+            return 1;
+        DelayThread(100 * 1000);
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* 请求构造                                                            */
+/* ------------------------------------------------------------------ */
+
+static void put_rec(u8 *b, int *off, u8 type, u8 cmd, u16 param)
+{
+    b[(*off)++] = NB_SYNC0;
+    b[(*off)++] = NB_SYNC1;
+    b[(*off)++] = type;
+    b[(*off)++] = cmd;
+    b[(*off)++] = (u8)(param >> 8);
+    b[(*off)++] = (u8)(param & 0xFF);
+}
+
+/* 注意：put_rec 的第二参数是 int*（要回填偏移），所以宏里必须取地址 &off。
+ * 只应在声明了 (u8 *b, int off) 的函数体内使用。 */
+#define W(reg, val) put_rec(b, &off, NB_T_CMD, NB_C_W, (u16)(((reg) << 8) | ((val) & 0xFF)))
+#define R(reg)      put_rec(b, &off, NB_T_CMD, NB_C_R, (u16)(((reg) << 8)))
+
+/*
+ * 构造一个读请求。布局与抓包完全一致（已用两条真实抓包逐字节验证过）：
+ *   P | R:0f00 | B:8000 | W:0e40 | 高32位LBA(0b,0c,0d) + count高(0a)
+ *     | 低32位LBA(0b,0c,0d) + count低(0a) | W:0f24 | R:0f00 | R:f200 | F:txn
+ *     | count × (B:8000 B:0808 L:01ff F:txn+k)
+ */
+static int nb_build_read(u8 *b, int max, u64 lba, u16 count, u16 txn, u8 ata_cmd)
+{
+    int off = 0, p_off, i;
+
+    if (count == 0 || count > NB_MAX_SECTORS)
+        return -1;
+    if (max < (int)(NB_P_PARAM(count) + NB_REC_SIZE))
+        return -1;
+
+    p_off = off;
+    put_rec(b, &off, NB_T_CMD, NB_C_P, 0); /* 占位，最后回填 */
+
+    R(NB_REG_CMD);                         /* 读状态寄存器 */
+    put_rec(b, &off, NB_T_CMD, NB_C_B, 0x8000);
+    W(NB_REG_DEV, NB_DEV_LBA_MASTER);
+
+    /* 先写高 32 位（对应 ATA 48-bit 的第一次写入） */
+    W(NB_REG_LBA0, (u8)((lba >> 24) & 0xFF));
+    W(NB_REG_LBA1, (u8)((lba >> 32) & 0xFF));
+    W(NB_REG_LBA2, (u8)((lba >> 40) & 0xFF));
+    W(NB_REG_COUNT, (u8)((count >> 8) & 0xFF));
+
+    /* 再写低 32 位 */
+    W(NB_REG_LBA0, (u8)((lba >> 0) & 0xFF));
+    W(NB_REG_LBA1, (u8)((lba >> 8) & 0xFF));
+    W(NB_REG_LBA2, (u8)((lba >> 16) & 0xFF));
+    W(NB_REG_COUNT, (u8)((count >> 0) & 0xFF));
+
+    W(NB_REG_CMD, ata_cmd);                /* 0x24 READ SECTORS EXT / 0xEC IDENTIFY */
+
+    R(NB_REG_CMD);
+    R(NB_REG_ALT);
+    put_rec(b, &off, NB_T_CMD, NB_C_F, txn); /* 提交 */
+
+    /* count 个轮询块，每个块拿到一个扇区 */
+    for (i = 1; i <= count; i++) {
+        put_rec(b, &off, NB_T_CMD, NB_C_B, 0x8000);
+        put_rec(b, &off, NB_T_CMD, NB_C_B, 0x0808);
+        put_rec(b, &off, NB_T_CMD, NB_C_L, 0x01FF);
+        put_rec(b, &off, NB_T_CMD, NB_C_F, (u16)(txn + i));
+    }
+
+    /* 回填 P: 本记录之后的字节数 */
+    b[p_off + 4] = (u8)((off - NB_REC_SIZE) >> 8);
+    b[p_off + 5] = (u8)((off - NB_REC_SIZE) & 0xFF);
+
+    return off;
+}
+
+#undef W
+#undef R
+
+static u16 g_txn = 1;
+
+/* ------------------------------------------------------------------ */
+/* 通用构造器 + 开机握手序列                                            */
+/* ------------------------------------------------------------------ */
+
+typedef struct {
+    u8  type;
+    u8  cmd;
+    u16 param;
+} nb_rec_t;
+
+/* 构造 P + recs[0..n-1] + F:txn，P 的 param 自动回填 */
+static int nb_build_generic(u8 *b, int max, const nb_rec_t *recs, int n, u16 txn)
+{
+    int off = 0, p_off, i;
+
+    if (max < (int)((n + 2) * NB_REC_SIZE))
+        return -1;
+
+    p_off = off;
+    put_rec(b, &off, NB_T_CMD, NB_C_P, 0);
+    for (i = 0; i < n; i++)
+        put_rec(b, &off, recs[i].type, recs[i].cmd, recs[i].param);
+    put_rec(b, &off, NB_T_CMD, NB_C_F, txn);
+
+    b[p_off + 4] = (u8)((off - NB_REC_SIZE) >> 8);
+    b[p_off + 5] = (u8)((off - NB_REC_SIZE) & 0xFF);
+    return off;
+}
+
+#define NB_T NB_T_CMD
+/*
+ * PS2 开机握手序列 —— 2026-09-23 实机开机抓包逐帧还原。
+ * PS2 上电后 42ms 内连续发完这 7 帧，然后才发 IDENTIFY 和第一个读扇区。
+ * 事务号从 0x011c 起连续递增，每帧 1 个。
+ */
+static const nb_rec_t NB_HS0[] = {                                       /* P:001e */
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xFF00},
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xFF00},
+};
+static const nb_rec_t NB_HS1[] = {                                       /* P:0018 */
+    {NB_T, NB_C_R, 0xFF00}, {NB_T, NB_C_R, 0xF000}, {NB_T, NB_C_R, 0xF100},
+};
+static const nb_rec_t NB_HS2[] = {{NB_T, NB_C_W, 0xFD01}};               /* 启用 */
+static const nb_rec_t NB_HS3[] = {{NB_T, NB_C_W, 0x1604}};               /* 复位拉高 */
+static const nb_rec_t NB_HS4[] = {{NB_T, NB_C_W, 0x1600}};               /* 复位拉低 */
+/* 注意：读 device 寄存器时 param 是 0x0E40（带 LBA+master 位），不是 0x0E00 */
+static const nb_rec_t NB_HS5[] = {{NB_T, NB_C_R, 0x0E40}, {NB_T, NB_C_R, 0x0F00}};
+static const nb_rec_t NB_HS6[] = {{NB_T, NB_C_R, 0x0E40}, {NB_T, NB_C_R, 0x0F00}};
+
+/* IDENTIFY DEVICE 请求（注意：结构与读扇区不同，没有 LBA 写入）        P:0036 */
+static const nb_rec_t NB_IDENTIFY[] = {
+    {NB_T, NB_C_W, 0x0E40}, {NB_T, NB_C_B, 0x8000},
+    {NB_T, NB_C_W, 0x0FEC}, {NB_T, NB_C_R, 0x0F00},
+    {NB_T, NB_C_B, 0x8000}, {NB_T, NB_C_B, 0x0808},
+    {NB_T, NB_C_R, 0x0F00}, {NB_T, NB_C_L, 0x01FF},
+};
+#undef NB_T
+
+static int nb_send_recs(const nb_rec_t *recs, int n)
+{
+    static u8 req[512];
+    int len = nb_build_generic(req, sizeof(req), recs, n, g_txn);
+
+    if (len < 0)
+        return -1;
+    g_txn = (u16)(g_txn + 1);
+    return nb_send(req, len);
+}
+
+/* ------------------------------------------------------------------
+ * [v19] 自环自检 —— 让 PS2 自己发一帧，再看它能不能自己收回来。
+ *
+ * 为什么必须有它（v18 实机结果）：
+ *     "FAIL noreply NO RX IRQ at all fl=0 n=0 k=0 (v18)"
+ * 这一行的意思是：从 v14 到 v18，收侧【任何一项】都是 0 ——
+ *   nrx = SMAP_R_RXFIFO_FRAME_CNT = 0
+ *        （MAL 的硬件收帧计数，【不依赖中断】，所以这个 0 可信）
+ *   fl & 1 = nb_dbg_intr_cb == 0
+ *        （DEV9 中断回调【一次都没被调用过】）
+ *   nok = nb_dbg_rx_ok = 0（一个帧都没交给钩子）
+ * 而同一时间发送侧是干净的：TxMODE0 的 GNP 位没挂（否则会报 TX ENGINE
+ * STUCK）、没有 DEAD_0/TX_ERR_0/SQE_ERR_0（否则会报 TX DEAD CARRIER）。
+ * 也就是说：**帧发得出去，却一个都没进过 PS2 的 MAC。**
+ *
+ * 剩下两种可能，修法完全相反，在屏幕上却完全同形：
+ *   (A) PS2 自己收不了 —— MAC 收方向没使能 / 地址过滤 / MAL / BD / 中断
+ *   (B) 帧压根没到 PS2 —— 盒子没发、线或 PHY 的收方向坏、对端不认我们的帧
+ *
+ * 分开它们唯一的办法是不经过任何外部设备：把 EMAC3 的【内部自环】打开
+ * （MODE1 bit30 = SMAP_E3_INLPBK_ENABLE），MAC 的发送数据路径就在芯片内部
+ * 接回接收路径，不经过 PHY、不经过网线、不经过盒子。
+ * 于是这一条自环通路恰好覆盖我们关心的整串：
+ *   TX 描述符 -> EMAC3 TX -> 内部回环 -> EMAC3 RX 地址过滤 ->
+ *   MAL RX FIFO -> RXEND 中断 -> HandleRxIntr -> 收帧钩子
+ * 结果因此是干净的二分：
+ *   收到过帧 -> PS2 侧数字逻辑全好 -> 病在 (B)（去查盒子 / 线 / PHY 收方向）
+ *   一帧没有 -> 病在 (A)，且范围已缩到上面这一串（去修 MAC/MAL/中断）
+ *
+ * ★ 为什么不用 PHY 自环（BMCR bit14）★
+ *   本机早已用 MDIO 证明 PHY 是活的：v17 实机读回 BMSR=0x2D（bit2 链路 +
+ *   bit5 自协商完成，都是真值；MDIO 悬空只会读回 0xFFFF）、LinkMode=100M
+ *   全双工。所以要问的【不是】"PHY 好不好"，而是"MAC/MAL/中断 这一串好不好"。
+ *   把 PHY 包进来的话，一旦失败反而分不清是哪一段；内自环把它排除在外，
+ *   答案因此是二元的、可直接行动。
+ *
+ * ★ 为什么自环读数可以直接当"自环的结果"用 ★
+ *   走到这里的前提是 stage 5 已经判定【盒子一个回包都没有】，那时全部计数器
+ *   本来就是 0（v18 实机报的 fl=0 n=0 k=0 就是证据），所以自环后读到的数
+ *   就是自环自己的。为稳妥仍然对【累加型】计数器取增量（见下面 cum[]），
+ *   而读寄存器型的量（MAL 计数、INTR_STAT、各寄存器）保留现场值。
+ *
+ * ★ 为什么不按 HandleRxIntr 的返回值判断 ★
+ *   HandleRxIntr 只在中断里被调用，而"中断跑不跑"本身就是待测项之一。
+ *   所以判据直接读 MAL 的硬件计数（不依赖中断）与中断回调计数，两者分开看：
+ *     MAL 有帧 + 中断回调为 0 -> 帧到了 MAL 却没人取走（中断没接上）
+ *     MAL 有帧 + 中断回调 >0   -> 整条收包路径（含中断、钩子）全好
+ *     MAL 无帧 + 中断回调为 0  -> MAC 压根没把帧收下来（使能/过滤/BD）
+ *
+ * 顺序：开自环 -> 发 2 帧真协议帧 -> 等 -> 采集 -> 关自环。
+ * 无论成败都会把自环关掉，绝不把 SMAP 留在自环状态。
+ * ------------------------------------------------------------------ */
+static void nb_loopback_selftest(void)
+{
+    static unsigned int base[20];
+    static u8 req[512];
+    int i, len, saved_idx;
+
+    /* 1) 基线：先采一次，供累加型计数器取增量用。 */
+    nb_snapshot();
+    for (i = 0; i < 20; i++)
+        base[i] = g_rxd[i];
+
+    /* 2) 自环期间的目的 MAC 必须能被自己收下：用候选表里的标准广播那一项。
+     *    此刻 nb_dstmac_idx 正停在阶梯试到的那个 ff:34:43:xx 上，虽然它是
+     *    多播地址、RxMODE 里 RX_MCAST 也开着，但没有必要赌。
+     *    [v25] 广播项从第 0 位挪到了 NB_DSTMAC_BCAST，这里跟着改，
+     *    自环路径的行为与 v19~v24 逐字节相同。 */
+    saved_idx     = nb_dstmac_idx;
+    nb_dstmac_idx = NB_DSTMAC_BCAST;
+
+    if (smap_loopback_set(1) != 0) {
+        /* SMAP 从未初始化 —— 按前面 stage 4 的结论这不该发生，防一手。 */
+        nb_dstmac_idx = saved_idx;
+        return;
+    }
+
+    DelayThread(3 * 1000); /* 3ms：等自环位在 MAC 里生效 */
+
+    /* 3) 发两帧真协议帧（HS1 = 开机握手的第一帧）。走的是和真发完全一样的
+     *    TX 描述符 -> MAC 路径，只是出口被接到了自己身上。 */
+    g_txn = (u16)(g_txn + 1);
+    len   = nb_build_generic(req, (int)sizeof(req), NB_HS1,
+                             (int)(sizeof(NB_HS1) / sizeof(NB_HS1[0])), g_txn);
+    for (i = 0; i < 2 && len > 0; i++) {
+        nb_send(req, len);
+        DelayThread(5 * 1000); /* 5ms，和握手帧间隔一致 */
+    }
+
+    /* 4) 等自环帧走完 TX -> 回环 -> RX -> MAL -> 中断 -> 钩子 */
+    DelayThread(80 * 1000); /* 80ms */
+
+    /* 5) 采集现场 —— 此刻 g_rxd 里就是自环的结果 */
+    nb_snapshot();
+
+    /* 6) 只对【累加型】计数器取增量。索引见 smap_get_rx_diag 的 out[] 布局：
+     *      0 MAL 硬件收帧计数（RXFIFO_FRAME_CNT，读寄存器但语义是累计）
+     *      3 EMAC3 标志累计 OR      4 中断回调次数     5 RXEND 次数
+     *      6 EMAC3 事件次数          7 HandleRxIntr 次数 8 看到 FRAME_CNT>0 次数
+     *      9 交给钩子的帧数         10 因错误标志丢的帧数 11 第一条丢帧 ctrl_stat
+     *    不取增量的：1（TXFIFO_FRAME_CNT —— 是"队列里还剩几帧"的瞬时值，
+     *    减增量毫无意义，必须是现场读值）、2（INTR_STAT，读寄存器）、
+     *    12~17（各寄存器现场值）、18（错误分类，本身是分类结果）。
+     *    这份名单与 tools/diag_pack_roundtrip_check.py 的布局表必须一致。
+     *
+     * ★ v23 修：out[0] 从"不取增量"改成"取增量" ★
+     *   它是 MAL 硬件的【累计】收帧计数，一直在涨。v19 起把它排除在增量名单外，
+     *   于是 stage 9/10 的判据里它成了"自开机以来收过的所有帧"——只要前面
+     *   任何一格收过一帧，它就永远 > 0。那正是 v21/v22 "PHY 自环恒通过"、
+     *   v21 "线上 0 帧却报 HEARS BOX" 这两个假读数的共同根因。
+     *   现在它和别的累计量一样按窗口取增量，"窗口内收了几帧"才是判据。 */
+    {
+        static const int cum[] = {0, 3, 4, 5, 6, 7, 8, 9, 10, 11};
+        int k;
+
+        for (k = 0; k < (int)(sizeof(cum) / sizeof(cum[0])); k++) {
+            int j = cum[k];
+
+            g_rxd[j] = (g_rxd[j] >= base[j]) ? (g_rxd[j] - base[j]) : 0;
+        }
+    }
+
+    /* 7) 关自环、恢复目的 MAC。必须无条件执行 —— 不能让 SMAP 留在自环状态
+     *    （留着的话后面所有收发都只在芯片内部打转，现象更离奇）。 */
+    smap_loopback_set(0);
+    nb_dstmac_idx = saved_idx;
+
+    {
+        char msg[160];
+
+        sprintf(msg, "v20 loopback: mal=%u intr=%u rxend=%u rxintr=%u wait=%u ok=%u bad=%u",
+                g_rxd[0], g_rxd[4], g_rxd[5], g_rxd[7], g_rxd[8], g_rxd[9], g_rxd[10]);
+        nb_diag(msg);
+    }
+}
