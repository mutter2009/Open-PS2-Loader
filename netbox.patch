+
 void SMapLowLevelInput(struct pbuf *pBuf);
 
 #include "xfer.h"
diff --git a/modules/network/smap-ingame/smap.c b/modules/network/smap-ingame/smap.c
index f43eb20..2dac18e 100644
--- a/modules/network/smap-ingame/smap.c
+++ b/modules/network/smap-ingame/smap.c
@@ -674,3 +674,45 @@ int SMAPGetMACAddress(unsigned char *buffer)
 
     return 0;
 }
+
+/* ---------------------------------------------------------------------------
+ * [NETBOX] 读 PHY 的真实链路状态（netboxh 导出编号 4）。
+ *
+ * 为什么必须单独开这个口子：
+ *   SMAPStart() 里决定能不能发帧的是 SmapIsInitialized：
+ *       result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ *       if (result == 0 && !NetDevStopFlag) { ...; SmapIsInitialized = 1; }
+ *   而 InitPHY() 的每一条出口都是【无条件 return 0】（函数末尾），
+ *   它内部所有"等链路"的循环超时后也只是把 LinkStatus 置 0、继续往下走。
+ *   结论：**链路从来没起来时，InitPHY 照样"成功"，SmapIsInitialized 照样
+ *   是 1，SMAPSendPacket() 照样返回 1** —— 也就是发送成功完全不能证明
+ *   链路上有线。
+ *
+ *   所以我（netbox 驱动）在实机上看到 "hook=0（一个回包都没有）" 时，
+ *   无法从任何已有返回值区分下面这两种完全不同的情况：
+ *     (a) 网线/PHY 没有链路 —— 帧根本没出去，也没进来（要修物理层）
+ *     (b) 链路正常但盒子不回话（要查盒子/协议）
+ *   唯一可信的判据就是 PHY 的 BMSR 寄存器 bit2（SMAP_PHY_BMSR_LINK），
+ *   也就是 CheckLinkStatus() 每 5 秒查的那一位。这里把它交出来。
+ *
+ * 返回值：1 = 链路已建立，0 = 没链路。
+ *   pBMSR / pANLPAR / pLinkMode 可为 NULL。
+ *   LinkMode（InitPHY 填的）：bit0..3 = 1:10M半 2:10M全 4:100M半 8:100M全，
+ *   bit6 = 流控。链路不通时这个值没有意义。
+ * --------------------------------------------------------------------------- */
+int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode)
+{
+    volatile u8 *emac3_regbase = SmapDriverData.emac3_regbase;
+    u16 bmsr;
+
+    bmsr = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_BMSR);
+
+    if (pBMSR != NULL)
+        *pBMSR = bmsr;
+    if (pANLPAR != NULL)
+        *pANLPAR = _smap_read_phy(emac3_regbase, SMAP_DsPHYTER_ANLPAR);
+    if (pLinkMode != NULL)
+        *pLinkMode = SmapDriverData.LinkMode;
+
+    return (bmsr & SMAP_PHY_BMSR_LINK) ? 1 : 0;
+}
diff --git a/src/bdmsupport.c b/src/bdmsupport.c
index b181dec..153ed13 100644
--- a/src/bdmsupport.c
+++ b/src/bdmsupport.c
@@ -11,6 +11,7 @@
 #include "include/extern_irx.h"
 #include "include/cheatman.h"
 #include "include/sound.h"
+#include "include/ethsupport.h" // [NETBOX] 复用 OPL 的以太网初始化 ethLoadInitModules()
 #include "modules/iopcore/common/cdvd_config.h"
 
 #include <usbhdfsd-common.h>
@@ -23,6 +24,24 @@
 static int iLinkModLoaded = 0;
 static int mx4sioModLoaded = 0;
 static int hddModLoaded = 0;
+static int netboxModLoaded = 0;
