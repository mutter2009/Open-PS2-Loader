diff --git a/modules/network/smap-ingame/exports.tab b/modules/network/smap-ingame/exports.tab
new file mode 100644
index 0000000..d905414
--- /dev/null
+++ b/modules/network/smap-ingame/exports.tab
@@ -0,0 +1,55 @@
+/*
+ * [NETBOX] 把 smap-ingame 变成「可被外部模块复用的 SMAP 原始帧收发器」。
+ *
+ * 库名 netboxh，版本 1.0，只给 modules/netbox/netbox_bd.c 用。
+ * 在-game SMB / 普通以太网游戏不会用到这几个符号，所以对既有功能零影响。
+ *
+ * 为什么必须绕过 ps2ip：
+ *   盒子回给 PS2 的应答是「畸形 IP 包」——IP 头 total_length 恒为 124、
+ *   UDP 头 length 恒为 104，而以太网帧实际是 640 字节（2026-09-23 原厂
+ *   loader 开机抓包，254148 帧全部如此，且帧尾带真实扇区数据）。
+ *   lwIP 的 ip_input() 里有 pbuf_realloc(p, ntohs(IPH_TOTLEN))，会把 pbuf
+ *   裁到 124 字节 => socket 最多拿到 96 字节 UDP 载荷，而一个读扇区应答
+ *   有 536 字节（18 前导 + 512 扇区 + 6 收尾），512 字节扇区数据在这里就丢了。
+ *   => fatfs 挂不上 mass0:，OPL 连设备图标都不显示。
+ *
+ *   所以必须在 ps2ip_input() 之前把「完整的以太网帧」交出去。
+ *   xfer.c: HandleRxIntr -> CopyFromFIFO(...) -> SMapLowLevelInput(pbuf)
+ *   这个位置是整条栈上最低、且 OPL 自己能改的一层（smap 是 OPL 的源码）。
+ *
+ * 注意本文件会被 ps2sdk 的 Makefile.iopglobal 原样 cat 进 build-exports.c
+ * （printf '#include "irx.h"' + cat exports.tab），所以：
+ *   1. '#' 开头的行是预处理指令，注释必须用 C 风格；
+ *   2. 只能靠 irx.h 里的 DECLARE_EXPORT 宏，不能 include 自己的头文件。
+ *
+ * v14（2026-09-24 下午）新增两个符号，理由：
+ *
+ *   smap_get_link_status() —— 实机报回 "FAIL stage=3 hook=0" 后去读 SMAPStart()，
+ *     发现 SmapIsInitialized（决定 SMAPSendPacket 能不能发）是在
+ *     InitPHY() "成功"之后置 1 的，而 InitPHY() 的每一条出口都是
+ *     【无条件 return 0】（smap.c 末尾）。也就是说：**链路从来没起来时，
+ *     InitPHY 也报成功，发送也返回 1。**
+ *     => "发送返回 1" 完全不能证明链路上有线，唯一可信判据是 PHY 的
+ *        BMSR 寄存器 bit2（LinkStatus）。这个函数就是把它交出来。
+ *
+ *   smap_get_rx_hook()    —— 回读已注册的钩子指针。若 netboxh 库的导入被
+ *     IOP 装载器改写成空桩（cleanStub，见 ps2sdk loadcore.c），
+ *     smap_set_rx_hook() 会静默什么都不做，钩子计数永远是 0，与
+ *     "盒子没回包" 无法区分。回读一次就能把这两者分开。
+ *
+ * 编号 —— netbox_imports.h 里的 DECLARE_IMPORT 必须与这里严格一致：
+ *   0  _start                沿用其它模块的导出模板（v1 格式约定）
+ *   1  smap_set_rx_hook      void smap_set_rx_hook(void *fn)
+ *   2  SMAPSendPacket        int  SMAPSendPacket(const void *data, unsigned int length)
+ *   3  SMAPGetMACAddress     int  SMAPGetMACAddress(unsigned char *buffer)
+ *   4  smap_get_link_status  int  smap_get_link_status(unsigned int *bmsr, unsigned int *anlpar, unsigned int *linkmode)
+ *   5  smap_get_rx_hook      void *smap_get_rx_hook(void)
+ */
+DECLARE_EXPORT_TABLE(netboxh, 1, 0)
+	DECLARE_EXPORT(_start)
+	DECLARE_EXPORT(smap_set_rx_hook)
+	DECLARE_EXPORT(SMAPSendPacket)
+	DECLARE_EXPORT(SMAPGetMACAddress)
+	DECLARE_EXPORT(smap_get_link_status)
+	DECLARE_EXPORT(smap_get_rx_hook)
+END_EXPORT_TABLE
