+#define NETBOX_LOAD_ID_NOT_TRIED  (-1000)
+extern int gNetBoxStartRC;
+extern int gNetBoxLoadID;
+
 #define BDM_TYPE_UNKNOWN -1
 #define BDM_TYPE_USB     0
 #define BDM_TYPE_ILINK   1
 #define BDM_TYPE_SDC     2
 #define BDM_TYPE_ATA     3
+#define BDM_TYPE_NETBOX  4
 
 typedef struct
 {
