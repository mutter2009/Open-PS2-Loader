+                 *   nrx>0 且没中断  帧到了 MAL 却没人取 —— MII 段其实是通的
+                 *   fl&1            中断跑了但帧没交到钩子
+                 *   全 0            MII 接口或 PHY 数字部分坏了 —— 这一类可修
+                 *
+                 * 字段含义与 stage 9 完全一致（复用 v18 位布局）。 */
+                if (nrx > 0u && !(fl & 1u)) {
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply PHY LPBK: MAL frames, no IRQ nrx=%u " NB_UITAG, nrx);
+                } else if (fl & 1u) {
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply PHY LPBK: IRQ ran, no frame nrx=%u " NB_UITAG, nrx);
+                } else {
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply PHY LPBK DEAD -> MII/PHY fault " NB_UITAG);
+                }
+            } else if (stage == 11) {
+                /* [v22] 对照窗口 —— 两格自环都通了才走到这里。
+                 *
+                 * ★ [v23] 语义微调：现在只有"两窗口都 0 帧（SILENT）"且
+                 *   stage 12 linkchk 判定【我们这一侧干净】时，驱动才会返回
+                 *   stage 11（见 netbox_bd.c 阶梯）。所以这一格的 SILENT 读数
+                 *   不再等于"线坏了"，而是"PS2 侧链路+TX 全好、盒子没回"。
+                 *   REPLY!/UNSOLICITED 两条分支在 v23 的阶梯里已不再被走到，
+                 *   字符串保留只为兼容旧布局。
+                 *
+                 * v21 已经排除"线上一帧都没有"（那一次打出的是 RX HEARS BOX）。
+                 * 但那只说明"收到过帧"，还留着最后一个、也是决定下一步怎么走的
+                 * 歧义：
+                 *   (a) 那些帧是【盒子在回我们】-> 病只剩"我们不认识它"，纯识别问题
+                 *   (b) 那些帧是【盒子自顾自发】-> 我们发的请求根本没被接受
+                 * v22 用同一台机器上的 A/B 对照把它劈开：
+                 *   窗口 A = 纯听 ms 毫秒，什么都不发            -> A 帧
+                 *   窗口 B = 四个目的 MAC 候选各发一帧，再听 ms 毫秒 -> B 帧
+                 * B 明显多于 A => 我们发帧这个动作【触发了】对端 => (a)。
+                 * 周期性流量在 A、B 里都会出现，一减就消掉 —— 这正是 A/B 的意义。
+                 *
+                 * 位布局与 netbox_bd.c 的 nb_diag_pack_listen() 注释【逐字一致】：
+                 *   bit0..7 nA / bit8..15 nB / bit16..18 kind / bit19..20 d3
+                 *   bit21 ip / bit22 p4 / bit23 box / bit24 p3 / bit25 rp
+                 *   bit26..29 stage / bit30 打包标记（0x40000000）/ bit31 恒 0
+                 * ★ 这一格里 nrx/nok/nbad/e18/fl 那些 v18 字段【没有意义】，
+                 *   它们的位置被上面这组字段占用了（布局按 stage 分流）。 */
+                unsigned int na   = v & 0xFFu;
+                unsigned int nb   = (v >> 8) & 0xFFu;
+                unsigned int kind = (v >> 16) & 0x07u;
+                unsigned int d3   = (v >> 19) & 0x03u;
+                unsigned int ip   = (v >> 21) & 0x01u;
+                unsigned int p4   = (v >> 22) & 0x01u;
+                unsigned int box  = (v >> 23) & 0x01u;
+                unsigned int p3   = (v >> 24) & 0x01u;
+                unsigned int rp   = (v >> 25) & 0x01u;
+                char kc, dc;
+
+                /* 首帧种类：U = 单播 —— 单播帧的目的地址必然写着我们，
+                 * 出现 U 几乎就等于"对端在跟我们说话"。 */
+                kc = '?';
+                if (kind == 1u)
+                    kc = 'B';               /* 广播 ff:ff:ff:ff:ff:ff */
+                else if (kind == 2u)
+                    kc = 'V';               /* 厂商多播 ff:34:43:xx:ff:ff */
+                else if (kind == 3u)
+                    kc = 'm';               /* 其他多播 */
+                else if (kind == 4u)
+                    kc = 'U';               /* 单播 ★ */
+
+                /* 这帧像不像我们这套协议。两个端口都查：
+                 *   P = 目的 40000 且源 30000（全套我方协议端口）
+                 *   s = 目的 40000，源端口不是 30000
+                 *   e = 源端口 30000 —— 像我们自己发出去的帧被回显回来
+                 *   i = 只是个 IPv4 帧，端口都不对
+                 *   x = 非 IP（ARP 之类） */
+                dc = '-';
+                if (ip != 0u) {
+                    if (p4 != 0u && p3 != 0u)
+                        dc = 'P';
+                    else if (p4 != 0u)
+                        dc = 's';
+                    else if (p3 != 0u)
+                        dc = 'e';
+                    else
+                        dc = 'i';
+                } else if (kind != 0u)
+                    dc = 'x';
+
+                if (na == 0u && nb == 0u) {
+                    /* 两个窗口都是空的 —— 线上真的什么都没有。
+                     *
+                     * ★ [v23] 这一格现在只在【stage 12 linkchk 已证明"我们这一侧
+                     *   链路 + TX 全干净"之后】才会被打印（见 netbox_bd.c 的阶梯）：
+                     *   盒子是静默监听型，SILENT 本身不是故障；真正剩下的疑点只有
+                     *   盒子/线缆。所以措辞与版本标记都升到 v23，避免与 v22 的同名
+                     *   读数混淆（v22 会把 SILENT 直接判成"线/盒子坏了"。） */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply RX SILENT; PS2 link+TX clean -> box/cable " NB_UITAG);
+                } else if (rp != 0u || (na == 0u && nb > 0u)) {
+                    /* ★ 发帧之后帧数明显涨了 = 对端在回我们 ★ */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply RX REPLY! A=%u B=%u dst=%c%c%X%s " NB_UITAG,
+                             na, nb, kc, dc, d3, box ? " box" : "");
+                } else {
+                    /* 两个窗口差不多 = 对端在自己的节奏上发，没理我们。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply RX UNSOLICITED A=%u B=%u dst=%c%c%X%s " NB_UITAG,
+                             na, nb, kc, dc, d3, box ? " box" : "");
+                }
+            } else if (stage == 12) {
+                /* [v23] 链路 + TX 体检 —— 见 netbox_bd.c 的 nb_diag_pack_linkchk()。
+                 * 位布局与该函数注释【逐字一致】（下面这 16 个局部变量名直接对应
+                 * 那张表的位）：
+                 *   bit0 link1 / bit1 link2 / bit2 lp_stuck / bit3 aneg / bit4 spd100
+                 *   bit5 fdx / bit6 flow / bit7 partner / bit8 txq10 / bit9 txq11
+                 *   bit10 fcscr_nz / bit11 recr_nz / bit12..15 bmsr_lo / bit16..19 sts_lo
+                 *   bit20..23 anlpar_lo / bit24 phy_gone
+                 * 只有 lp_stuck / txq / 无 link / 无 PHY 这四项才会让这一格真失败；
+                 * 否则链路 + TX 全好，SILENT 只是盒子的正常静默监听 -> 走成功路径。 */
+                int link1    = (int)(v & 0x01u);
+                int link2    = (int)((v >> 1) & 0x01u);
+                int lp_stuck = (int)((v >> 2) & 0x01u);
+                int aneg     = (int)((v >> 3) & 0x01u);
+                int spd100   = (int)((v >> 4) & 0x01u);
+                int fdx      = (int)((v >> 5) & 0x01u);
+                int flow     = (int)((v >> 6) & 0x01u);
+                int partner  = (int)((v >> 7) & 0x01u);
+                int txq10    = (int)((v >> 8) & 0x01u);
+                int txq11    = (int)((v >> 9) & 0x01u);
+                int fcscr_nz = (int)((v >> 10) & 0x01u);
+                int recr_nz  = (int)((v >> 11) & 0x01u);
+                int bmsr_lo  = (int)((v >> 12) & 0x0Fu);
+                int sts_lo   = (int)((v >> 16) & 0x0Fu);
+                int anlpar_lo= (int)((v >> 20) & 0x0Fu);
+                int phy_gone = (int)((v >> 24) & 0x01u);
+                int link     = link1 | link2;
+                int txq      = txq10 | txq11;
+
+                if (phy_gone) {
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply LINKCHK: NO PHY (idr=FFFF) " NB_UITAG);
+                } else if (lp_stuck) {
+                    /* ★ 这正是 v21/v22 监听窗口"测到的是自己的实验残留"的根因 ★ */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply LINKCHK: PHY STUCK LOOPBACK link=%d " NB_UITAG, link);
+                } else if (txq) {
+                    /* 发完帧 TXFIFO 仍有残留 => MAC 没把帧取走上 MII，
+                     * 正好解释"发送返回 1、线上却 0 帧"。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply LINKCHK: TX STUCK txq=%d%d link=%d aneg=%d " NB_UITAG,
+                             txq10, txq11, link, aneg);
+                } else if (!link) {
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL noreply LINKCHK: NO LINK aneg=%d bmsr=%X sts=%X " NB_UITAG,
+                             aneg, bmsr_lo, sts_lo);
+                } else {
+                    /* link 真、TX 干净、PHY 不在自环 —— stage 11 的 SILENT 是盒子
+                     * 正常的静默监听行为，不是故障；该看的是盒子侧 / 线缆。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: OK link=%d%d %s%s%s partner=%d fcs=%d rec=%d anlpar=%X " NB_UITAG,
+                             link1, link2, spd100 ? "100M" : "10M", fdx ? "F" : "H",
+                             flow ? "fc" : "", partner, fcscr_nz, recr_nz, anlpar_lo);
+                }
+            } else {
+                /* [v18] 链路已经确认是通的（否则会停在 stage 2），
+                 * 所以这里要回答的不再是"线通不通"，而是
+                 * "盒子那个回包到底走到哪一步了"。全部来自
+                 * netbox_bd.c 的 nb_diag_pack18()，字符串本身点明下一步。
+                 * 顺序 = 从"最靠近发送侧"往"最靠近接收侧"排。 */
+                if (txst & 1u) {
+                    /* TxMODE0 的 GNP 位挂着 = 描述符交了、发送引擎没动，
+                     * 帧根本没上线路。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s TX ENGINE STUCK (gnp) " NB_UITAG, stageName[stage]);
+                } else if (e18 == 5u) {
+                    /* 出现过 DEAD_0 / TX_ERR / SQE_ERR = 引擎动了、
+                     * 线路侧报死（PHY 侧没有载波）。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s TX DEAD CARRIER " NB_UITAG, stageName[stage]);
+                } else if (nbad > 0u || e18 != 0u) {
+                    /* 帧到了、也取走了，但带着以太网收帧错误标志。
+                     * errcode: 1 BD丢帧 / 2 BAD_FCS / 3 短帧 / 4 其它收帧错 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s BAD FRAMES=%u e=%u " NB_UITAG,
+                             stageName[stage], nbad, e18);
+                } else if (nrx > 0u || (fl & 8u)) {
+                    /* MAL 里压着帧没被取走 -> 中断那一段的问题。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s MAL STUCK nrx=%u " NB_UITAG, stageName[stage], nrx);
+                } else if (fl & 1u) {
+                    /* 中断在跑、一个帧都没到过 -> 帧没上线，或盒子真没回。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s rx armed, 0 frames " NB_UITAG, stageName[stage]);
+                } else {
+                    /* 连中断都没进过 —— 收包路径压根没被碰过。 */
+                    snprintf(netboxStatus, sizeof(netboxStatus),
+                             "NetBox: FAIL %s NO RX IRQ at all fl=%u n=%u k=%u " NB_UITAG,
+                             stageName[stage], fl, nrx, nok);
+                }
+            }
+        } else if (gNetBoxStartRC != 0)
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, driver START FAILED (ret=%d)",
+                     gNetBoxLoadID, gNetBoxStartRC);
+        else
+            snprintf(netboxStatus, sizeof(netboxStatus), "NetBox: ON, id=%d, resident (raw SMAP v30)", gNetBoxLoadID);
+        diaSetLabel(diaBlockDevicesConfig, CFG_NETBOX_STATUS, netboxStatus);
+    }
+
+    // [NETBOX] 下面这几个 IP 输入框自 v12 起【已不再使用】。
+    // netbox 的收发全部是原始以太网帧：PS2 自发帧的 IP 源地址填 0.0.0.0
+    // （与原厂 loader 一致），目的地址 255.255.255.255，盒子也只广播回。
+    // 也就是说这条链路根本不需要给网卡配 IP，连 lwIP 网卡都不需要。
+    // 控件保留（配置文件里还有对应项）但置灰，避免误以为不改它就通不了。
+    for (i = 0; i < 4; i++) {
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, netbox_ip[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, netbox_netmask[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, netbox_gateway[i]);
+        diaSetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, netbox_dns[i]);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, 0);
+        diaSetEnabled(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, 0);
+    }
 
     ret = diaExecuteDialog(diaBlockDevicesConfig, -1, 1, NULL);
     if (ret) {
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEILK, &gEnableILK);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEMX4SIO, &gEnableMX4SIO);
         diaGetInt(diaBlockDevicesConfig, CFG_ENABLEBDMHDD, &gEnableBdmHDD);
+        diaGetInt(diaBlockDevicesConfig, CFG_ENABLENETBOX, &gEnableNetBox); // [NETBOX]
+
+        // [NETBOX] 读回 NetBox 网络配置（静态）
+        for (i = 0; i < 4; i++) {
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_IP_0 + i, &netbox_ip[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_NETMASK_0 + i, &netbox_netmask[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_GATEWAY_0 + i, &netbox_gateway[i]);
+            diaGetInt(diaBlockDevicesConfig, CFG_NETBOX_DNS_0 + i, &netbox_dns[i]);
+        }
     }
 }
 
