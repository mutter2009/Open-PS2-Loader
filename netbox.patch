+/*
+ * netbox_imports.h - ps2ip (SMSTCPIP) 的导入声明
+ *
+ * 编号必须与 modules/network/SMSTCPIP/exports.tab 里的导出序号一致。
+ * OPL 自带 SMSTCPIP 的导出（前 40 项）实测如下：
+ *   5  lwip_bind
+ *   6  lwip_close
+ *   10 lwip_recvfrom
+ *   12 lwip_sendto
+ *   13 lwip_socket
+ *   19 lwip_setsockopt
+ *   23 ps2ip_input
+ *   24 inet_addr
+ *
+ * NB_RAW_HOOK_EXPORT_NUM 是我们新增的 ps2ip_set_raw_hook，
+ * 必须追加在 exports.tab 的【末尾】，编号改成它实际的索引。
+ */
+
+#ifndef __NETBOX_IMPORTS_H__
+#define __NETBOX_IMPORTS_H__
+
+#include <irx.h>
+
+#ifndef ps2ip_IMPORTS_start
+#define ps2ip_IMPORTS_start DECLARE_IMPORT_TABLE(ps2ip, 1, 3)
+#define ps2ip_IMPORTS_end   END_IMPORT_TABLE
+#endif
+
+#define I_lwip_bind       DECLARE_IMPORT(5, lwip_bind)
+#define I_lwip_close      DECLARE_IMPORT(6, lwip_close)
+#define I_lwip_recvfrom   DECLARE_IMPORT(10, lwip_recvfrom)
+#define I_lwip_sendto     DECLARE_IMPORT(12, lwip_sendto)
+#define I_lwip_socket     DECLARE_IMPORT(13, lwip_socket)
+#define I_lwip_setsockopt DECLARE_IMPORT(19, lwip_setsockopt)
+#define I_inet_addr       DECLARE_IMPORT(24, inet_addr)
+
+/* 新增（打补丁后才有）: ps2ip_set_raw_hook。
+ *
+ * 实测依据（OPL master, modules/network/SMSTCPIP/exports.tab）:
+ *   导出表共 42 项，序号 0..41；pbuf_chain 带注释 //40，pbuf_take=41，
+ *   因此追加到末尾的新项序号 = 42。
+ *   下表已按出现顺序逐一核对：lwip_bind=5 lwip_close=6 lwip_recvfrom=10
+ *   lwip_sendto=12 lwip_socket=13 lwip_setsockopt=19 inet_addr=24
+ *   （注：ps2ip_Stub 在表里重复出现两次，是 OPL 自带的占位，不影响其他项）
+ */
+#define NB_RAW_HOOK_EXPORT_NUM 42
+#define I_ps2ip_set_raw_hook DECLARE_IMPORT(NB_RAW_HOOK_EXPORT_NUM, ps2ip_set_raw_hook)
+
+#endif
