+/* ------------------------------------------------------------------
+ * [v21] PHY（MII）自环自检 —— PS2 侧最后一块没被验证过的数据通路
+ *
+ * v20 实机结果把范围砍掉了一大块：
+ *     "FAIL noreply LOOPBACK OK: PS2 rx path fine (v20)"
+ * = EMAC3 内自环通了。内自环覆盖 TX 描述符 -> MAC 发送 -> 内部回环 ->
+ *   MAC 接收/地址过滤 -> MAL RX FIFO -> RXEND 中断 -> HandleRxIntr -> 钩子，
+ *   所以这一整串全部完好，"PS2 自己收不了"已经被排除。
+ *
+ * 那还剩什么？只剩【PHY 的 MII 数据通道】。v19 的内自环是故意把 PHY 排除在外的
+ * （为了答案二元化），而 v17 读回 BMSR=0x2D 只证明 PHY 的 MDIO【管理通道】能用，
+ * 与数据能不能过去是两回事 —— 管理通道和数据通道在 PHY 里是两套电路。
+ *
+ * 于是再往外推一格：置 PHY 的 BMCR bit14（802.3 Loopback），让 PHY 在 MII
+ * 接口处把发送数据回环到接收侧。加上这一格之后，
+ *     内自环 OK + PHY 自环 OK   => MAC..MII..PHY(数字) 全好
+ *                                  => 病只能在 PHY 模拟前端 / 网线 / 对端盒子
+ *     内自环 OK + PHY 自环 失败 => 病在 MII 接口或 PHY 数字部分（这一类可修）
+ *
+ * 顺序：开 PHY 自环 -> 发 3 帧真协议帧 -> 等 -> 采集 -> 关自环（无条件）。
+ * 读数落在 g_rxd[]，随后由 nb_fail(NB_STAGE_PHYLPBK) 打包上屏。
+ * ------------------------------------------------------------------ */
+static int g_phy_lp_rx = 0; /* PHY 自环窗口内交到收帧钩子的帧数 */
+
+static void nb_phy_loopback_selftest(void)
+{
+    static unsigned int base[20];
+    static u8 req[512];
+    static const int cum[] = {0, 3, 4, 5, 6, 7, 8, 9, 10, 11};
+    int i, k, len, saved_idx;
+
+    g_phy_lp_rx = 0;
+
+    nb_snapshot();
+    for (i = 0; i < 20; i++)
+        base[i] = g_rxd[i];
+    /* 回环帧必须能被自己的地址过滤收下 —— 用候选表里的标准广播那一项，
+     * 不赌当前停在哪个 ff:34:43:xx 上。[v25] 同 nb_linkchk：广播项
+     * 从第 0 位挪到 NB_DSTMAC_BCAST，行为不变。 */
+    saved_idx     = nb_dstmac_idx;
+    nb_dstmac_idx = NB_DSTMAC_BCAST;
+
+    g_cap_n  = 0;
+    g_cap_on = 1;
+
+    if (smap_phy_loopback_set(1) != 0) {
+        g_cap_on      = 0;
+        nb_dstmac_idx = saved_idx;
+        return;
+    }
+
+    DelayThread(3 * 1000); /* 3ms：等 PHY 进自环 */
+
+    g_txn = (u16)(g_txn + 1);
+    len   = nb_build_generic(req, (int)sizeof(req), NB_HS1,
+                             (int)(sizeof(NB_HS1) / sizeof(NB_HS1[0])), g_txn);
+    for (i = 0; i < 3 && len > 0; i++) {
+        nb_send(req, len);
+        DelayThread(5 * 1000);
+    }
+
+    DelayThread(120 * 1000); /* 120ms：等回环帧走完 TX -> PHY -> MII -> RX */
+
+    nb_snapshot();
+    for (k = 0; k < (int)(sizeof(cum) / sizeof(cum[0])); k++) {
+        int j = cum[k];
+
+        g_rxd[j] = (g_rxd[j] >= base[j]) ? (g_rxd[j] - base[j]) : 0;
+    }
+
+    /* 无条件退自环 —— 绝不能把 PHY 留在回环状态（那之后线上一个包都出不去）。 */
+    smap_phy_loopback_set(0);
+    g_cap_on      = 0;
+    nb_dstmac_idx = saved_idx;
+
+    /* ★ v23 修：删掉"回退到 g_rxd[0]"那一条路 ★
+     *
+     * 原来的写法是
+     *     g_phy_lp_rx = (int)g_rxd[9];
+     *     if (g_phy_lp_rx == 0 && g_rxd[0] > 0)
+     *         g_phy_lp_rx = (int)g_rxd[0];
+     * 而当时 g_rxd[0] 是【自开机以来的累计】MAL 收帧数（它不在增量名单里），
+     * stage 9 的内自环一收到帧，它就永远 > 0 —— 于是这一格【恒报通过】，
+     * 哪怕 PHY 自环其实完全不通。v21/v22 屏幕上那个"阶梯走到 stage 11"
+     * 就是这么来的（等于只走通了 stage 9）。
+     *
+     * 现在 g_rxd[0] 也进了增量名单（见上面 cum[]），两个量都是"本窗口内"
+     * 的读数，直接判即可，不再需要、也绝不允许任何回退。 */
+    g_phy_lp_rx = (int)(g_rxd[0] | g_rxd[9]);
+
+    /* ★ v23 新增：TX FIFO 残留 ★
+     * g_rxd[1] = SMAP_R_TXFIFO_FRAME_CNT（"发送队列里还没发完的帧数"），
+     * 是【现场值】而不是增量。刚才发了 3 帧、又等了 120ms，正常情况 MAC 早该
+     * 取走（归 0）。若这里还不是 0，说明帧根本没被 MAC 发上 MII ——
+     * 这正好能解释"发送返回 1、线上却一帧都没有"那个悬了很久的现象。 */
+    g_txq10 = (g_rxd[1] > 255u) ? 255 : (int)g_rxd[1];
+
+    {
+        char msg[160];
+
+        sprintf(msg, "v23 phy-loopback: mal=%u ok=%u bad=%u txq=%u intr=%u rxend=%u",
+                g_rxd[0], g_rxd[9], g_rxd[10], g_rxd[1], g_rxd[4], g_rxd[5]);
+        nb_diag(msg);
+    }
+}
+
+/* ------------------------------------------------------------------
+ * [v22] 对照窗口 —— "盒子到底有没有在回我们"
+ *
+ * v21 的实机结果是 stage 11 打出 RX HEARS BOX：线上一帧都没有已被排除，
+ * PS2 收到过帧。但这句话还留着最后一个歧义，而它决定了完全不同的下一步：
+ *     (a) 那些帧是【盒子在回我们】-> 病只剩"我们不认识它"，纯格式/识别问题
+ *     (b) 那些帧是【盒子自顾自发】-> 我们发的请求根本没被接受
+ * 两种情形下"听 400ms 有帧"长得一模一样，光看计数分不开。
+ *
+ * ★ v22 的做法：同一台机器上做 A/B 对照 ★
+ *   窗口 A：纯听 ms 毫秒，什么都不发           -> A 帧
+ *   窗口 B：对四个目的 MAC 候选各发一帧，再听 ms 毫秒 -> B 帧
+ *   B 明显多于 A（> A+1）=> 我们发帧这个动作【触发了】对端 => 情形 (a)。
+ * 这是唯一能对抗"盒子本来就有周期性流量"这个混淆因素的设计：
+ * 周期性流量在 A 和 B 里都会出现，一减就消掉了。
+ *
+ * ★ 这个窗口不需要改任何接收配置 ★
+ *   RxMODE 在 smap_init() 第 668 行就已经是含 RX_BCAST / RX_MCAST 的那一组，
+ *   而盒子的应答按桥接抓包是【广播帧】，本来就过得了地址过滤。所以"听不到"
+ *   是真的没东西进来，不是被硬件滤掉了 —— 这一点是判据成立的前提。
+ *
+ * 除了计数，还把首帧的身份打上诊断通道（PC 侧抓包直接可见）：
+ *   v22 phy: ...   PHY 的 BMCR/BMSR/PHYSTS/FCSCR/RECR/PCSR —— 其中 FCSCR/RECR
+ *                  非 0 就说明线上真有信号进来并被 PHY 接收侧处理过。
+ *   v22 f0 ...     首帧的 dst/src MAC + EtherType（先 A 窗口的，A 空才取 B 的）
+ *   v22 f1/f2/f3   第二、三帧的同样字段（看是不是一批同形的帧）
+ *
+ * 上屏那条（32 位）装不下这么多，只装摘要，布局见 nb_diag_pack_listen()。
+ * （下面的 g_listen_a / g_listen_b / g_listen_ca / g_f_* 全局声明已统一挪到
+ *  文件顶部抓帧缓冲区之后，避免"先使用后声明"的 undeclared 报错。）
+ * ------------------------------------------------------------------ */
+
+/* 从抓到的首帧里解析出身份字段。取"窗口 A 的第一帧"优先（那是纯自发的），
+ * A 没有帧才用窗口 B 的（那可能是被我们触发的）。 */
+static void nb_identify_first_frame(void)
+{
+    const u8 *f;
+    int len;
+
+    g_f_kind = g_f_d3 = g_f_u = g_f_et = g_f_p4 = g_f_p3 = 0;
+
+    if (g_cap_n <= 0)
+        return;
+
+    f   = g_cap[0];
+    len = g_cap_len[0];
+
+    if (f[0] == 0xFFu && f[1] == 0xFFu)
+        g_f_kind = 1u;                                  /* 广播 */
+    else if (f[0] == 0xFFu && f[1] == 0x34u && f[2] == 0x43u)
+        g_f_kind = 2u;                                  /* 厂商多播 ff:34:43 */
+    else if ((f[0] & 1u) != 0u)
+        g_f_kind = 3u;                                  /* 其他多播 */
+    else
+        g_f_kind = 4u;                                  /* 单播 —— 一定写着我们 */
+
+    g_f_d3 = (f[3] >> 5) & 0x03u;
+
+    if (f[6] == 0x08u && f[7] == 0x00u && f[8] == 0x27u)
+        g_f_u = 1u;                                     /* 源 = 盒子 MAC 前缀 */
+
+    if (len >= 14) {
+        unsigned int et = ((unsigned int)f[12] << 8) | f[13];
+
+        if (et == 0x0800u)
+            g_f_et = 1u;                                /* 是个 IPv4 帧 */
+        /* 只有 IPv4/UDP 才去解端口；别把非 IP 帧的字节当端口读。 */
+        if (et == 0x0800u && len >= 38) {
+            /* 以太网头 14 + IP 头 20（无选项）= 34，UDP 源端口在 +0/+1。 */
+            unsigned int sp = ((unsigned int)f[34] << 8) | f[35];
+            unsigned int dp = ((unsigned int)f[36] << 8) | f[37];
+
+            if (dp == 40000u)
+                g_f_p4 = 1u;                            /* 我们协议的服务器端口 */
+            if (sp == 30000u)
+                g_f_p3 = 1u;                            /* 我们协议的客户端端口 */
+        }
+    }
+}
+
+static void nb_listen_probe(int ms_a, int ms_b)
+{
+    static unsigned int base[20];
+    static u8 req[512];
+    /* 只对【累加型】计数器取增量 —— 名单与 nb_loopback_selftest 里那份必须一致。
+     * v22 这里写的是"全 20 项都减基线"，把 g_rxd[1]（TXFIFO_FRAME_CNT，瞬时值）
+     * 和 12~18（各寄存器现场值）也一起减了，凭空造出一堆负数夹成 0 的垃圾值。
+     * 累加型的结论没错（g_rxd[0] 本来就在名单里），但别的项被弄脏了。 */
+    static const int cum[] = {0, 3, 4, 5, 6, 7, 8, 9, 10, 11};
+    int i, k, len, saved_idx;
+
+    g_listen_a = g_listen_b = g_listen_ca = 0;
+    g_txq11    = 0;
+    g_cap_n    = 0;
+
+    /* 先确认两个自环都关着 —— 否则听到的全是自己绕回来的帧，毫无意义。 */
+    smap_loopback_set(0);
+
+    /* ★ v23：把 PHY 从上一格的自环实验里彻底恢复 ★
+     *
+     * smap_phy_loopback_set(0) 只清 BMCR 的 bit14 —— 既不重启自协商，也不等
+     * 链路重新同步。而 802.3 规定退出 loopback 后链路本来就要重来一遍。
+     * 也就是说 v21/v22 的监听窗口其实是在"PHY 刚退出实验态、链路还没恢复"
+     * 的状态下跑的，"听不到"是必然的 —— 那一格测到的是自己的实验残留。
+     *
+     * 这里改用 smap_phy_reinit()：它软复位 PHY（复位本身就清掉 loopback 位）、
+     * 重建链路、算 LinkMode、把 FDX 写回 EMAC3，并在链路就绪时重新落下
+     * MODE0(TXRX使能) 与 RxMODE(含 RX_BCAST) —— 最接近"原厂 InitPHY 重跑"
+     * 的一次恢复。现场留在 g_lk[] / g_lk_rc 里，stage 12 直接拿来用。 */
+    g_lk_rc = smap_phy_reinit(g_lk, 12);
+
+    /* 排空上面这次恢复 / 上一格自环可能还在路上的回环帧，再建基线。 */
+    DelayThread(400 * 1000);
+
+    /* ---------------- 窗口 A：纯听，什么都不发 ---------------- */
+    nb_snapshot();
+    for (i = 0; i < 20; i++)
+        base[i] = g_rxd[i];
+
+    g_cap_on = 1;
+
+    DelayThread((u32)ms_a * 1000);
+
+    nb_snapshot();
+    for (k = 0; k < (int)(sizeof(cum) / sizeof(cum[0])); k++) {
+        int j = cum[k];
+
+        g_rxd[j] = (g_rxd[j] >= base[j]) ? (g_rxd[j] - base[j]) : 0;
+    }
+
+    g_listen_a  = (int)g_rxd[0];   /* MAL 硬件收帧计数 —— 不依赖中断那个 */
+    g_listen_ca = g_cap_n;
+
+    /* ------------- 窗口 B：四个目的 MAC 候选各发一帧，再听同样长 ------------- */
+    saved_idx = nb_dstmac_idx;
+
+    nb_snapshot();
+    for (i = 0; i < 20; i++)
+        base[i] = g_rxd[i];
+
+    g_txn = (u16)(g_txn + 1);
+    len   = nb_build_generic(req, (int)sizeof(req), NB_HS1,
+                             (int)(sizeof(NB_HS1) / sizeof(NB_HS1[0])), g_txn);
+    for (i = 0; i < 4 && len > 0; i++) {
+        nb_dstmac_idx = i;         /* 四个候选都打一遍，最大化"被接受"的概率 */
+        nb_send(req, len);
+        DelayThread(5 * 1000);
+    }
+
+    nb_dstmac_idx = saved_idx;
+
+    DelayThread((u32)ms_b * 1000);
+
+    nb_snapshot();
+    for (k = 0; k < (int)(sizeof(cum) / sizeof(cum[0])); k++) {
+        int j = cum[k];
+
+        g_rxd[j] = (g_rxd[j] >= base[j]) ? (g_rxd[j] - base[j]) : 0;
+    }
+
+    g_listen_b  = (int)g_rxd[0];
+    g_txq11     = (g_rxd[1] > 255u) ? 255 : (int)g_rxd[1];   /* 窗口 B 发送后 TX FIFO 残留 */
+    g_listen_silent = ((g_listen_a == 0) && (g_listen_b == 0)) ? 1 : 0;
+
+    g_cap_on = 0;
+
+    nb_identify_first_frame();
+
+    {
+        char msg[192];
+        unsigned int pc[8];
+
+        sprintf(msg, "v23 AB listen %d/%dms: A=%d B=%d txq=%d silent=%d capA=%d ok=%u bad=%u intr=%u",
+                ms_a, ms_b, g_listen_a, g_listen_b, g_txq11, g_listen_silent,
+                g_listen_ca, g_rxd[9], g_rxd[10], g_rxd[4]);
+        nb_diag(msg);
+
+        if (smap_phy_counters(pc, 8) == 0) {
+            sprintf(msg, "v22 phy: bmcr=%04x bmsr=%04x sts=%04x fcscr=%04x recr=%04x pcsr=%04x",
+                    pc[0] & 0xFFFFu, pc[1] & 0xFFFFu, pc[2] & 0xFFFFu,
+                    pc[3] & 0xFFFFu, pc[4] & 0xFFFFu, pc[5] & 0xFFFFu);
+            nb_diag(msg);
+        }
+
+        for (i = 0; i < g_cap_n && i < NB_CAP_MAX; i++) {
+            const u8 *f = g_cap[i];
+            int n = g_cap_len[i];
+
+            if (n < 14)
+                continue;
+            sprintf(msg, "v22 f%d len=%d dst=%02x:%02x:%02x:%02x:%02x:%02x src=%02x:%02x:%02x:%02x:%02x:%02x et=%02x%02x",
+                    i, n,
+                    f[0], f[1], f[2], f[3], f[4], f[5],
+                    f[6], f[7], f[8], f[9], f[10], f[11],
+                    f[12], f[13]);
+            nb_diag(msg);
+        }
+    }
+}
+
+/*
+ * [v23] stage 12（链路 + TX 体检）的判定函数。
+ *
+ * 两格自环通过、A/B 监听窗口也跑完之后由失败阶梯调用。它本身不再做新实验，
+ * 只是把"当前链路 / TX 残留"这一最关键的未验证项读出来、就地判一遍。
+ *
+ * 返回：
+ *   0 = 链路 + TX 全好（SILENT 也只是盒子的正常静默监听，不是故障） => 调用方
+ *       落到成功路径（resident）。
+ *   非 0 = 发现硬故障（lp_stuck / txq / 无 link / 无 PHY）=> 调用方 nb_fail(LINKCHK)。
+ *
+ * 依赖（必须在此之前已经就位）：
+ *   - g_lk[]：smap_phy_reinit() 在 nb_listen_probe() 里已填好（PHYIDR1/2、
+ *     ANLPAR、LinkMode、LinkStatus），落的是"做完完整 PHY 恢复之后"的状态。
+ *   - g_txq10 / g_txq11：分别在 stage 10 / stage 11 窗口 B 发完帧后采的
+ *     TXFIFO_FRAME_CNT 残留。
+ *   - g_pc[]：本函数内由 smap_phy_counters() 填充（BMCR/BMSR/PHYSTS/FCSCR/RECR/PCSR），
+ *     失败时 nb_diag_pack_linkchk() 直接读它打包上屏。
+ *
+ * smap_phy_counters(out, n) 的 out[] 布局（与 nb_diag_pack_linkchk 必须一致）：
+ *   0 BMCR  1 BMSR  2 PHYSTS  3 FCSCR  4 RECR  5 PCSR。
+ */
+static int nb_linkchk(void)
+{
+    unsigned int bmcr, bmsr;
+    int lp, link, txq, gone;
+
+    if (smap_phy_counters(g_pc, 8) != 0) {
+        /* 读不到（SMAP 未初始化 / n 太小）就把 g_pc 清零，避免打包到上一轮脏值 */
+        int i;
+        for (i = 0; i < 8; i++)
+            g_pc[i] = 0;
+    }
+
+    bmcr = g_pc[0] & 0xFFFFu;
+    bmsr = g_pc[1] & 0xFFFFu;
+
+    lp   = (bmcr & NB_BMCR_LPBK_BIT) ? 1 : 0;                 /* PHY 卡自环 */
+    link = ((g_lk[9] != 0u) || ((bmsr & 0x0004u) != 0u)) ? 1 : 0; /* 重初始化后链路 */
+    txq  = ((g_txq10 != 0) || (g_txq11 != 0)) ? 1 : 0;        /* TX FIFO 残留 */
+    gone = ((g_lk[2] == 0xFFFFu) && (g_lk[3] == 0xFFFFu)) ? 1 : 0; /* 该地址无 PHY */
+
+    if (gone || lp || txq || !link)
+        return 1;   /* 硬故障 -> 调用方 nb_fail(NB_STAGE_LINKCHK) 打包上屏 */
+
+    return 0;       /* 链路 + TX 全好 -> 成功路径 */
+}
+
+/* 开机握手：必须在第一次读扇区之前调用 */
+static void nb_handshake(void)
+{
+    static const struct {
+        const nb_rec_t *r;
+        int             n;
+    } seq[] = {
+        {NB_HS0, 4}, {NB_HS1, 3}, {NB_HS2, 1},
+        {NB_HS3, 1}, {NB_HS4, 1}, {NB_HS5, 2}, {NB_HS6, 2},
+    };
+    int i;
+
+    for (i = 0; i < (int)(sizeof(seq) / sizeof(seq[0])); i++) {
+        nb_send_recs(seq[i].r, seq[i].n);
+        DelayThread(5 * 1000); /* 5ms；实机握手帧间隔 3~13ms */
+    }
+}
+
+/*
+ * 从环形缓冲取一帧，解析出 (事务号, 扇区数据指针)。
+ * 返回 1=数据帧  0=状态帧/无关帧  -1=无帧
+ *
+ * 关键：应答帧开头的填充记录条数不固定
+ *   （读扇区 = 3 条、数据偏移 18；IDENTIFY = 9 条、偏移 54；状态帧更多），
+ * 必须动态扫描跳过，不能硬编码偏移 18。
+ * 帧类型用【以太网帧长】判定最稳：640 = 数据帧，256 = 状态帧。
+ * v12 起帧长是真实值（钩子拿到的就是线上长度），判定比以前更可靠。
+ */
+static int nb_poll_frame(u16 *txn_out, const u8 **data_out)
+{
+    int state, idx, len, paylen, off = 0, fillcnt = 0;
+    const u8 *pl;
+
+    CpuSuspendIntr(&state);
+    if (rx_tail == rx_head) {
+        CpuResumeIntr(state);
+        return -1;
+    }
+    idx = rx_tail;
+    len = rx_len[idx];
+    CpuResumeIntr(state);
+
+    pl     = rx_buf[idx] + NB_UDP_OFF;
+    paylen = len - NB_UDP_OFF;
+
+    /* 1) 跳过前导填充记录：55 aa 4a 00 xx */
+    while (fillcnt < NB_RSP_FILL_MAX && off + NB_REC_SIZE <= paylen &&
+           pl[off] == NB_SYNC0 && pl[off + 1] == NB_SYNC1 &&
+           pl[off + 2] == NB_T_RSP && pl[off + 3] == 0x00) {
+        off += NB_REC_SIZE;
+        fillcnt++;
+    }
+
+    *data_out = NULL;
+    *txn_out  = 0xFFFF;
+
+    /* 2) 数据帧（640 字节以太网帧）：数据紧跟填充，之后是 F 记录 */
+    if (len >= NB_RSP_FRAME_LEN && off + NB_DATA_SIZE + NB_REC_SIZE <= paylen) {
+        const u8 *f = pl + off + NB_DATA_SIZE;
+        if (f[0] == NB_SYNC0 && f[1] == NB_SYNC1 && f[NB_F_CMD_OFF] == NB_C_F) {
+            *txn_out  = (u16)((f[NB_F_PARAM_OFF] << 8) | f[NB_F_PARAM_OFF + 1]);
+            *data_out = pl + off;
+        }
+    }
+
+    /* 3) 状态帧 / 未识别：线性扫描找 F 记录取事务号 */
+    if (*data_out == NULL) {
+        int i;
+        for (i = 0; i + NB_REC_SIZE <= paylen; i += NB_REC_SIZE) {
+            if (pl[i] == NB_SYNC0 && pl[i + 1] == NB_SYNC1 && pl[i + NB_F_CMD_OFF] == NB_C_F)
+                *txn_out = (u16)((pl[i + NB_F_PARAM_OFF] << 8) | pl[i + NB_F_PARAM_OFF + 1]);
+        }
+    }
+
+    CpuSuspendIntr(&state);
+    rx_tail = (rx_tail + 1) % NB_RX_SLOTS;
+    CpuResumeIntr(state);
+
+    return (*data_out != NULL) ? 1 : 0;
+}
+
+/*
+ * 执行一次读事务。
+ * 返回实际读到的扇区数（应等于 count），失败返回 < 0。
+ */
+static int nb_transaction(u64 lba, u16 count, u8 *buffer, u8 ata_cmd)
+{
+    static u8 req[1536];
+    u16 txn;
+    int len, got = 0, tries, deadline;
+    u32 bitmap = 0;
+
+    if (count > NB_MAX_SECTORS)
+        return -1;
+
+    WaitSema(io_sema);
+
+    txn = g_txn;
+    g_txn = (u16)(g_txn + count + 1); /* 每事务消耗 count+1 个事务号 */
+
+    len = nb_build_read(req, sizeof(req), lba, count, txn, ata_cmd);
+    if (len < 0) {
+        SignalSema(io_sema);
+        return -1;
+    }
+
+    for (tries = 0; tries < 3; tries++) {
+        if (nb_send(req, len) < 0) {
+            SignalSema(io_sema);
+            return -2;
+        }
+
+        deadline = 400; /* ~400 次 * 1ms */
+        while (deadline-- > 0 && got < count) {
+            u16 t;
+            const u8 *data;
+            int r = nb_poll_frame(&t, &data);
+
+            if (r < 0) {
+                DelayThread(1000); /* 1ms */
+                continue;
+            }
+            if (r == 1 && t > txn && t <= (u16)(txn + count)) {
+                int idx = t - txn - 1;
+                if (!(bitmap & (1u << idx))) {
+                    memcpy(buffer + (idx * NB_DATA_SIZE), data, NB_DATA_SIZE);
+                    bitmap |= (1u << idx);
+                    got++;
+                }
+            }
+        }
+        if (got >= count)
+            break;
+        got = 0;
+        bitmap = 0;
+    }
+
+    SignalSema(io_sema);
+    return (got >= count) ? (int)count : -3;
+}
+
+/* ------------------------------------------------------------------ */
+/* IDENTIFY：取容量                                                    */
+/* ------------------------------------------------------------------ */
+
+static u64 nb_identify_sectors(void)
+{
+    static u8 req[512];
+    u8  id[512];
+    u64 cap = 0;
+    u16 txn;
+    int len, got = 0, tries, deadline;
+
+    memset(id, 0, sizeof(id));
+
+    /*
+     * 注意：IDENTIFY 请求的结构与读扇区不同（无 LBA 写入），
+     * 且应答的前导填充是 9 条（数据偏移 54），不是读扇区的 3 条。
+     */
+    WaitSema(io_sema);
+    txn   = g_txn;
+    g_txn = (u16)(g_txn + 1);
+
+    len = nb_build_generic(req, sizeof(req), NB_IDENTIFY,
+                           (int)(sizeof(NB_IDENTIFY) / sizeof(NB_IDENTIFY[0])), txn);
+    if (len < 0) {
+        SignalSema(io_sema);
+        return 0;
+    }
+
+    for (tries = 0; tries < 3 && !got; tries++) {
+        if (nb_send(req, len) < 0)
+            break;
+        deadline = 500; /* ~500ms */
+        while (deadline-- > 0) {
+            u16        t;
+            const u8  *data;
+            int        r = nb_poll_frame(&t, &data);
+
+            if (r < 0) {
+                DelayThread(1000); /* 1ms */
+                continue;
+            }
+            if (r == 1 && t == txn) {
+                memcpy(id, data, NB_DATA_SIZE);
+                got = 1;
+                break;
+            }
+        }
+    }
+    SignalSema(io_sema);
+
+    if (!got) {
+        printf("netbox: IDENTIFY 失败，使用默认容量\n");
+        return 0;
+    }
+
+    /* LBA48 容量: word 100..103（小端，注意 ATA 的字节序） */
+    cap = (u64)(id[200] | (id[201] << 8)) |
+          ((u64)(id[202] | (id[203] << 8)) << 16) |
+          ((u64)(id[204] | (id[205] << 8)) << 32) |
+          ((u64)(id[206] | (id[207] << 8)) << 48);
+
+    if (cap == 0 || cap > 0x1000000000000ULL) {
+        /* 退回 LBA28: word 60..61 */
+        cap = (u64)(id[120] | (id[121] << 8)) | ((u64)(id[122] | (id[123] << 8)) << 16);
+    }
+    return cap;
+}
+
+/* ------------------------------------------------------------------ */
+/* struct block_device 回调                                            */
+/* ------------------------------------------------------------------ */
+
+/* [v30] 惰性接盒子：定义在本文件后半（nb_box_trigger 之后、_start 之前），
+ * netbox_read 要用它，所以先前置声明。 */
+static void nb_lazy_connect(void);
+
+static int netbox_read(struct block_device *bd, u64 sector, void *buffer, u16 count)
+{
+    u8 *p = (u8 *)buffer;
+    u16 remaining = count;
+    static int nreads = 0;
+    static int nfails = 0;
+    (void)bd;
+
+    /* [v30] ★ 惰性接盒子 ★ 第一次读盘时才做「flap 逼开门 + 长监听」。
+     * _start() 里绝不做 —— 那会把 OPL 主页卡死（v29 实测 >10 分钟进不去）。
+     * 想抓盒子开门：在 OPL 打开游戏列表之后的 ~20 秒内拔插一次盒子电源。 */
+    if (g_lazy_pending) {
+        g_lazy_pending = 0;
+        nb_lazy_connect();
+    }
+
+    /* 能进这里说明 OPL 已经在尝试挂载并读盘了 */
+    if (nreads == 0) {
+        char msg[80];
+        sprintf(msg, "first read lba=%u count=%d", (unsigned int)sector, (int)count);
+        nb_diag(msg);
+    }
+    nreads++;
+
+    while (remaining > 0) {
+        u16 n = (remaining > NB_MAX_SECTORS) ? NB_MAX_SECTORS : remaining;
+        int r = nb_transaction(sector, n, p, NB_ATA_READ_EXT);
+        if (r != (int)n) {
+            /* 只报前 3 次避免刷屏；带上计数器区分"根本没收到帧"和"帧不对" */
+            if (nfails < 3) {
+                char msg[112];
+                sprintf(msg, "read FAIL lba=%u n=%d ret=%d hook=%d rx=%d drop=%d",
+                        (unsigned int)sector, (int)n, r, g_hook_calls, g_rx_frames, g_rx_drop);
+                nb_diag(msg);
+            }
+            nfails++;
+            return -1;
+        }
+        sector += n;
+        p += (u32)n * NB_DATA_SIZE;
+        remaining = (u16)(remaining - n);
+    }
+    if (nreads == 1)
+        nb_diag("first read OK");
+    return count;
+}
+
+static int netbox_write(struct block_device *bd, u64 sector, const void *buffer, u16 count)
+{
+    /* 写路径从未抓到样本（真实客户端只读）。为安全起见不猜。 */
+    (void)bd; (void)sector; (void)buffer; (void)count;
+    return -1;
+}
+
+static void netbox_flush(struct block_device *bd) { (void)bd; }
+static int  netbox_stop(struct block_device *bd)  { (void)bd; return 0; }
+
+/* 用"指定初始化"而不是按位置初始化，两个原因：
+ *  1) ps2sdk 新版的 bdm.h 给 struct block_device 加了 path 字段，旧版没有；
+ *     指定初始化对两种版本都能编译（不给 path 赋值 = 保持 NULL）。
+ *  2) path 必须留 NULL。OPL 是按 "mass%d:" 前缀枚举 BDM 设备的
+ *     （见 src/bdmsupport.c 的 bdmUpdateDeviceData / bdmFindPartition），
+ *     一旦给 path 赋了前缀，设备会注册到别的 iomanX 前缀下，OPL 反而找不到它。
+ */
+static struct block_device g_netbox_bd = {
+    .priv         = NULL,
+    .name         = "netbox",
+    .devNr        = 0,
+    .parNr        = 0,
+    .parId        = 0,
+    .sectorSize   = 512,
+    .sectorOffset = 0,
+    .sectorCount  = 0, /* 运行时由 IDENTIFY 填入 */
+    .read         = netbox_read,
+    .write        = netbox_write,
+    .flush        = netbox_flush,
+    .stop         = netbox_stop,
+};
+
+/* ------------------------------------------------------------------ */
+/* 模块入口                                                            */
+/* ------------------------------------------------------------------ */
+
+/* [v29] 制造一次真实的 link down->up，逼盒子开门。
+ * 盒子只在自身链路 flap 之后才进入服务窗 —— 原厂 OPL「开浏览器随时能连」就是因为
+ * 每次开浏览器驱动重链 SMAP；我们之前只在启动初始化时链一次，之后再没制造过
+ * flap，盒子永远停在休眠态。
+ * 手法：先 smap_phy_loopback_set(1)（PHY 进入自环、对端看到 link down），
+ * 再 smap_phy_reinit()（软复位 PHY + 重跑 InitPHY，对端看到 link up），
+ * 最后 smap_phy_loopback_set(0) 解除自环。v20/v21 自环自检已用同一套 API 安全跑过。
+ * g_link2 是 nb_link_gate() 已声明好的快照数组（12 个 u32），这里复用它。 */
+static void nb_box_trigger(void)
+{
+    int i, att;
+
+    /* 最多试 3 次：PHY flap 后 BMSR bit2 没起来就再来一次（stale 值不会误判 —— 每轮
+     * 都先把快照清零，和 nb_link_gate() 一个写法）。 */
+    for (att = 0; att < 3; att++) {
+        smap_phy_loopback_set(1);
+        DelayThread(50 * 1000);
+        for (i = 0; i < 12; i++)
+            g_link2[i] = 0;
+        smap_phy_reinit(g_link2, 12);
+        smap_phy_loopback_set(0);
+        DelayThread(150 * 1000); /* 等链路重新协商 + 盒子开门 */
+
+        g_last_bmsr = g_link2[1] & 0xFFFFu;
+        g_link_mode = g_link2[8] & 0xFFu;
+        /* 判链路只看 BMSR bit2（与 nb_link_gate 一致），不硬写 1，免得掩盖 flap 失败 */
+        g_link_up = ((g_last_bmsr & 0x0004u) != 0) ? 1 : 0;
+        if (g_link_up)
+            break;
+        DelayThread(100 * 1000); /* 链路没回来，喘口气再 flap 一次 */
+    }
+}
+
+/* [v30] 惰性接盒子用的「一轮」：发一次握手 + 等 100ms + 取一次 IDENTIFY。
+ * 成功返回真实扇区数，失败返回 0。 */
+static u64 nb_lazy_rounds(int rounds, const char *tag)
+{
+    int k;
+    char msg[96];
+
+    for (k = 0; k < rounds; k++) {
+        u64 s;
+
+        nb_dstmac_idx = k & 3;
+        sprintf(msg, "lazy %s round %d/%d dstmac_xx=%02x (hook=%d box=%d)",
+                tag, k + 1, rounds, nb_dstmac_tab[nb_dstmac_idx][3],
+                g_hook_calls, g_box_frames);
+        nb_diag(msg);
+
+        nb_handshake();
+        DelayThread(100 * 1000); /* 100ms，等盒子应答 */
+        s = nb_identify_sectors();
+        if (s != 0)
+            return s;
+    }
+    return 0;
+}
+
+/* [v30] ★ 惰性接盒子 ★
+ *
+ * 为什么必须挪到这里：netbox.irx 是在 OPL 的 bdmLoadBlockDeviceModules() 里被
+ * SifExecModuleBuffer() 【同步】加载的，那个函数直到 _start() 返回才放掉
+ * bdmLoadModuleLock；而 OPL 主页/菜单在启动阶段要拿这把锁。v29 把「重链 +
+ * 120 轮长监听（≈5 分钟）」塞在 _start() 里，实机结果就是 OPL 主页 10 分钟
+ * 都进不去（一直停在启动画面）。
+ *
+ * v30 的分工：
+ *   _start()  —— 只做秒级启动尝试；拿不到盒子就注册设备 + 置 g_lazy_pending，
+ *                立刻 return MODULE_RESIDENT_END（模块驻留，主页照进）。
+ *   本函数    —— OPL 第一次读这块盘时被 netbox_read() 调起。这时 OPL 正在挂载
+ *                mass0:，等一下不会卡主页，而且恰好对应原厂「打开浏览器才去连
+ *                盒子」的时序。
+ *
+ * 两个阶段，每阶段前先制造一次真实 link flap（nb_box_trigger）：盒子只在自身
+ * 链路 flap 之后才开门，服务窗约 26.5 秒 —— 必须「flap 一次，然后马上在这个
+ * 窗口里发请求」。两阶段 = 两次窗口机会。
+ * 拿到 IDENTIFY 就把真实容量写回 g_netbox_bd.sectorCount，后续读盘就正常了。 */
+static void nb_lazy_connect(void)
+{
+    u64 sectors;
+    char msg[160];
+
+    nb_diag("lazy: first read -> flap then listen (phase1)");
+
+    nb_box_trigger();
+    sectors = nb_lazy_rounds(NB_V30_LAZY_PHASE1, "p1");
+    if (sectors == 0) {
+        nb_diag("lazy: phase1 no reply -> re-flap (phase2)");
+        nb_box_trigger();
+        sectors = nb_lazy_rounds(NB_V30_LAZY_PHASE2, "p2");
+    }
+
+    if (sectors != 0) {
+        g_netbox_bd.sectorCount = sectors;
+        sprintf(msg, "lazy: BOX ANSWERED! %u sectors (%u GB) box=%d -> device ready",
+                (unsigned int)(sectors & 0xFFFFFFFF),
+                (unsigned int)(sectors >> 21), g_box_frames);
+        nb_diag(msg);
+        printf("netbox: lazy connect OK, %u sectors\n",
+               (unsigned int)(sectors & 0xFFFFFFFF));
+    } else {
+        sprintf(msg, "lazy: box still silent after 2 flaps + %d rounds "
+                     "(hook=%d box=%d) -> reads will fail",
+                NB_V30_LAZY_PHASE1 + NB_V30_LAZY_PHASE2, g_hook_calls, g_box_frames);
+        nb_diag(msg);
+        printf("netbox: lazy connect FAILED (box never answered)\n");
+    }
+}
+
+int _start(int argc, char *argv[])
+{
+    iop_sema_t sema;
+    static u8 sec0[NB_DATA_SIZE]; /* LBA0 自检缓冲；static 免得吃 IOP 线程栈 */
+    u64 sectors = 0; /* 必须初始化：下面的重试循环拿它当条件 */
+    int mac_ok, try, r;
+    (void)argc; (void)argv;
+
+    printf("netbox_bd: PS2 NetBox (NBD/ATA-over-UDP) BDM driver v1.20 (raw SMAP + dst-MAC ladder + PHY loopback + A/B listen + linkchk + unified screen tag + factory-aligned tx frame + factory tx frame length + vendor-first dst MAC + headed probe frame + self-frame filter + fast-boot + lazy-connect)\n");
+
+    sema.initial = 1;
+    sema.max     = 1;
+    sema.option  = 0;
+    sema.attr    = 0;
+    io_sema      = CreateSema(&sema);
+
+    /*
+     * 1) 注册原始帧钩子 + 【自检】。
+     *
+     * 钩子必须在任何读操作之前装上：握手和 IDENTIFY 的应答全靠它进来，
+     * 它在 ps2ip_input() 之前被调用，拿到的是刚 DMA 出来的完整帧。
+     *
+     * 为什么要回读自检（v14 新增）：IOP 装载器在找不到某个导入的库时，
+     * 会把那个导入桩改写成空桩（ps2sdk loadcore.c 的 cleanStub，改成
+     * "jr $ra"）。空桩【不报错、不影响模块装载】，只是静默什么都不做。
+     * 如果 netboxh 库在运行时不存在，smap_set_rx_hook() 就是这样——
+     * 钩子根本没装上，hook 计数永远是 0，和"盒子没回包"完全无法区分。
+     * 回读一次并和刚传进去的地址比对，就能把这两种情况彻底分开。
+     */
+    smap_set_rx_hook((void *)netbox_raw_hook);
+    if (smap_get_rx_hook() != (void *)netbox_raw_hook) {
+        printf("netbox: rx hook self-check FAILED -> netboxh import is a no-op stub\n");
+        return nb_fail(NB_STAGE_HOOK);
+    }
+
+    /*
+     * 2) 链路自检（v14 新增，★这一关是 v13 缺的关键判据★）。
+     *
+     * 实机上报回 "stage=3 hook=0"（发送自检通过、但一个回包都没收到）之后
+     * 去读 smap-ingame 的 SMAPStart()，发现 v13 的发送判据是假阳性：
+     *
+     *     result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+     *     if (result == 0 && !NetDevStopFlag) { ...; SmapIsInitialized = 1; }
+     *
+     * 而 InitPHY() 的每一条出口都是【无条件 return 0】（smap.c 末尾），
+     * 内部所有"等链路"的循环超时后也只是把 LinkStatus 置 0 继续往下。
+     * ⇒ 链路从来没起来时，SmapIsInitialized 也是 1、SMAPSendPacket() 也
+     *   返回 1 —— "发得出去"根本不能证明链路上有线。
+     *
+     * PHY 的 BMSR bit2 是唯一可信的判据，所以这一关单独判、单独报。
+     * 链路不通时静默发帧 = 盒子永远收不到请求 = 硬盘一动不动 + 菜单空白，
+     * 而驱动照样一路跑到 resident（v12 的整个玄学都在这里）。
+     */
+    /*
+     * 2a) 【v16 新增，v17 改成只诊断、不再拦】PHY 身份。
+     *
+     * v16 这一关是"ID 不是 DP83846 就立刻失败"。v16 实机结果证明那是我
+     * 自己判据太严：本机这颗 PHY 的 ID 读回来是 0x0143BCxx —— 合法 OUI，
+     * 既不是 0xFFFF 也不是 0，只是不是 National DP83846。
+     * 而 OPL 上游对非 DP83846 的 PHY 本来就是容忍的：InitPHY() 里那几段
+     * DP83846 专有 workaround 被跳过，函数照样算完 LinkMode 并 return 0。
+     *
+     * 所以现在只把身份"记下来"（进 g_phy / g_phy_code，失败时走诊断通道），
+     * 不再因为身份而终止 —— 真正该判的是下面那条链路。
+     */
+    nb_phy_identify();
+    {
+        char msg[128];
+        sprintf(msg, "phy identify code=%d idr1=%04x idr2=%04x bmsr=%04x sts=%04x",
+                g_phy_code, g_phy[2] & 0xFFFFu, g_phy[3] & 0xFFFFu,
+                g_phy[1] & 0xFFFFu, g_phy[7] & 0xFFFFu);
+        nb_diag(msg);
+    }
+
+    /*
+     * 2b) 【v17 新增，★这一版的核心★】把 PHY 初始化补跑一遍，再判链路。
+     *
+     * SMAPStart() 里决定"要不要初始化 PHY"的只有一行：
+     *     result = (!(BMSR & LINK)) ? InitPHY(&SmapDriverData) : 0;
+     * 也就是 —— BMSR 报"有链路"时 InitPHY() 根本不会被调用。
+     * 而 InitPHY() 里除了一段 DP83846 专有 workaround 之外，还有两件
+     * 【任何 PHY 都必须做】的事：「算 LinkMode」与「把 FDX/流控写进
+     * EMAC3 MODE1」。这两件正好在 DP83846 那段 if 之外，本该人人执行，
+     * 却跟着一起被跳过了。
+     *
+     * 而 BMSR 的 link 位有两个假阳性来源：
+     *   - PHY 不响应时 MDIO 数据线悬空、读回 0xFFFF，bit2 恰好是 1；
+     *   - 链路刚插上、自协商还没跑完的那一瞬间，bit2 也会是 1。
+     * 于是 MAC 停在 smap_init() 硬编码的 100M 全双工，而 PHY 实际可能是
+     * 10M 半双工 / 100M 半双工 => 双工不匹配 => 本侧发出去的帧对端收得到，
+     * 对端回过来的帧本侧 MAC 全部采样错 => "发得出去、一个回包都收不到"。
+     * 这正是 xfer.c 里那条"收帧带错误标志 -> 空 if 静默丢弃"的另一半。
+     *
+     * smap_phy_reinit() 把这一刀补回来：链路已 up 就只做 MAC 侧对齐
+     * （不打断链路），没 up 就老老实实跑完整 InitPHY()（软复位 /
+     * 自协商 / 手动 100M/10M fallback）。成败由它交出的 BMSR 判定。
+     */
+    if (!nb_link_gate()) {
+        char msg[128];
+        sprintf(msg, "link gate FAILED code=%d rc=%d idr1=%04x idr2=%04x",
+                g_phy_code, g_link_rc,
+                g_link2[2] & 0xFFFFu, g_link2[3] & 0xFFFFu);
+        nb_diag(msg);
+        printf("netbox: link gate FAILED code=%d rc=%d (not resident)\n",
+               g_phy_code, g_link_rc);
+        return nb_fail(NB_STAGE_LINK);
+    }
+
+    /* 链路已确认。把现场灌进 g_last_bmsr / g_link_mode ——
+     * 后面几关的提示串与最后的容量上报都要用（v17 之前这一步是
+     * nb_wait_link() 做的，现在由 nb_link_gate() 的完整快照取代）。 */
+    g_link_up   = 1;
+    g_last_bmsr = g_link2[1] & 0xFFFFu;
+    g_link_mode = g_link2[8] & 0xFFu;
+    {
+        char msg[128];
+        sprintf(msg, "link ok: code=%d rc=%d bmsr=%04x sts=%04x lm=%02x emac3fdx=%u",
+                g_phy_code, g_link_rc, g_last_bmsr, g_link2[6] & 0xFFFFu,
+                g_link_mode, g_link2[7] & 1u);
+        nb_diag(msg);
+    }
+
+    /*
+     * 3) 取本机 SMAP MAC（用来填自发帧的源 MAC，盒子并不看）。
+     *    判据是"值"不是"返回值"：SMAPGetMACAddress() 自己恒返回 0。
+     *    这三对寄存器由 smap_init() 从 DEV9 EEPROM 读出后写进 EMAC3，
+     *    全零就说明 smap_init() 没跑完 —— 那后面所有寄存器操作都没意义。
+     */
+    memset(nb_mac, 0, sizeof(nb_mac));
+    mac_ok = (SMAPGetMACAddress(nb_mac) == 0);
+    if (!mac_ok || (nb_mac[0] | nb_mac[1] | nb_mac[2] | nb_mac[3] | nb_mac[4] | nb_mac[5]) == 0) {
+        printf("netbox: MAC unusable -> smap_init() did not complete\n");
+        return nb_fail(NB_STAGE_MAC);
+    }
+
+    {
+        char msg[128];
+        sprintf(msg, "hooked ok, link up (bmsr=0x%04x mode=0x%02x), mac=%02x:%02x:%02x:%02x:%02x:%02x",
+                (unsigned int)g_last_bmsr & 0xFFFF, (unsigned int)g_link_mode & 0xFF,
+                nb_mac[0], nb_mac[1], nb_mac[2], nb_mac[3], nb_mac[4], nb_mac[5]);
+        nb_diag(msg);
+    }
+
+    /* 4) 确认真的发得出去。SMAPSendPacket() 在 SmapIsInitialized==0 时
+     *    【静默】返回 -1 且一个字节都不发。走到这里链路已经确认是通的，
+     *    所以这一关失败就只剩"smap-ingame 没真正初始化"一种解释。 */
+    if (!nb_probe_tx()) {
+        printf("netbox: SMAPSendPacket() always -1 -> SmapIsInitialized==0\n");
+        return nb_fail(NB_STAGE_TX);
+    }
+    nb_diag("SMAP tx ready");
+
+    /*
+     * [v25] 构建标记 —— 诊断通道上的【第一条】。
+     *
+     * v24 加的这条在实机上没能验证（那一轮 PS2 跑的是 v23 的构建），
+     * 所以 v26 连"构建标记"一起重打：抓包里看到 build-tag v26 就说明
+     * 跑的是本轮的二进制。
+     *
+     * 为什么必须有它：屏幕上的版本后缀曾经是逐条硬编码的（v23 的构建在
+     * stage 6 显示 "(v18)"、v22 的构建在 stage 11 显示 "(v22)"），于是
+     * "屏幕上写的是哪一版"完全不能用来确认【刷进去的是哪一版】。
+     * 从这一版起：屏幕侧统一走 gui.c 的 NB_UITAG，抓包侧由这一行负责 ——
+     * 只要 pcap 里看到这一行，后面所有行的语义就确定属于哪一版构建。
+     *
+     * 位置选在这里（而不是 _start 一进来）是有意的：这一行要用 UDP 发出去，
+     * 前面三关（钩子 / 链路 / 发送）只要有一关不过，帧本来就出不了网卡，
+     * 早放也没有意义 —— 这里是"确定发得出去"之后的第一行。
+     */
+    nb_diag("netbox_bd v1.20 build-tag v30 (factory tx frame len + vendor-first dst MAC + unified screen tag + headed probe frame + self-frame filter + fast-boot + lazy-connect)");
+
+    /*
+     * 5) 开机握手（激活盒子）+ 探容量。
+     *    盒子可能刚上电还没就绪，或者内置盘在休眠（IDENTIFY 会顺带唤醒它，
+     *    机械盘转起来要好几秒），所以重试窗口比 v12 放宽：6 轮 x 100ms，
+     *    每轮里 IDENTIFY 自己还有 3 次 x 500ms。
+     *
+     *    [v19] 每轮换一个【目的 MAC 候选】（见 nb_dstmac_tab 的说明）：
+     *      第 0 轮 = 标准广播，也就是 v1~v18 一直用的那个；
+     *      第 1~3 轮 = 厂商可用版本实测在用的 ff:34:43:{00,30,52}:ff:ff。
+     *    这是驱动器与"厂商能用版本"之间唯一未验证过的差别 —— 我们从来没试过
+     *    盒子认不认标准广播。若盒子本来就接受广播，第 0 轮就成功，行为与之前
+     *    【完全一致】；所以这个改动没有回退风险，最坏情况只是多等 3 轮。
+     */
+    /* [v30] ★ 启动只做「秒级」尝试，绝不再长等 ★
+     *
+     * v29 在这里做「启动 1 次 + 每 12 轮 1 次」共最多 10 次 PHY flap
+     * （每次最坏 ≈10.8 秒：loopback 一开链路就掉，smap_phy_reinit 走完自协商
+     * 超时 6 秒 + 手动 100M/10M 回退 4.4 秒）再加 120 轮 IDENTIFY（每轮 ≈1.6 秒），
+     * 合计 5 分钟以上 —— 而本函数是在 OPL 的 bdmLoadBlockDeviceModules() 里
+     * 【同步】调用的，那个函数在返回前一直持着 bdmLoadModuleLock，OPL 主页要等它。
+     * 实机结果：开机 10 分钟还停在启动画面。
+     *
+     * v30：这里只跑 NB_V30_BOOT_ROUNDS 轮（≈10 秒上限），且【不做任何 flap】。
+     * 拿不到盒子就把设备先注册出去、走「惰性模式」立刻返回（见下面 sectors==0），
+     * 重链 + 长监听全部挪到第一次读盘时的 nb_lazy_connect()。 */
+    for (try = 0; try < NB_V30_BOOT_ROUNDS && sectors == 0; try++) {
+        char msg[80];
+
+        nb_dstmac_idx = try & 3;
+        sprintf(msg, "boot round %d/%d dstmac_xx=%02x (hook=%d box=%d)",
+                try + 1, NB_V30_BOOT_ROUNDS, nb_dstmac_tab[nb_dstmac_idx][3],
+                g_hook_calls, g_box_frames);
+        nb_diag(msg);
+
+        nb_handshake();
+        DelayThread(100 * 1000); /* 100ms，等盒子应答 */
+        sectors = nb_identify_sectors();
+    }
+
+    /* [v30] ★ 启动时拿不到盒子 -> 惰性模式（不再 nb_fail 卡屏/不驻留）★
+     *
+     * v12~v29 走到这里就 return nb_fail(...)：模块不驻留、不注册设备，
+     * OPL 主页没有 netbox、游戏列表也是空的。可盒子本来就只在自身链路 flap
+     * 之后才开门（capG/capH 实测），开机那十几秒常常根本不在服务窗里 ——
+     * 于是这个失败几乎必然发生，用户看到的就是「永远没有游戏目录」。
+     *
+     * v30 换一种做法：把设备【先注册出去】（容量用 NB_V30_LAZY_SECTORS 占位），
+     * 模块正常驻留、_start() 立刻返回 —— OPL 该进主页进主页，设置页能看到
+     * netbox 设备。真正「flap 逼开门 + 长监听」推迟到 OPL 第一次读这块盘的时刻，
+     * 见 nb_lazy_connect()。要抓盒子开门，就在 OPL 打开游戏列表之后的前
+     * 约 20 秒内拔插一次盒子电源（盒子侧 link flap = 盒子开门）。
+     *
+     * 注意：这里【不跑】v19~v23 那套自环/监听/linkchk 四格阶梯 —— 那套读数是
+     * 给 nb_fail() 上屏用的，v30 不再让 _start 失败，跑了也没地方上屏。
+     * 需要那组读数时走「转发桥 + UDP 40001 诊断通道」。 */
+    if (sectors == 0) {
+        char msg[176];
+
+        sprintf(msg, "boot: box silent after %d rounds (hook=%d box=%d) -> LAZY mode "
+                     "(device registered now, flap+listen on first read)",
+                NB_V30_BOOT_ROUNDS, g_hook_calls, g_box_frames);
+        nb_diag(msg);
+        printf("netbox: LAZY mode, box not up yet (retry on first read)\n");
+
+        g_netbox_bd.sectorCount = NB_V30_LAZY_SECTORS;
+        g_lazy_pending = 1;
+        bdm_connect_bd(&g_netbox_bd);
+        nb_diag("bdm_connect_bd() done -> resident (LAZY, box not connected yet)");
+
+        return MODULE_RESIDENT_END;
+    }
+
+    {
+        /* 成功 —— 把"哪一轮 / 哪个目的 MAC 换来了回包"记到诊断通道上。
+         * 如果 xx 不是 ff，就说明盒子确实不认标准广播，这个值以后要固定下来。 */
+        char msg[96];
+
+        sprintf(msg, "reply ok at round %d dstmac_xx=%02x (hook=%d)",
+                try, nb_dstmac_tab[nb_dstmac_idx][3], g_hook_calls);
+        nb_diag(msg);
+    }
+
+    {
+        char msg[80];
+        /* 1 GB = 2097152 个 512 字节扇区，所以 GB 就是 sectors >> 21。
+         * （v11 写的是 (sectors>>11)/1024，数值对但单位标成 MB 了。）
+         * 容量只影响上报大小、不影响读盘正确性，所以不合理也不再兜底，
+         * 只如实打到诊断通道上。 */
+        sprintf(msg, "IDENTIFY ok: %u sectors (%u GB)",
+                (unsigned int)(sectors & 0xFFFFFFFF),
+                (unsigned int)(sectors >> 21));
+        nb_diag(msg);
+    }
+
+    /*
+     * 6) 自检：真读一次 LBA0。
+     *    这一步和 fatfs 挂载时做的第一件事【完全一样】（先读引导扇区），
+     *    所以它过了，就说明 mass0: 基本一定能挂上、设备图标一定会出现。
+     *    它不过，就没必要注册 BD 设备 —— 反正 OPL 那边的
+     *    fileXioDopen("mass0:/") 也会失败、图标也不会出现。宁可让设置页
+     *    明确报出死在哪一段，也不要再出现"resident 但什么都没有"。
+     */
+    r = -1;
+    for (try = 0; try < 3; try++) {
+        r = nb_transaction(0, 1, sec0, NB_ATA_READ_EXT);
+        if (r == 1)
+            break;
+        nb_diag("read LBA0 failed, retrying");
+        DelayThread(300 * 1000); /* 300ms：给休眠中的盘一点时间 */
+    }
+    if (r != 1) {
+        printf("netbox: selftest read LBA0 failed (ret=%d)\n", r);
+        return nb_fail(NB_STAGE_READ0);
+    }
+
+    /* 引导扇区的最后两个字节必须是 55 AA（MBR / exFAT / FAT 都遵守）。
+     * 读得到但这两个字节不对 => 数据错位。这比"读不到"更需要单独报出来，
+     * 因为它意味着协议通了、但偏移或扇区对齐算错了。 */
+    if (sec0[510] != 0x55 || sec0[511] != 0xAA) {
+        char msg[96];
+        sprintf(msg, "LBA0 read ok but no 55AA signature (tail=%02x %02x)",
+                sec0[510], sec0[511]);
+        nb_diag(msg);
+        return nb_fail(NB_STAGE_BOOTSIG);
+    }
+
+    /* 7) 全通了才注册 BD 设备 */
+    g_netbox_bd.sectorCount = sectors;
+
+    {
+        char msg[144];
+        sprintf(msg, "selftest passed (%u sectors) link up (bmsr=0x%04x) hook=%d self=%d box=%d rx=%d drop=%d -> resident",
+                (unsigned int)(sectors & 0xFFFFFFFF), (unsigned int)g_last_bmsr & 0xFFFF,
+                g_hook_calls, g_self_calls, g_box_frames, g_rx_frames, g_rx_drop);
+        nb_diag(msg);
+    }
+
+    printf("netbox: selftest ok, %u sectors (%u GB), link up, hook=%d\n",
+           (unsigned int)(sectors & 0xFFFFFFFF),
+           (unsigned int)(sectors >> 21), g_hook_calls);
+
+    bdm_connect_bd(&g_netbox_bd);
+    nb_diag("bdm_connect_bd() done -> resident");
+
+    return MODULE_RESIDENT_END;
+}
diff --git a/modules/netbox/netbox_imports.h b/modules/netbox/netbox_imports.h
new file mode 100644
index 0000000..1c20a46
--- /dev/null
+++ b/modules/netbox/netbox_imports.h
@@ -0,0 +1,172 @@
+/*
+ * netbox_imports.h - PS2 NetBox 驱动对外的全部导入声明
+ *
+ * ★ v12（2026-09-24）重大改动：netbox.irx 不再导入 ps2ip ★
+ *
+ * 之前（v11 及更早）netbox.irx 用 lwIP 的 UDP socket 收发。这条路在实机上
+ * 永远读不出扇区，原因有两条，且两条都是硬的：
+ *
+ *   1) 盒子把应答【广播】到 255.255.255.255（2026-09-23 原厂 loader 抓包：
+ *      dst MAC = ff:ff:ff:ff:ff:ff、IP dst = 255.255.255.255），
+ *      发给特定 IP 的 socket 在 lwIP 里不一定收得到；
+ *   2) 更致命：盒子的 IP 头 total_length 恒为 124、UDP length 恒为 104，
+ *      而以太网帧实际 640 字节。lwIP 的 ip_input() 里
+ *      pbuf_realloc(p, ntohs(IPH_TOTLEN)) 把 pbuf 裁到 124 字节，
+ *      socket 只能拿到 96 字节载荷，而一帧读扇区应答是 536 字节
+ *      （18 前导 + 512 扇区 + 6 收尾）=> 扇区数据在进 UDP 层之前就没了。
+ *
+ * v12 改成直接用 SMAP 的原始帧收发，于是：
+ *   - 不导入 ps2ip => 版本号（ps2ip 1.3 还是 2.6）、ABI、广播语义全部无关；
+ *   - 不再有 ip_input() 裁包 => 帧就是 640 字节，一个字节不少。
+ * 这条路径与原厂 loader 的做法一致（原厂请求帧就是从 0.0.0.0 发往
+ * 255.255.255.255 的裸帧，源 MAC 全零、目的 MAC 是垃圾 —— 说明盒子只看
+ * UDP 端口和 55 AA 记录流，完全不看 MAC/IP）。
+ *
+ * 导入的库是 netboxh —— OPL 自带的 smap-ingame 模块新加的导出表
+ * （modules/network/smap-ingame/exports.tab），编号必须与那张表严格一致。
+ */
+
+#ifndef __NETBOX_IMPORTS_H__
+#define __NETBOX_IMPORTS_H__
+
+#include <irx.h>
+
+/* netboxh 1.0 —— SMAP 原始帧收发（实现在 modules/network/smap-ingame） */
+#ifndef netboxh_IMPORTS_start
+#define netboxh_IMPORTS_start DECLARE_IMPORT_TABLE(netboxh, 1, 0)
+#define netboxh_IMPORTS_end   END_IMPORT_TABLE
+#endif
+
+/* 1: 注册原始帧钩子。fn = void (*)(const unsigned char *frame, int len)
+ *    钩子被 SMAP 的收包中断线程直接调用，frame 是刚 DMA 出来的整帧，
+ *    调用点在 ps2ip_input() 之前 —— 这是整条网络栈上唯一能拿到完整帧的地方。
+ *    传 NULL 可注销。 */
+#define I_smap_set_rx_hook DECLARE_IMPORT(1, smap_set_rx_hook)
+
+/* 2: 直接发送一个以太网帧（含 14 字节以太头），length 是整帧长度。
+ *    返回 1 成功、-1 表示 SMAP 还没初始化。 */
+#define I_SMAPSendPacket DECLARE_IMPORT(2, SMAPSendPacket)
+
+/* 3: 取本机 SMAP MAC（6 字节），用来填自发帧的源 MAC。 */
+#define I_SMAPGetMACAddress DECLARE_IMPORT(3, SMAPGetMACAddress)
+
+/* 4: 读 PHY 的真实链路状态（v14 新增）。
+ *    int smap_get_link_status(unsigned int *pBMSR, unsigned int *pANLPAR, unsigned int *pLinkMode)
+ *    返回 1 = 链路已建立，0 = 没链路；三个指针可为 NULL。
+ *
+ *    为什么必须有它：SmapIsInitialized（决定 SMAPSendPacket 能否发帧）是在
+ *    InitPHY() "成功" 之后被置 1 的，而 InitPHY() 的每一条出口都是
+ *    【无条件 return 0】—— 链路从来没起来时它也报成功。于是
+ *    "SMAPSendPacket() 返回 1" 完全不能证明链路上有线，
+ *    "hook=0（一个回包都没有）" 也就无法区分「没链路」和「盒子不回话」。
+ *    这一位（BMSR bit2）是唯一可信的判据。 */
+#define I_smap_get_link_status DECLARE_IMPORT(4, smap_get_link_status)
+
+/* 5: 回读已注册的原始帧钩子指针（v14 新增）。
+ *    void *smap_get_rx_hook(void)
+ *    只有自检用：netboxh 库若在运行时不存在，IOP 装载器会把导入桩改写成
+ *    空桩，smap_set_rx_hook() 静默无效、钩子计数永远是 0。回读比对即可分开。 */
+#define I_smap_get_rx_hook DECLARE_IMPORT(5, smap_get_rx_hook)
+
+/* 6: 收发路径的现场计数（v15 新增）。
+ *    int smap_get_rx_diag(unsigned int *out, int n)     —— out 至少 18 个 u32
+ *    out[0]=MAL 收帧计数（硬件计数，不依赖中断）、out[1]=MAL 发帧计数、
+ *    out[2]=EMAC3 中断/错误标志、out[3]=累计 OR 到的 EMAC3 标志、
+ *    out[4..6]=DEV9 中断回调 / RXEND / EMAC3 事件次数、
+ *    out[7..11]=HandleRxIntr 调用 / 看到有帧 / 交上层 / 因错误标志丢弃 / 首个坏 ctrl_stat、
+ *    out[12]=EMAC3 MODE1（实际编程的速度双工）、out[13]=EMAC3 TxMODE0（bit31=发不出去）、
+ *    out[14..15]=RX/TX FIFO 控制、out[16..17]=MAC 地址寄存器。
+ *
+ *    为什么必须有它：v14 实机只报出 "hook=0"，而"帧没到 MAC"、"帧到了但带
+ *    以太网收帧错误标志被静默丢掉"、"帧到了也交上去了但钩子没被调" 这三种
+ *    情况在屏幕上完全一样，修的方向却完全不同（线/盒子 vs 双工速率 vs 库）。
+ *    out[0] 是硬件计数，不依赖中断是否工作，所以它一定是可信的参照。 */
+#define I_smap_get_rx_diag DECLARE_IMPORT(6, smap_get_rx_diag)
+
+/* 7: PHY 现场快照 + 链路模式码（v15 新增）。
+ *    int smap_get_phy_dump(unsigned int *out, int n)    —— out 至少 10 个 u16
+ *    out[0..8]=BMCR/BMSR/PHYIDR1/PHYIDR2/ANAR/ANLPAR/ANER/PHYSTS/10BTSCR
+ *    out[9]=模式码 0 none / 1 10M半 / 2 10M全 / 3 100M半 / 4 100M全 / 5 PHY 不响应
+ *
+ *    为什么要它：smap_init() 写进 MAC 的是【硬编码 100M 全双工】，而 InitPHY()
+ *    只在"BMSR 说没有链路"时才会被调用 —— 链路一开始就 up 的话，速度和双工
+ *    从来没被协商过。PHYSTS(0x10) 的 bit0/1/2 直接给出"link / 10M还是100M /
+ *    半还是全双工"，PHY ID 还能判断 PHY 到底有没有在应答（不响应时 MDIO 常读回
+ *    0xFFFF，BMSR 的 link 位就是 1，正是"链路 OK"假阳性的来源）。 */
+#define I_smap_get_phy_dump DECLARE_IMPORT(7, smap_get_phy_dump)
+
+/* 8: 把 PHY 初始化补跑一遍 + 拿回现场（v17 新增，这一版的核心）。
+ *    int smap_phy_reinit(unsigned int *out, int n)      —— out 至少 12 个 u32
+ *    out[0]=BMCR out[1]=BMSR out[2]=PHYIDR1 out[3]=PHYIDR2
+ *    out[4]=ANAR out[5]=ANLPAR out[6]=PHYSTS
+ *    out[7]=EMAC3 MODE1 的 FDX 位（0/1）  out[8]=LinkMode  out[9]=LinkStatus
+ *    out[10]=ANER  out[11] 低 4 位 = 结果码：0 链路已就绪 / 1 PHY 复位没完成
+ *                                  / 2 自协商与手动 100M/10M 都试过仍不 up
+ *    返回 0 = 链路就绪 / 1 = 没就绪（细节看 out[11]）/ 2 = 参数错
+ *
+ *    ★ 它是【有界】的：总耗时上限约 10.6 秒（复位 0.2s + 自协商 2x3s +
+ *      手动 2x2.2s）。上游的 InitPHY() 不能直接用 —— 它第 257 行的
+ *      `goto RepeatAutoNegoProcess` 会清零重试计数，网线没插时【永不返回】，
+ *      而这里的调用点在 IOP 的 _start() 里、被 EE 同步等待，直接就是启动卡死。
+ *
+ *    为什么必须有它 —— SMAPStart() 里那一行是
+ *        result = (!(BMSR & LINK)) ? InitPHY(...) : 0;
+ *    也就是「BMSR 报有链路就不初始化 PHY」。可 InitPHY() 里除了 DP83846
+ *    专有 workaround（ID 不匹配时跳过是对的）之外，还有两件任何 PHY 都必须
+ *    做的事：算出 LinkMode、**把 FDX/流控写进 EMAC3 MODE1**。
+ *    这一段在那段 if 之外，本该人人执行 —— 却会因为 BMSR 的 link 位读成 1
+ *    而整段被跳过（PHY 不响应时 MDIO 悬空=0xFFFF，bit2 恰好是 1）。
+ *    结果 MAC 停在 smap_init() 硬编码的 100M 全双工，与 PHY 实际模式可能
+ *    不符 => 收帧全错 => "发得出去、一个回包都收不到"。
+ *    v16 实机报回 "PHY not DP83846 id1=0143 id2=BC" 说明 PHY 是应答的、
+ *    MDIO 是通的，所以第一件该做的事就是把这一刀补回来并看现场。 */
+#define I_smap_phy_reinit DECLARE_IMPORT(8, smap_phy_reinit)
+
+/* 9: EMAC3 内部自环开关（v19 新增）。
+ *    int smap_loopback_set(int on)
+ *    on != 0 打开自环（顺带把 MODE0 的收发使能与 RxMODE 的地址过滤再落一遍）；
+ *    on == 0 关闭自环（按位清 MODE1 的 bit30，不动 FDX/流控/速率/FIFO 那些位）。
+ *    返回 0 = 成功，-1 = SMAP 从未初始化过。
+ *
+ *    为什么要有它 —— v18 实机报回
+ *        "FAIL noreply NO RX IRQ at all fl=0 n=0 k=0 (v18)"
+ *    也就是收侧任何一项都是 0：MAL 的硬件收帧计数（不依赖中断）是 0、
+ *    DEV9 中断回调一次没跑过。而发送侧是干净的。于是只剩两种可能，
+ *    修法完全相反、屏幕上却同形：
+ *      (A) PS2 自己收不了（MAC 收方向 / 地址过滤 / MAL / BD / 中断）
+ *      (B) 帧压根没到 PS2（盒子没发 / 线或 PHY 收方向坏 / 对端不认我们的帧）
+ *    内自环把 MAC 的发送路径在芯片内部接回接收路径，不经 PHY/网线/盒子，
+ *    于是 ps2 侧通不通就变成一个二元答案 —— 这是唯一不依赖外部设备的判据。
+ *    不用 PHY 自环的原因：PHY 早被证明是活的（BMSR=0x2D 是真值），
+ *    把 PHY 包进来只会让失败原因变模糊。 */
+#define I_smap_loopback_set DECLARE_IMPORT(9, smap_loopback_set)
+
+/*
+ * [v21] 编号 10 / 11 —— PS2 侧最后一块没验证过的数据通路：PHY 的 MII 段。
+ *
+ *    为什么要有它们 —— v20 实机报回
+ *        "FAIL noreply LOOPBACK OK: PS2 rx path fine (v20)"
+ *    EMAC3 的【内部】自环通了：中断跑了、帧也交到收帧钩子了。也就是说
+ *    MAC 数字部分 + 地址过滤 + MAL RX FIFO + RXEND 中断 + HandleRxIntr
+ *    + 钩子这一整串全部完好，「PS2 自己收不了」这个方向已经被排除（v19
+ *    的内自环是故意把 PHY 排除在外的）。
+ *
+ *    那么 PS2 侧还剩什么没被验证过？只剩 PHY 的 MII【数据】通道 ——
+ *    v17 读回 BMSR=0x2D 只证明 PHY 的 MDIO【管理】通道可用，跟数据能不能
+ *    过去是两件事。
+ *
+ *    I_smap_phy_loopback_set(10)：把 PHY 的 BMCR bit14 置起来（802.3 的
+ *      Loopback），让 PHY 在 MII 接口处把发送数据回环到接收侧。
+ *        内自环 OK + PHY 自环 OK   => MAC..MII..PHY(数字) 全好
+ *                                     => 只剩 PHY 模拟前端 / 网线 / 盒子
+ *        内自环 OK + PHY 自环 失败 => MII 接口或 PHY 数字部分坏了（可修）
+ *
+ *    I_smap_phy_counters(11)：读 PHYSTS + FCSCR/RECR/PCSR。FCSCR/RECR 不
+ *      是 0 就说明线上真有信号进来并被 PHY 接收侧处理过 —— 这是「对端在发、
+ *      线是活的」的直接旁证，比自环更硬，因为自环完全不碰网线。
+ *      ⚠ 偏移依赖 PHY 型号，判读时把全 0 / 全 FFFF 都当「无信息」。
+ */
+#define I_smap_phy_loopback_set DECLARE_IMPORT(10, smap_phy_loopback_set)
+#define I_smap_phy_counters DECLARE_IMPORT(11, smap_phy_counters)
+
+#endif /* __NETBOX_IMPORTS_H__ */
diff --git a/modules/network/smap-ingame/Makefile b/modules/network/smap-ingame/Makefile
